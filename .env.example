PORT=6200
DB_CONNECT=mongodb://localhost:27017
STORE_NAME=StarTalk
STORE_TAGLINE=Conversations worth staying for.
ADMIN_EMAIL=info@startalksessions.org
ADMIN_PASSWORD=StarTalk@123456
ADMIN_NAME=StarTalk

# --- Email (Resend) ---
# Optional. When RESEND_API_KEY is empty the app silently skips sending email.
RESEND_API_KEY=
# Legacy alias, read as a fallback for RESEND_API_KEY.
RESEND_APITOKEN=
RESEND_FROM_EMAIL=noreply@startalksessions.org
RESEND_FROM_NAME=StarTalk

# --- WhatsApp ---
# Visible wa.me chat links only need WHATSAPP_NUMBER.
# Local format is fine; links are normalised to international automatically.
WHATSAPP_NUMBER=08066286771
# Dialling code prefixed when the number above is in local format.
WHATSAPP_COUNTRY_CODE=234
# Optional server-side WhatsApp notifications (Meta Cloud API).
# When these are empty the app silently skips WhatsApp messaging.
WHATSAPP_API_TOKEN=
WHATSAPP_NUMBER_ID=

# --- Google AdSense ---
# Optional. When empty, AdSense script and ad slots are not rendered.
ADSENSE_CLIENT_ID=ca-pub-2447961066740044
# Framework-compatible alias.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-2447961066740044
# Responsive AdSense slot ids rendered per placement. Optional.
ADSENSE_SLOT_HEADER=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_INLINE=
ADSENSE_SLOT_FOOTER=
ADSENSE_SLOT_DETAIL=

# --- AI Support Assistant (free tiers, all optional) ---
# Priority: Groq -> OpenRouter -> Gemini. None set = built-in offline replies.
# Get Groq:      https://console.groq.com/keys
# Get OpenRouter: https://openrouter.ai/keys
# Get Gemini:    https://aistudio.google.com/apikey
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

SUPPORT_EMAIL=info@startalksessions.org
SUPPORT_PHONE=+234 800 000 0000
# Support / donation account shown on the support page and across the site.
SUPPORT_ACCOUNT_NUMBER=1311403887
SUPPORT_ACCOUNT_NAME=STAR TALK SESSIONS LTD
SUPPORT_BANK_NAME=PROVIDUSUNITYBANK

# --- Public site ---
SITE_URL=https://startalksessions.org
STUDIO_ADDRESS_1=Broadcast Studio, Minna
STUDIO_ADDRESS_2=Federal University of Technology, Minna