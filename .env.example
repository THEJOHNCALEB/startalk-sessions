# Get Groq:      https://console.groq.com/keys
# Get OpenRouter: https://openrouter.ai/keys
# Get Gemini:    https://aistudio.google.com/apikey
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

