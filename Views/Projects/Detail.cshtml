@model StarTalkSessions.Models.Project
@{
    ViewData["Title"] = Model.Title + " — Production";
    var more = (List<StarTalkSessions.Models.Project>)ViewBag.More ?? new();
}

<section class="mx-auto max-w-app px-4 py-10 sm:px-6">
    <nav class="text-xs text-neutral-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-900">Home</a><span class="mx-1">/</span><a href="/projects" class="hover:text-brand-900">Projects</a><span class="mx-1">/</span><span class="text-neutral-600">@Model.Title</span>
    </nav>

    <header class="mt-6 max-w-3xl">
        <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full bg-brand-700 px-3 py-1 text-xs font-semibold text-white">@Model.Segment</span>
            <span class="text-xs text-neutral-400">@Model.Location · @Model.Year · @Model.Client</span>
        </div>
        <h1 class="mt-4 text-3xl font-bold leading-tight tracking-tight text-brand-900 sm:text-4xl">@Model.Title</h1>
        <p class="mt-3 text-lg leading-relaxed text-neutral-500">@Model.Brief</p>
    </header>

    @* ---------- Before / After ---------- *@
    @if (!string.IsNullOrWhiteSpace(Model.BeforeImage) && !string.IsNullOrWhiteSpace(Model.AfterImage))
    {
        <div class="relative mt-10 select-none overflow-hidden rounded-2xl border border-brand-200" data-before-after>
            <div class="pointer-events-none absolute left-3 top-3 z-10 rounded-full bg-brand-700/80 px-3 py-1 text-xs font-semibold text-white">Before</div>
            <div class="pointer-events-none absolute right-3 top-3 z-10 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-brand-900">After</div>
            <div class="relative h-[24rem] w-full">
                <img src="@Model.BeforeImage" alt="Before — @Model.Title" class="absolute inset-0 h-full w-full object-cover" />
                <div class="ba-after absolute inset-0" style="--ba:50%">
                    <img src="@Model.AfterImage" alt="After — @Model.Title" class="h-full w-full object-cover" />
                </div>
                <div class="pointer-events-none absolute inset-y-0 z-10 w-0.5 bg-white" style="left:var(--ba)" data-ba-handle></div>
            </div>
            <input type="range" min="0" max="100" value="50" aria-label="Compare before and after" data-ba-range class="absolute inset-0 z-20 h-full w-full cursor-ew-resize opacity-0" />
        </div>
    }

    <div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-[1fr_18rem]">
        <div class="space-y-10">
            <div>
                <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">The brief</span>
                <h2 class="mt-1 text-xl font-bold tracking-tight text-brand-900">What the client asked for</h2>
                <p class="mt-3 leading-relaxed text-neutral-600">@Model.Brief</p>
            </div>
            <div>
                <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">The challenge</span>
                <h2 class="mt-1 text-xl font-bold tracking-tight text-brand-900">What made it hard</h2>
                <p class="mt-3 leading-relaxed text-neutral-600">@Model.Challenge</p>
            </div>
            <div>
                <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">The solution</span>
                <h2 class="mt-1 text-xl font-bold tracking-tight text-brand-900">What the studio built</h2>
                <p class="mt-3 leading-relaxed text-neutral-600">@Model.Solution</p>
            </div>
        </div>

        <aside class="space-y-4 lg:sticky lg:top-20 lg:self-start">
            <div class="rounded-2xl border border-brand-200 bg-white p-6">
                <h3 class="font-semibold text-brand-900">Project at a glance</h3>
                <dl class="mt-4 space-y-3 text-sm">
                    <div class="flex justify-between gap-3"><dt class="text-neutral-400">Client</dt><dd class="font-semibold text-brand-900">@Model.Client</dd></div>
                    <div class="flex justify-between gap-3"><dt class="text-neutral-400">Location</dt><dd class="font-semibold text-brand-900">@Model.Location</dd></div>
                    <div class="flex justify-between gap-3"><dt class="text-neutral-400">Year</dt><dd class="font-semibold text-brand-900">@Model.Year</dd></div>
                    <div class="flex justify-between gap-3"><dt class="text-neutral-400">Segment</dt><dd class="font-semibold text-brand-900">@Model.Segment</dd></div>
                </dl>
            </div>
            @if (Model.FeaturedProductNames.Any())
            {
                <div class="rounded-2xl border border-brand-200 bg-white p-6">
                    <h3 class="font-semibold text-brand-900">Featured in this project</h3>
                    <ul class="mt-3 space-y-2 text-sm">
                        @foreach (var name in Model.FeaturedProductNames)
                        {
                            <li><a href="/shop" class="font-semibold text-brand-900 underline underline-offset-4">@name</a></li>
                        }
                    </ul>
                </div>
            }
            <a href="/custom-session" class="block rounded-lg bg-brand-700 px-5 py-3 text-center text-sm font-semibold text-white transition hover:bg-brand-500">Start a project like this</a>
        </aside>
    </div>

    @if (Model.Gallery.Any())
    {
        <div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3">
            @foreach (var g in Model.Gallery)
            {
                <img src="@g" alt="@Model.Title detail" loading="lazy" class="h-48 w-full rounded-xl border border-brand-100 object-cover sm:h-56" />
            }
        </div>
    }
</section>

@if (more.Any())
{
    <section class="border-t border-brand-100 bg-brand-50">
        <div class="mx-auto max-w-app px-4 py-14 sm:px-6">
            <div class="flex items-end justify-between">
                <div>
                    <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">More case studies</span>
                    <h2 class="mt-2 text-2xl font-bold tracking-tight text-brand-900">Continue exploring</h2>
                </div>
            </div>
            <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var p in more)
                {
                    <a href="/projects/@p.Slug" class="group flex flex-col overflow-hidden rounded-2xl border border-brand-200 bg-white transition hover:border-brand-300 hover:shadow-lg">
                        <div class="relative overflow-hidden">
                            <img src="@p.CoverImage" alt="@p.Title" loading="lazy" class="h-44 w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                            <span class="absolute left-3 top-3 rounded-full bg-brand-700/90 px-2.5 py-0.5 text-xs font-semibold text-white">@p.Segment</span>
                        </div>
                        <div class="p-5">
                            <div class="text-xs text-neutral-400">@p.Location · @p.Year</div>
                            <h3 class="mt-1 text-base font-bold tracking-tight text-brand-900">@p.Title</h3>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
}