@{
    ViewData["Title"] = "Blog & Journal";
    var posts = (List<StarTalkSessions.Models.BlogPost>)ViewBag.Posts ?? new();
    var tags = (List<string>)ViewBag.Tags ?? new();
    var activeTag = (string)ViewBag.ActiveTag;
}

<section class="border-b border-brand-100">
    <div class="mx-auto max-w-app px-4 py-10 sm:px-6">
        <nav class="text-xs text-neutral-400" aria-label="Breadcrumb">
            <a href="/" class="hover:text-brand-900">Home</a><span class="mx-1">/</span><span class="text-neutral-600">Journal</span>
        </nav>
        <span class="mt-4 block text-xs font-semibold uppercase tracking-widest text-neutral-400">The Studio Journal</span>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">Guides, care &amp; thinking</h1>
        <p class="mt-2 max-w-2xl text-neutral-500">Short, practical articles on choosing, caring for and styling stories that last.</p>
    </div>
</section>

<section class="mx-auto max-w-app px-4 py-8 sm:px-6 lg:py-12">
    <div class="flex flex-wrap gap-2">
        <a href="/blog" class="@(string.IsNullOrWhiteSpace(activeTag) || activeTag == "all" ? "bg-brand-700 text-white" : "border border-brand-200 text-neutral-600 hover:border-brand-600") rounded-full px-4 py-1.5 text-sm font-semibold transition">All</a>
        @foreach (var t in tags)
        {
            <a href="/blog?tag=@Uri.EscapeDataString(t)" class="@(activeTag == t ? "bg-brand-700 text-white" : "border border-brand-200 text-neutral-600 hover:border-brand-600") rounded-full px-4 py-1.5 text-sm font-semibold transition">@t</a>
        }
    </div>

    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var post in posts)
        {
            <a href="/blog/@post.Slug" class="group flex flex-col overflow-hidden rounded-2xl border border-brand-200 bg-white transition hover:border-brand-300 hover:shadow-lg">
                <div class="overflow-hidden">
                    <img src="@post.CoverImage" alt="@post.Title" loading="lazy" class="h-52 w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                </div>
                <div class="flex flex-1 flex-col p-5">
                    <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">@post.Tag · @post.ReadTime</span>
                    <h3 class="mt-2 text-lg font-bold tracking-tight text-brand-900">@post.Title</h3>
                    <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-neutral-500">@post.Excerpt</p>
                    <span class="mt-auto pt-4 text-sm font-semibold text-brand-900 underline decoration-neutral-300 underline-offset-4 transition group-hover:decoration-brand-900">Read article →</span>
                </div>
            </a>
        }
        @if (!posts.Any())
        {
            <div class="col-span-full rounded-2xl border border-brand-200 px-6 py-16 text-center text-sm text-neutral-400">No articles here yet.</div>
        }
    </div>
</section>