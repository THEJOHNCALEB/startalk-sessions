@{
    ViewData["Title"] = "Contact the studio";
    var supportPhone = ViewBag.SupportPhone?.ToString() ?? StarTalkSessions.Utils.Store.SupportPhone;
    var supportEmail = ViewBag.SupportEmail?.ToString() ?? StarTalkSessions.Utils.Store.SupportEmail;
    var address1 = ViewBag.AddressLine1?.ToString() ?? StarTalkSessions.Utils.Store.AddressLine1;
    var address2 = ViewBag.AddressLine2?.ToString() ?? StarTalkSessions.Utils.Store.AddressLine2;
    string waNumber = ViewBag.WhatsappNumber?.ToString() ?? StarTalkSessions.Utils.Store.WhatsappNumber;
    var waDigits = StarTalkSessions.Utils.Functions.WhatsAppDigits(waNumber);
    var wa = $"https://wa.me/{waDigits}";
}

<section class="border-b border-brand-100">
    <div class="mx-auto max-w-app px-4 py-10 sm:px-6">
        <nav class="text-xs text-neutral-400" aria-label="Breadcrumb">
            <a href="/" class="hover:text-brand-900">Home</a><span class="mx-1">/</span><span class="text-neutral-600">Contact</span>
        </nav>
        <span class="mt-4 block text-xs font-semibold uppercase tracking-widest text-neutral-400">Say hello</span>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">Talk to the studio</h1>
        <p class="mt-2 max-w-2xl text-neutral-500">Questions, commissions, trade partnerships — we answer within one business day.</p>
    </div>
</section>

@if (TempData["Success"] != null)
{
    <div class="mx-auto mt-6 max-w-app px-4 sm:px-6"><div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">@TempData["Success"]</div></div>
}
@if (TempData["Error"] != null)
{
    <div class="mx-auto mt-6 max-w-app px-4 sm:px-6"><div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">@TempData["Error"]</div></div>
}

<section class="mx-auto max-w-app px-4 py-8 sm:px-6 lg:py-12">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_1.2fr]">

        <div class="space-y-4">
            <a href="@wa" target="_blank" rel="noopener" class="group flex items-center gap-4 rounded-2xl border border-brand-200 bg-white p-5 transition hover:border-brand-600">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 11.5a8.5 8.5 0 0 1-12.3 7.6L4 20l.9-4.7A8.5 8.5 0 1 1 21 11.5z"/><path d="M9 9.5c.5 2.5 3 5 5.5 5.5l1-1.3c.3-.3.7-.4 1-.2l1.5.8"/></svg>
                </span>
                <div class="min-w-0"><h3 class="font-semibold text-brand-900">WhatsApp</h3><p class="text-sm text-neutral-500">Chat instantly with a studio advisor</p></div>
                <span class="ml-auto text-sm font-semibold text-brand-900 group-hover:underline group-hover:underline-offset-4">Open chat →</span>
            </a>
            <a href="tel:@supportPhone.Replace(" ", "")" class="group flex items-center gap-4 rounded-2xl border border-brand-200 bg-white p-5 transition hover:border-brand-600">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-900">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
                </span>
                <div class="min-w-0"><h3 class="font-semibold text-brand-900">Call the studio</h3><p class="text-sm text-neutral-500">@supportPhone · Mon–Sat 09–18</p></div>
                <span class="ml-auto text-sm font-semibold text-brand-900 group-hover:underline group-hover:underline-offset-4">Call now →</span>
            </a>
            <a href="mailto:@supportEmail" class="group flex items-center gap-4 rounded-2xl border border-brand-200 bg-white p-5 transition hover:border-brand-600">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-violet-100 text-violet-600">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7h18v10H3z"/><path d="M3 10l9 5 9-5"/></svg>
                </span>
                <div class="min-w-0"><h3 class="font-semibold text-brand-900">Email the studio</h3><p class="truncate text-sm text-neutral-500">@supportEmail</p></div>
                <span class="ml-auto text-sm font-semibold text-brand-900 group-hover:underline group-hover:underline-offset-4">Write to us →</span>
            </a>

            <div class="rounded-2xl border border-brand-200 bg-white p-6">
                <h3 class="font-semibold text-brand-900">Flagship studio</h3>
                <p class="mt-2 text-sm leading-relaxed text-neutral-600">
                    @address1<br>
                    @address2
                </p>
                <p class="mt-2 text-sm leading-relaxed text-neutral-500">Mon–Sat · 09:00 – 18:00 (WAT)<br>Sun · by appointment</p>
                <p class="mt-2 text-xs text-neutral-400">Free parking on site. Walk-ins welcome.</p>
            </div>
            <div class="overflow-hidden rounded-2xl border border-brand-200">
                <iframe title="Studio map" src="https://www.google.com/maps?q=@Uri.EscapeDataString(address1 + ", " + address2)&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="h-56 w-full"></iframe>
            </div>
        </div>

        <div class="rounded-2xl border border-brand-200 bg-white p-6 sm:p-8">
            <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">Inquiry form</span>
            <h2 class="mt-1 text-2xl font-bold tracking-tight text-brand-900">Tell us what you need</h2>
            <form method="post" action="/contact/submit" enctype="multipart/form-data" class="mt-6 space-y-5" data-loading>
                <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                    <div>
                        <label for="c-name" class="mb-1.5 block text-sm font-medium text-neutral-700">Name</label>
                        <input type="text" id="c-name" name="Name" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" required />
                    </div>
                    <div>
                        <label for="c-email" class="mb-1.5 block text-sm font-medium text-neutral-700">Email</label>
                        <input type="email" id="c-email" name="Email" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" required />
                    </div>
                    <div>
                        <label for="c-phone" class="mb-1.5 block text-sm font-medium text-neutral-700">Phone</label>
                        <input type="tel" id="c-phone" name="Phone" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" />
                    </div>
                    <div>
                        <label for="c-type" class="mb-1.5 block text-sm font-medium text-neutral-700">Inquiry type</label>
                        <select id="c-type" name="Type" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600">
                            <option>General Inquiry</option>
                            <option>Order Status</option>
                            <option>Commercial Project</option>
                            <option>Partnership</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label for="c-message" class="mb-1.5 block text-sm font-medium text-neutral-700">Message</label>
                    <textarea id="c-message" name="Message" rows="6" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" required></textarea>
                </div>
                <button type="submit" class="w-full rounded-lg bg-brand-700 px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-500">Send inquiry</button>
            </form>
        </div>
    </div>
</section>