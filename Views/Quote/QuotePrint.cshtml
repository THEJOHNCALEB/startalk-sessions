@{
    ViewData["Title"] = "Quote";
    var quote = (StarTalkSessions.Models.CustomQuote)ViewBag.Quote;
}

<section class="mx-auto max-w-2xl px-4 py-14 sm:px-6">
    <div class="rounded-2xl border border-brand-200 bg-white p-8 sm:p-12">
        <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">Bespoke quotation — @quote.RefNumber</span>
        <h1 class="mt-2 text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">Your quote request</h1>

        <dl class="mt-6 grid grid-cols-2 gap-4 rounded-xl bg-brand-50 p-6">
            <div><dt class="text-xs text-neutral-400">Reference</dt><dd class="mt-0.5 font-semibold text-brand-900">@quote.RefNumber</dd></div>
            <div><dt class="text-xs text-neutral-400">Category</dt><dd class="mt-0.5 font-semibold text-brand-900">@quote.Category</dd></div>
            <div><dt class="text-xs text-neutral-400">Status</dt><dd class="mt-0.5 font-semibold text-brand-900">@quote.Status</dd></div>
            <div><dt class="text-xs text-neutral-400">Budget</dt><dd class="mt-0.5 font-semibold text-brand-900">@(quote.Budget ?? "To advise")</dd></div>
        </dl>

        <p class="mt-6 text-sm leading-relaxed text-neutral-500">PDF generation requires the server's headless browser to initialize on first use. You can view the quotation summary here meanwhile — or reach us on WhatsApp for an instant response.</p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/custom-session" class="rounded-lg bg-brand-700 px-6 py-3 text-center text-sm font-semibold text-white transition hover:bg-brand-500">Edit requirements</a>
            <a asp-controller="Custom" asp-action="Index" class="rounded-lg border border-brand-200 px-6 py-3 text-center text-sm font-semibold text-brand-900 transition hover:border-brand-600">Back to builder</a>
        </div>
    </div>
</section>