@{
    ViewData["Title"] = "Shop the Collection";
    var products = (List<StarTalkSessions.Models.Product>)ViewBag.Products ?? new();
    var categories = (List<StarTalkSessions.Models.Category>)ViewBag.Categories ?? new();
    var activeCategory = ViewBag.ActiveCategory as StarTalkSessions.Models.Category;
    var materials = (List<string>)ViewBag.AllMaterials ?? new();
    var styles = new[] { "Mid-Century Modern", "Japanese Minimalist", "Industrial", "Luxury Contemporary", "Bespoke" };
}

<section class="border-b border-brand-100">
    <div class="mx-auto max-w-app px-4 py-10 sm:px-6">
        <nav class="text-xs text-neutral-400" aria-label="Breadcrumb">
            <a href="/" class="hover:text-brand-900">Home</a><span class="mx-1">/</span><span class="text-neutral-600">Shop</span>
        </nav>
        <h1 class="mt-3 text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">@(activeCategory != null ? activeCategory.Name : "The Collection")</h1>
        <p class="mt-2 max-w-2xl text-neutral-500">@(activeCategory?.Description ?? "Every piece is kiln-dried, hand-finished and backed by our lifetime guarantee. ")<span class="text-neutral-400">@ViewBag.Total pieces</span></p>
    </div>
</section>

<section class="mx-auto max-w-app px-4 py-8 sm:px-6 lg:py-12">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[16rem_1fr]">

        @* ---------- Filter sidebar ---------- *@
        <aside class="data-filter-panel rounded-2xl border border-brand-200 bg-white p-5 lg:sticky lg:top-20 lg:self-start">
            <div class="mb-4 flex items-center justify-between lg:hidden">
                <h3 class="text-base font-semibold text-brand-900">Filters</h3>
                <a href="/shop" class="text-sm text-neutral-400">×</a>
            </div>

            <form method="get" action="/shop" data-filter-form class="space-y-6">
                @if (!string.IsNullOrWhiteSpace(ViewBag.ActiveQ))
                {
                    <input type="hidden" name="q" value="@ViewBag.ActiveQ" />
                }

                <div>
                    <h4 class="mb-2 text-xs font-semibold uppercase tracking-wider text-neutral-400">Category</h4>
                    <div class="space-y-1.5">
                        <label class="flex items-center gap-2 text-sm text-neutral-700">
                            <input type="radio" name="category" value="" @(activeCategory == null ? "checked" : "") class="accent-brand-600" /> All categories
                        </label>
                        @foreach (var c in categories)
                        {
                            <label class="flex items-center gap-2 text-sm text-neutral-700">
                                <input type="radio" name="category" value="@c.Slug" @(c.Slug == ViewBag.ActiveCategory?.Slug ? "checked" : "") class="accent-brand-600" /> @c.Name
                            </label>
                        }
                    </div>
                </div>

                <div>
                    <h4 class="mb-2 text-xs font-semibold uppercase tracking-wider text-neutral-400">Material</h4>
                    <div class="space-y-1.5">
                        @foreach (var m in materials.OrderBy(x => x).Take(12))
                        {
                            <label class="flex items-center gap-2 text-sm text-neutral-700">
                                <input type="checkbox" name="material" value="@m" @(ViewBag.ActiveMaterial == m ? "checked" : "") class="accent-brand-600" /> @m
                            </label>
                        }
                    </div>
                </div>

                <div>
                    <h4 class="mb-2 text-xs font-semibold uppercase tracking-wider text-neutral-400">Style</h4>
                    <select name="style" class="w-full rounded-lg border border-neutral-300 px-3 py-2 text-sm outline-none focus:border-brand-600">
                        <option value="">All styles</option>
                        @foreach (var s in styles)
                        {
                            <option value="@s" selected="@(ViewBag.ActiveStyle == s ? "selected" : null)">@s</option>
                        }
                    </select>
                </div>

                <div>
                    <h4 class="mb-2 text-xs font-semibold uppercase tracking-wider text-neutral-400">Price (USD)</h4>
                    <div class="flex items-center gap-2">
                        <input type="number" name="min" placeholder="Min" value="@ViewBag.Min" min="0" class="w-full rounded-lg border border-neutral-300 px-3 py-2 text-sm outline-none focus:border-brand-600" />
                        <span class="text-neutral-400">—</span>
                        <input type="number" name="max" placeholder="Max" value="@ViewBag.Max" min="0" class="w-full rounded-lg border border-neutral-300 px-3 py-2 text-sm outline-none focus:border-brand-600" />
                    </div>
                </div>

                <div>
                    <h4 class="mb-2 text-xs font-semibold uppercase tracking-wider text-neutral-400">Availability</h4>
                    <div class="space-y-1.5 text-sm text-neutral-700">
                        <label class="flex items-center gap-2"><input type="radio" name="availability" value="" @(ViewBag.ActiveAvailability == null ? "checked" : "") class="accent-brand-600" /> All</label>
                        <label class="flex items-center gap-2"><input type="radio" name="availability" value="in-stock" @(ViewBag.ActiveAvailability == "in-stock" ? "checked" : "") class="accent-brand-600" /> In stock</label>
                        <label class="flex items-center gap-2"><input type="radio" name="availability" value="customizable" @(ViewBag.ActiveAvailability == "customizable" ? "checked" : "") class="accent-brand-600" /> Customizable</label>
                    </div>
                </div>

                <div class="space-y-2">
                    <button type="submit" class="w-full rounded-lg bg-brand-700 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-500">Apply filters</button>
                    <a href="/shop" class="block w-full rounded-lg border border-brand-200 px-4 py-2.5 text-center text-sm font-semibold text-brand-700 transition hover:border-brand-600">Clear all</a>
                </div>
            </form>

            @await Component.InvokeAsync("BannerAds", new { placement = "sidebar" })
        </aside>

        @* ---------- Content ---------- *@
        <div>
            <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
                <span class="text-sm text-neutral-500" data-shop-count>@ViewBag.Total products</span>
                <div class="flex items-center gap-2 text-sm">
                    <label for="sort" class="text-neutral-500">Sort</label>
                    <select id="sort" name="sort" data-sort-select class="rounded-lg border border-neutral-300 px-3 py-1.5 text-sm outline-none focus:border-brand-600">
                        <option value="featured" selected="@(ViewBag.ActiveSort == "featured" || ViewBag.ActiveSort == null ? "selected" : null)">Featured</option>
                        <option value="price-asc" selected="@(ViewBag.ActiveSort == "price-asc" ? "selected" : null)">Price: Low to High</option>
                        <option value="price-desc" selected="@(ViewBag.ActiveSort == "price-desc" ? "selected" : null)">Price: High to Low</option>
                        <option value="newest" selected="@(ViewBag.ActiveSort == "newest" ? "selected" : null)">Newest Arrivals</option>
                        <option value="best" selected="@(ViewBag.ActiveSort == "best" ? "selected" : null)">Best Sellers</option>
                    </select>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(ViewBag.ActiveQ))
            {
                <div class="mb-6 flex flex-wrap gap-2">
                    <span class="inline-flex items-center gap-2 rounded-full border border-brand-200 px-3 py-1 text-sm text-neutral-700">Search: "@ViewBag.ActiveQ" <a href="/shop" class="text-neutral-400 hover:text-brand-900">×</a></span>
                </div>
            }

            @if (products.Any())
            {
                <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-3">
                    @foreach (var p in products)
                    {
                        @await Html.PartialAsync("_ProductCard", p)
                    }
                </div>
            }
            else
            {
                <div class="rounded-2xl border border-brand-200 px-6 py-16 text-center">
                    <h3 class="text-lg font-semibold text-brand-900">No pieces match those filters</h3>
                    <p class="mt-1 text-sm text-neutral-500">Try widening the price range or clearing a filter or two.</p>
                    <a href="/shop" class="mt-6 inline-flex rounded-lg bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-500">Clear all filters</a>
                </div>
            }

            @await Component.InvokeAsync("BannerAds", new { placement = "inline" })
        </div>
    </div>
</section>