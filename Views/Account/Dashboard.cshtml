@model StarTalkSessions.Models.UserModel
@{
    ViewData["Title"] = "Account";
    var orders = (List<StarTalkSessions.Models.Order>)ViewBag.Orders ?? new();
    var quotes = (List<StarTalkSessions.Models.CustomQuote>)ViewBag.Quotes ?? new();
}

<section class="mx-auto max-w-app px-4 py-8 sm:px-6 lg:py-12">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[15rem_1fr]">

        <aside class="self-start rounded-2xl border border-brand-200 bg-white p-5 lg:sticky lg:top-20">
            <div class="mb-5 flex items-center gap-3 border-b border-brand-100 pb-5">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-700 text-base font-bold text-white">@(Model.FullName.Length >= 1 ? Model.FullName[..1].ToUpperInvariant() : "A")</span>
                <div class="min-w-0">
                    <strong class="block truncate text-sm text-brand-900">@Model.FullName</strong>
                    <span class="block truncate text-xs text-neutral-400">@Model.Email</span>
                </div>
            </div>
            <nav class="flex flex-col gap-1 text-sm">
                <a href="/account" class="rounded-lg bg-brand-700 px-3 py-2.5 font-semibold text-white">Overview</a>
                <a href="/account/Orders" class="rounded-lg px-3 py-2.5 text-neutral-600 transition hover:bg-brand-100">Orders &amp; tracking</a>
                <a href="/account/Quotes" class="rounded-lg px-3 py-2.5 text-neutral-600 transition hover:bg-brand-100">Custom quotes</a>
                <a href="#profile" class="rounded-lg px-3 py-2.5 text-neutral-600 transition hover:bg-brand-100">Profile settings</a>
                <a asp-controller="Auth" asp-action="Logout" class="rounded-lg px-3 py-2.5 text-red-600 transition hover:bg-red-50">Sign out</a>
            </nav>
        </aside>

        <div class="min-w-0">
            @if (TempData["Success"] != null)
            {
                <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">@TempData["Error"]</div>
            }

            <h1 class="text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">Welcome back, @Model.FirstName</h1>
            <p class="mt-1 text-neutral-500">Here's the state of your studio.</p>

            <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div class="rounded-2xl border border-brand-200 bg-white p-5"><span class="text-xs text-neutral-400">Orders</span><strong class="mt-1 block text-2xl font-bold text-brand-900">@orders.Count</strong></div>
                <div class="rounded-2xl border border-brand-200 bg-white p-5"><span class="text-xs text-neutral-400">Active</span><strong class="mt-1 block text-2xl font-bold text-brand-900">@orders.Count(o => o.Status == "Processing" || o.Status == "In Transit")</strong></div>
                <div class="rounded-2xl border border-brand-200 bg-white p-5"><span class="text-xs text-neutral-400">Custom quotes</span><strong class="mt-1 block text-2xl font-bold text-brand-900">@quotes.Count</strong></div>
                <div class="rounded-2xl border border-brand-200 bg-white p-5"><span class="text-xs text-neutral-400">Wishlist</span><strong class="mt-1 block text-2xl font-bold text-brand-900" data-wishlist-stat>0</strong></div>
            </div>

            @if (orders.Any())
            {
                <div class="mt-8 flex items-end justify-between">
                    <div><span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">Recent orders</span><h2 class="mt-1 text-xl font-bold tracking-tight text-brand-900">Order history</h2></div>
                    <a href="/account/Orders" class="text-sm font-semibold text-brand-900 underline underline-offset-4">View all →</a>
                </div>
                <ul class="mt-4 divide-y divide-brand-100 rounded-2xl border border-brand-200 bg-white">
                    @foreach (var o in orders.Take(3))
                    {
                        <li class="flex flex-col gap-2 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
                            <div>
                                <strong class="text-sm text-brand-900">@o.OrderNumber</strong>
                                <span class="ml-2 text-xs text-neutral-400">@o.CreatedAt.ToString("MMM d, yyyy") · @o.Items.Sum(i => i.Quantity) item(s)</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="@(o.Status == "Processing" ? "bg-amber-100 text-amber-700" : "bg-emerald-100 text-emerald-700") rounded-full px-2.5 py-0.5 text-xs font-medium">@o.Status</span>
                                <strong class="text-sm font-bold text-brand-900" data-usd="@o.Total"></strong>
                            </div>
                        </li>
                    }
                </ul>
            }

            @if (quotes.Any())
            {
                <div class="mt-8 flex items-end justify-between">
                    <div><span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">Submitted designs</span><h2 class="mt-1 text-xl font-bold tracking-tight text-brand-900">Custom quotes</h2></div>
                </div>
                <ul class="mt-4 divide-y divide-brand-100 rounded-2xl border border-brand-200 bg-white">
                    @foreach (var q in quotes.Take(4))
                    {
                        <li class="flex flex-col gap-2 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
                            <div>
                                <strong class="text-sm text-brand-900">@q.RefNumber · @q.Category</strong>
                                <span class="ml-2 text-xs text-neutral-400">Submitted @q.CreatedAt.ToString("MMM d, yyyy")</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="rounded-full bg-brand-100 px-2.5 py-0.5 text-xs font-medium text-neutral-600">@q.Status</span>
                                <a href="/quote/pdf/@q.Id" class="rounded-lg border border-brand-200 px-3 py-1.5 text-xs font-semibold text-neutral-700 transition hover:border-brand-600">Download PDF</a>
                            </div>
                        </li>
                    }
                </ul>
            }

            <div id="profile" class="mt-8 flex items-end justify-between">
                <div><span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">Account</span><h2 class="mt-1 text-xl font-bold tracking-tight text-brand-900">Profile settings</h2></div>
            </div>
            <form method="post" action="/account/updateprofile" class="mt-4 space-y-5 rounded-2xl border border-brand-200 bg-white p-6" data-loading>
                <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                    <div>
                        <label for="fn" class="mb-1.5 block text-sm font-medium text-neutral-700">First name</label>
                        <input type="text" id="fn" name="firstName" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" value="@Model.FirstName" required />
                    </div>
                    <div>
                        <label for="ln" class="mb-1.5 block text-sm font-medium text-neutral-700">Last name</label>
                        <input type="text" id="ln" name="lastName" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" value="@Model.LastName" required />
                    </div>
                    <div>
                        <label for="ph" class="mb-1.5 block text-sm font-medium text-neutral-700">Phone</label>
                        <input type="tel" id="ph" name="phone" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" value="@Model.Phone" />
                    </div>
                    <div>
                        <label for="cty" class="mb-1.5 block text-sm font-medium text-neutral-700">City</label>
                        <input type="text" id="cty" name="city" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" value="@Model.City" />
                    </div>
                    <div class="sm:col-span-2">
                        <label for="addr" class="mb-1.5 block text-sm font-medium text-neutral-700">Street address</label>
                        <input type="text" id="addr" name="address" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" value="@Model.Address" />
                    </div>
                    <div>
                        <label for="ctry" class="mb-1.5 block text-sm font-medium text-neutral-700">Country</label>
                        <input type="text" id="ctry" name="country" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" value="@Model.Country" />
                    </div>
                </div>
                <button type="submit" class="rounded-lg bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-500">Save changes</button>
            </form>
        </div>
    </div>
</section>
