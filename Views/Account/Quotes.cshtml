@model StarTalkSessions.Models.UserModel
@{
    ViewData["Title"] = "Custom Quotes";
    var quotes = (List<StarTalkSessions.Models.CustomQuote>)ViewBag.Quotes ?? new();
}

<section class="mx-auto max-w-app px-4 py-8 sm:px-6 lg:py-12">
    <nav class="text-xs text-neutral-400" aria-label="Breadcrumb">
        <a href="/account" class="hover:text-brand-900">Account</a><span class="mx-1">/</span><span class="text-neutral-600">Quotes</span>
    </nav>
    <h1 class="mt-3 text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">Custom quotes</h1>

    @if (!quotes.Any())
    {
        <div class="mt-8 rounded-2xl border border-brand-200 bg-white px-6 py-16 text-center">
            <h3 class="text-lg font-semibold text-brand-900">No custom requests yet</h3>
            <p class="mt-1 text-sm text-neutral-500">Describe your dream piece and we'll quote it in a day.</p>
            <a href="/custom-furniture" class="mt-6 inline-flex rounded-lg bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-500">Start a custom project</a>
        </div>
    }
    else
    {
        <div class="mt-8 space-y-4">
            @foreach (var q in quotes)
            {
                <div class="rounded-2xl border border-brand-200 bg-white p-6">
                    <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                        <div>
                            <strong class="text-base text-brand-900">@q.RefNumber</strong>
                            <span class="ml-2 text-xs text-neutral-400">@q.Category @(!string.IsNullOrWhiteSpace(q.Style) ? $"· {q.Style}" : "")</span>
                        </div>
                        <span class="self-start rounded-full bg-brand-100 px-2.5 py-0.5 text-xs font-medium text-neutral-600">@q.Status</span>
                    </div>
                    <p class="mt-3 text-xs text-neutral-400">
                        Submitted @q.CreatedAt.ToString("MMM d, yyyy") · Delivery target: @(q.DeliveryBy ?? "To advise") · Budget: @(q.Budget ?? "To advise")
                    </p>
                    <p class="mt-1 text-xs text-neutral-400">Dimensions (@q.DimensionUnit): @(string.IsNullOrEmpty(q.Width) ? "To propose" : $"{q.Width} × {q.Height} × {q.Depth} W×H×D")</p>
                    <div class="mt-4 flex flex-wrap items-center gap-3 border-t border-brand-100 pt-4">
                        <a href="/quote/pdf/@q.Id" class="rounded-lg border border-brand-200 px-3 py-1.5 text-xs font-semibold text-neutral-700 transition hover:border-brand-600">Download quote PDF</a>
                        <a href="/custom-furniture" class="text-xs font-semibold text-brand-900 underline underline-offset-4">Edit requirements →</a>
                    </div>
                </div>
            }
        </div>
    }
</section>