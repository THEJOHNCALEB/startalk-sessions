@model StarTalkSessions.Models.UserModel
@{
    ViewData["Title"] = "Orders & Tracking";
    var orders = (List<StarTalkSessions.Models.Order>)ViewBag.Orders ?? new();
}

<section class="mx-auto max-w-app px-4 py-8 sm:px-6 lg:py-12">
    <nav class="text-xs text-neutral-400" aria-label="Breadcrumb">
        <a href="/account" class="hover:text-brand-900">Account</a><span class="mx-1">/</span><span class="text-neutral-600">Orders</span>
    </nav>
    <h1 class="mt-3 text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">Orders &amp; tracking</h1>

    @if (!orders.Any())
    {
        <div class="mt-8 rounded-2xl border border-brand-200 bg-white px-6 py-16 text-center">
            <h3 class="text-lg font-semibold text-brand-900">No orders yet</h3>
            <p class="mt-1 text-sm text-neutral-500">Your purchases and tracking references will appear here.</p>
            <a href="/shop" class="mt-6 inline-flex rounded-lg bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-500">Start shopping</a>
        </div>
    }
    else
    {
        <div class="mt-8 space-y-4">
            @foreach (var o in orders)
            {
                <div class="rounded-2xl border border-brand-200 bg-white p-6">
                    <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                        <div>
                            <strong class="text-base text-brand-900">@o.OrderNumber</strong>
                            <span class="ml-2 text-xs text-neutral-400">Placed @o.CreatedAt.ToString("MMM d, yyyy")</span>
                            @if (o.EstimatedDelivery.HasValue)
                            {
                                <span class="ml-2 text-xs text-neutral-400">Est. delivery @o.EstimatedDelivery.Value.ToString("MMM d, yyyy")</span>
                            }
                        </div>
                        <span class="@(o.Status == "Processing" ? "bg-amber-100 text-amber-700" : "bg-emerald-100 text-emerald-700") self-start rounded-full px-2.5 py-0.5 text-xs font-medium">@o.Status</span>
                    </div>

                    <p class="mt-3 text-xs text-neutral-400">Tracking <strong class="text-neutral-700">@o.TrackingRef</strong></p>

                    <ul class="mt-3 divide-y divide-brand-100">
                        @foreach (var item in o.Items)
                        {
                            <li class="flex items-center gap-3 py-3">
                                @if (!string.IsNullOrEmpty(item.Image))
                                {
                                    <img src="@item.Image" alt="" loading="lazy" class="h-14 w-14 rounded-lg border border-brand-100 object-cover" />
                                }
                                <div class="min-w-0 flex-1">
                                    <strong class="block truncate text-sm text-brand-900">@item.ProductName</strong>
                                    <span class="text-xs text-neutral-500">@item.Quantity × <span data-usd="@item.UnitPrice"></span></span>
                                    @if (!string.IsNullOrEmpty(item.Variants))
                                    {
                                        <span class="block truncate text-xs text-neutral-400">@item.Variants</span>
                                    }
                                </div>
                            </li>
                        }
                    </ul>

                    <div class="mt-2 flex items-center justify-between border-t border-brand-100 pt-4">
                        <span class="text-sm text-neutral-500">Total</span>
                        <strong class="text-base font-bold text-brand-900" data-usd="@o.Total"></strong>
                    </div>
                </div>
            }
        </div>
    }
</section>