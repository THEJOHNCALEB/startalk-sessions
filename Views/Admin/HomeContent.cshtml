@using StarTalkSessions.Models
@{
    ViewData["Title"] = "Admin — Homepage";
    var items = (List<HomeContent>)ViewBag.Content ?? new();
    var editing = ViewBag.Editing as HomeContent;
    var sections = new[] { "hero", "spotlight", "recommended", "archive", "channel" };
    var tones = new[] { "conversation", "live", "culture", "community" };
}

@await Html.PartialAsync("_AdminNav")

<section class="mx-auto max-w-app px-4 py-8 sm:px-6">
    <div>
        <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">Editorial</span>
        <h1 class="mt-1 text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">Homepage content</h1>
        <p class="mt-1 text-sm text-neutral-500">Every episode, spotlight and show on the landing page is managed here. Nothing is hard-coded.</p>
    </div>

    @if (TempData["AdminSuccess"] != null)
    {
        <div class="mt-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">@TempData["AdminSuccess"]</div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="mt-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-600">@TempData["AdminError"]</div>
    }

    <form method="post" action="/Admin/HomeContentSave" enctype="multipart/form-data" class="mt-6 rounded-2xl border border-brand-200 bg-white p-6">
        <h2 class="text-sm font-semibold text-brand-900">@(editing == null ? "New item" : "Edit item")</h2>
        @if (editing != null)
        {
            <input type="hidden" name="id" value="@editing.Id" />
        }
        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <div>
                <label for="hcSection" class="mb-1 block text-xs font-semibold text-neutral-500">Zone</label>
                <select id="hcSection" name="section" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm text-brand-900">
                    @foreach (var zone in sections)
                    {
                        <option value="@zone" selected="@(editing?.Section == zone)">@zone</option>
                    }
                </select>
            </div>
            <div>
                <label for="hcTitle" class="mb-1 block text-xs font-semibold text-neutral-500">Title</label>
                <input id="hcTitle" name="title" required value="@editing?.Title" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm text-brand-900" />
            </div>
            <div>
                <label for="hcKicker" class="mb-1 block text-xs font-semibold text-neutral-500">Kicker / series</label>
                <input id="hcKicker" name="kicker" value="@editing?.Kicker" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm text-brand-900" />
            </div>
            <div class="sm:col-span-2">
                <label for="hcSummary" class="mb-1 block text-xs font-semibold text-neutral-500">Summary</label>
                <textarea id="hcSummary" name="summary" rows="2" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm text-brand-900">@editing?.Summary</textarea>
            </div>
            <div>
                <label for="hcDuration" class="mb-1 block text-xs font-semibold text-neutral-500">Duration</label>
                <input id="hcDuration" name="duration" value="@editing?.Duration" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm text-brand-900" />
            </div>
            <div>
                <label for="hcBadge" class="mb-1 block text-xs font-semibold text-neutral-500">Channel badge</label>
                <input id="hcBadge" name="badge" value="@editing?.Badge" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm text-brand-900" />
            </div>
            <div>
                <label for="hcTone" class="mb-1 block text-xs font-semibold text-neutral-500">Emblem tone</label>
                <select id="hcTone" name="tone" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm text-brand-900">
                    @foreach (var tone in tones)
                    {
                        <option value="@tone" selected="@(editing?.Tone == tone)">@tone</option>
                    }
                </select>
            </div>
            <div>
                <label for="hcSchedule" class="mb-1 block text-xs font-semibold text-neutral-500">Schedule</label>
                <input id="hcSchedule" name="schedule" value="@editing?.Schedule" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm text-brand-900" />
            </div>
            <div>
                <label for="hcTarget" class="mb-1 block text-xs font-semibold text-neutral-500">Target URL</label>
                <input id="hcTarget" name="targetUrl" value="@(editing?.TargetUrl ?? "/media")" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm text-brand-900" />
            </div>
            <div>
                <label for="hcSort" class="mb-1 block text-xs font-semibold text-neutral-500">Order</label>
                <input id="hcSort" type="number" name="sortOrder" value="@editing?.SortOrder" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm text-brand-900" />
            </div>
            <div class="sm:col-span-2">
                <label for="hcImageUrl" class="mb-1 block text-xs font-semibold text-neutral-500">Image URL</label>
                <input id="hcImageUrl" name="imageUrl" value="@editing?.ImageUrl" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm text-brand-900" />
            </div>
            <div class="sm:col-span-2">
                <label for="hcImage" class="mb-1 block text-xs font-semibold text-neutral-500">Or upload artwork</label>
                <input id="hcImage" type="file" name="image" accept=".jpg,.jpeg,.png,.webp,.gif,.avif"
                       class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm text-neutral-700 file:mr-3 file:rounded-lg file:border-0 file:bg-brand-700 file:px-3 file:py-1 file:text-xs file:font-semibold file:text-white" />
            </div>
        </div>
        <div class="mt-4 flex items-center gap-3">
            <button type="submit" class="rounded-lg bg-brand-700 px-5 py-2 text-sm font-semibold text-white transition hover:bg-brand-500">@(editing == null ? "Create item" : "Save changes")</button>
            @if (editing != null)
            {
                <a href="/Admin/HomeContent" class="text-sm text-neutral-500 hover:text-brand-900">Cancel</a>
            }
        </div>
    </form>

    @foreach (var zone in sections)
    {
        var zoneItems = items.Where(x => x.Section == zone).ToList();
        if (zoneItems.Count == 0) { continue; }
        <div class="mt-8 overflow-hidden rounded-2xl border border-brand-200 bg-white">
            <div class="border-b border-brand-100 px-6 py-3 text-xs font-bold uppercase tracking-widest text-neutral-500">@zone</div>
            <ul class="divide-y divide-brand-100">
                @foreach (var item in zoneItems)
                {
                    <li class="flex flex-col gap-3 px-6 py-4 sm:flex-row sm:items-center sm:justify-between">
                        <div class="flex min-w-0 items-center gap-4">
                            <img src="@item.ImageUrl" alt="" loading="lazy" class="h-14 w-14 shrink-0 bg-brand-50 object-cover" />
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <strong class="truncate text-sm text-brand-900">@item.Title</strong>
                                    @if (item.IsActive)
                                    {
                                        <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-emerald-600">Live</span>
                                    }
                                    else
                                    {
                                        <span class="rounded-full bg-red-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-red-500">Paused</span>
                                    }
                                </div>
                                <p class="truncate text-xs text-neutral-500">@(string.IsNullOrWhiteSpace(item.Kicker) ? item.TargetUrl : item.Kicker) · order @item.SortOrder</p>
                            </div>
                        </div>
                        <div class="flex shrink-0 flex-wrap items-center gap-2">
                            <a href="/Admin/HomeContent?edit=@item.Id" class="rounded-lg border border-brand-200 px-3 py-1.5 text-xs font-semibold text-neutral-700 transition hover:border-brand-600">Edit</a>
                            <form method="post" action="/Admin/HomeContentToggle">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="rounded-lg border border-brand-200 px-3 py-1.5 text-xs font-semibold text-neutral-700 transition hover:border-brand-600">@(item.IsActive ? "Pause" : "Activate")</button>
                            </form>
                            <form method="post" action="/Admin/HomeContentDelete" onsubmit="return confirm('Delete this item permanently?')">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="rounded-lg border border-red-200 px-3 py-1.5 text-xs font-semibold text-red-600 transition hover:bg-red-50">Delete</button>
                            </form>
                        </div>
                    </li>
                }
            </ul>
        </div>
    }
</section>
