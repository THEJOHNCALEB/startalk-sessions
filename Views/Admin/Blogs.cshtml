@{
    ViewData["Title"] = "Admin — Blogs";
    var blogs = (List<StarTalkSessions.Models.BlogPost>)ViewBag.Blogs ?? new();
}

@await Html.PartialAsync("_AdminNav")

<section class="mx-auto max-w-app px-4 py-8 sm:px-6">
    <div class="flex items-end justify-between gap-4">
        <div>
            <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">Content</span>
            <h1 class="mt-1 text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">Blog &amp; journal</h1>
        </div>
    </div>

    @if (TempData["AdminSuccess"] != null)
    {
        <div class="mt-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">@TempData["AdminSuccess"]</div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="mt-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">@TempData["AdminError"]</div>
    }

    @* ---------- Create ---------- *@
    <div class="mt-8 rounded-2xl border border-brand-200 bg-white">
        <button type="button" onclick="document.getElementById('blog-form').classList.toggle('hidden')" class="flex w-full items-center justify-between px-6 py-4 text-left">
            <span class="text-base font-semibold text-brand-900">Write new post</span>
            <span class="text-lg text-neutral-400">+</span>
        </button>
        <form id="blog-form" method="post" action="/Admin/BlogCreate" class="hidden space-y-5 border-t border-brand-100 px-6 py-6">
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-neutral-700">Title *</label>
                    <input type="text" name="title" required class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" />
                </div>
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-neutral-700">Slug</label>
                    <input type="text" name="slug" placeholder="auto-generated" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" />
                </div>
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-neutral-700">Tag</label>
                    <input type="text" name="tag" value="Journal" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" />
                </div>
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-neutral-700">Read time</label>
                    <input type="text" name="readTime" placeholder="3 min read" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" />
                </div>
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-neutral-700">Author</label>
                    <input type="text" name="author" value="Studio" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" />
                </div>
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-neutral-700">Cover image URL</label>
                    <input type="url" name="coverImage" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" />
                </div>
            </div>
            <div>
                <label class="mb-1.5 block text-sm font-medium text-neutral-700">Excerpt</label>
                <textarea name="excerpt" rows="2" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600"></textarea>
            </div>
            <div>
                <label class="mb-1.5 block text-sm font-medium text-neutral-700">Content</label>
                <textarea name="content" rows="6" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600"></textarea>
            </div>
            <button type="submit" class="rounded-lg bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-500">Publish post</button>
        </form>
    </div>

    @* ---------- List ---------- *@
    <ul class="mt-6 divide-y divide-brand-100 rounded-2xl border border-brand-200 bg-white">
        @foreach (var b in blogs)
        {
            <li class="flex flex-col gap-3 px-6 py-4 sm:flex-row sm:items-center sm:justify-between">
                <div class="min-w-0">
                    <span class="text-xs font-semibold uppercase tracking-wider text-neutral-400">@b.Tag · @b.ReadTime @(!b.IsActive ? "· Draft" : "")</span>
                    <h3 class="mt-0.5 truncate text-sm font-semibold text-brand-900">@b.Title</h3>
                    <p class="line-clamp-1 text-xs text-neutral-400">@b.Excerpt</p>
                </div>
                <div class="flex shrink-0 items-center gap-2">
                    <span class="@(b.IsActive ? "bg-emerald-100 text-emerald-700" : "bg-brand-100 text-neutral-500") rounded-full px-2.5 py-0.5 text-xs font-medium">@(b.IsActive ? "Live" : "Hidden")</span>
                    <form method="post" action="/Admin/BlogToggle">
                        <input type="hidden" name="id" value="@b.Id" />
                        <button type="submit" class="rounded-lg border border-brand-200 px-3 py-1.5 text-xs font-semibold text-neutral-700 transition hover:border-brand-600">@(b.IsActive ? "Hide" : "Publish")</button>
                    </form>
                    <form method="post" action="/Admin/BlogDelete" onsubmit="return confirm('Delete this post?')">
                        <input type="hidden" name="id" value="@b.Id" />
                        <button type="submit" class="rounded-lg border border-red-200 px-3 py-1.5 text-xs font-semibold text-red-600 transition hover:bg-red-50">Delete</button>
                    </form>
                </div>
            </li>
        }
        @if (!blogs.Any())
        {
            <li class="px-6 py-10 text-center text-sm text-neutral-400">No posts yet.</li>
        }
    </ul>
</section>