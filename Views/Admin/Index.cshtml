@{
    ViewData["Title"] = "Admin — Overview";
    var orders = (List<StarTalkSessions.Models.Order>)ViewBag.Orders ?? new();
    var inquiries = (List<StarTalkSessions.Models.Inquiry>)ViewBag.Inquiries ?? new();
    var users = (List<StarTalkSessions.Models.UserModel>)ViewBag.Users ?? new();
    var topProducts = ViewBag.TopProducts as List<dynamic> ?? new();
}

@await Html.PartialAsync("_AdminNav")

<section class="mx-auto max-w-app px-4 py-8 sm:px-6">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">Analytics</span>
            <h1 class="mt-1 text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">Studio overview</h1>
            <p class="mt-1 text-sm text-neutral-500">Everything happening across the platform at a glance.</p>
        </div>
    </div>

    <div class="mt-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
        <div class="rounded-2xl border border-brand-200 bg-white p-5">
            <span class="text-xs font-medium uppercase tracking-wider text-neutral-400">Revenue</span>
            <strong class="mt-2 block text-2xl font-black text-brand-900">@ViewBag.Revenue.ToString("N0")</strong>
            <span class="mt-1 block text-xs text-neutral-500">₦ equivalent shown · @ViewBag.MonthOrders orders this month</span>
        </div>
        <div class="rounded-2xl border border-brand-200 bg-white p-5">
            <span class="text-xs font-medium uppercase tracking-wider text-neutral-400">Orders</span>
            <strong class="mt-2 block text-2xl font-black text-brand-900">@ViewBag.OrderCount</strong>
            <span class="mt-1 block text-xs text-neutral-500">@ViewBag.NewOrders awaiting fulfilment</span>
        </div>
        <div class="rounded-2xl border border-brand-200 bg-white p-5">
            <span class="text-xs font-medium uppercase tracking-wider text-neutral-400">Customers</span>
            <strong class="mt-2 block text-2xl font-black text-brand-900">@users.Count</strong>
            <span class="mt-1 block text-xs text-neutral-500">@ViewBag.NewUsers30 new in the last 30 days</span>
        </div>
        <div class="rounded-2xl border border-brand-200 bg-white p-5">
            <span class="text-xs font-medium uppercase tracking-wider text-neutral-400">Inbox</span>
            <strong class="mt-2 block text-2xl font-black text-brand-900">@ViewBag.PendingInquiries</strong>
            <span class="mt-1 block text-xs text-neutral-500">unanswered inquiries &amp; projects</span>
        </div>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-3">
        @* ---------- Top products ---------- *@
        <div class="rounded-2xl border border-brand-200 bg-white p-6">
            <h2 class="text-base font-semibold text-brand-900">Top products</h2>
            @if (topProducts.Any())
            {
                <ul class="mt-4 space-y-3">
                    @foreach (dynamic tp in topProducts)
                    {
                        <li class="flex items-center justify-between gap-3 text-sm">
                            <span class="truncate text-neutral-700">@tp.Name</span>
                            <span class="shrink-0 font-semibold text-brand-900">@tp.Qty sold</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="mt-3 text-sm text-neutral-400">No sales yet.</p>
            }
            <div class="mt-6 flex flex-wrap gap-2 border-t border-brand-100 pt-4">
                <a href="/Admin/Blogs" class="rounded-lg bg-brand-700 px-3 py-1.5 text-xs font-semibold text-white">@ViewBag.Blogs.Count posts</a>
                <a href="/Admin/Quotes" class="rounded-lg border border-brand-200 px-3 py-1.5 text-xs font-semibold text-neutral-700">@ViewBag.Quotes.Count quotes</a>
                <span class="rounded-lg border border-brand-200 px-3 py-1.5 text-xs font-semibold text-neutral-700">@ViewBag.Subscribers.Count subscribers</span>
            </div>
        </div>

        @* ---------- Recent orders ---------- *@
        <div class="rounded-2xl border border-brand-200 bg-white p-6 lg:col-span-2">
            <div class="flex items-center justify-between">
                <h2 class="text-base font-semibold text-brand-900">Recent orders</h2>
                <a href="/Admin/Orders" class="text-sm font-medium text-neutral-500 hover:text-brand-900">View all →</a>
            </div>
            @if (orders.Take(5).Any())
            {
                <ul class="mt-4 divide-y divide-brand-100">
                    @foreach (var o in orders.Take(5))
                    {
                        <li class="flex flex-col gap-2 py-3 sm:flex-row sm:items-center sm:justify-between">
                            <div>
                                <strong class="text-sm text-brand-900">@o.OrderNumber</strong>
                                <span class="ml-2 text-xs text-neutral-500">@o.CustomerName · @o.CreatedAt.ToString("MMM d, yyyy")</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="@(o.Status == "Processing" ? "bg-amber-100 text-amber-700" : o.Status == "Delivered" ? "bg-emerald-100 text-emerald-700" : "bg-brand-100 text-neutral-600") rounded-full px-2.5 py-0.5 text-xs font-medium">@o.Status</span>
                                <strong class="text-sm text-brand-900">@o.Total.ToString("N0")</strong>
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="mt-4 text-sm text-neutral-400">No orders yet.</p>
            }
        </div>
    </div>

    @* ---------- Recent inquiries ---------- *@
    <div class="mt-6 rounded-2xl border border-brand-200 bg-white p-6">
        <div class="flex items-center justify-between">
            <h2 class="text-base font-semibold text-brand-900">Recent contact &amp; project inquiries</h2>
            <a href="/Admin/Inquiries" class="text-sm font-medium text-neutral-500 hover:text-brand-900">Manage inbox →</a>
        </div>
        @if (inquiries.Take(6).Any())
        {
            <ul class="mt-4 divide-y divide-brand-100">
                @foreach (var i in inquiries.Take(6))
                {
                    <li class="flex flex-col gap-2 py-3 sm:flex-row sm:items-center sm:justify-between">
                        <div class="min-w-0">
                            <strong class="text-sm text-brand-900">@i.Name</strong>
                            <span class="ml-2 text-xs text-neutral-500">@i.Type · @i.Email</span>
                            <p class="mt-1 line-clamp-1 text-xs text-neutral-400">@i.Message</p>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="@(i.Status == "Done" ? "bg-emerald-100 text-emerald-700" : "bg-amber-100 text-amber-700") rounded-full px-2.5 py-0.5 text-xs font-medium">@i.Status</span>
                            <span class="text-xs text-neutral-400">@i.CreatedAt.ToString("MMM d")</span>
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="mt-4 text-sm text-neutral-400">No inquiries yet.</p>
        }
    </div>
</section>