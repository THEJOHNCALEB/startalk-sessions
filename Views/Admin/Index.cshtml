@using StarTalkSessions.Models
@{
    ViewData["Title"] = "Admin — Overview";
    var orders = (List<StarTalkSessions.Models.Order>)ViewBag.Orders ?? new();
    var inquiries = (List<StarTalkSessions.Models.Inquiry>)ViewBag.Inquiries ?? new();
    var users = (List<StarTalkSessions.Models.UserModel>)ViewBag.Users ?? new();
    var topProducts = ViewBag.TopProducts as List<dynamic> ?? new();
    var streams = (List<LiveStream>)ViewBag.LiveStreams ?? new();
    var now = DateTime.Now;
    var liveNow = streams.FirstOrDefault(x => x.IsLiveAt(now));
    var nextStream = liveNow ?? streams.FirstOrDefault(x => x.IsUpcomingAt(now));
}

@await Html.PartialAsync("_AdminNav")

<section class="mx-auto max-w-app px-4 py-8 sm:px-6">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">Analytics</span>
            <h1 class="mt-1 text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">Studio overview</h1>
            <p class="mt-1 text-sm text-neutral-500">Everything happening across the platform at a glance.</p>
        </div>
    </div>

    <div class="mt-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
        <div class="rounded-2xl border border-brand-200 bg-white p-5">
            <span class="text-xs font-medium uppercase tracking-wider text-neutral-400">Revenue</span>
            <strong class="mt-2 block text-2xl font-black text-brand-900">@ViewBag.Revenue.ToString("N0")</strong>
            <span class="mt-1 block text-xs text-neutral-500">₦ equivalent shown · @ViewBag.MonthOrders orders this month</span>
        </div>
        <div class="rounded-2xl border border-brand-200 bg-white p-5">
            <span class="text-xs font-medium uppercase tracking-wider text-neutral-400">Orders</span>
            <strong class="mt-2 block text-2xl font-black text-brand-900">@ViewBag.OrderCount</strong>
            <span class="mt-1 block text-xs text-neutral-500">@ViewBag.NewOrders awaiting fulfilment</span>
        </div>
        <div class="rounded-2xl border border-brand-200 bg-white p-5">
            <span class="text-xs font-medium uppercase tracking-wider text-neutral-400">Customers</span>
            <strong class="mt-2 block text-2xl font-black text-brand-900">@users.Count</strong>
            <span class="mt-1 block text-xs text-neutral-500">@ViewBag.NewUsers30 new in the last 30 days</span>
        </div>
        <div class="rounded-2xl border border-brand-200 bg-white p-5">
            <span class="text-xs font-medium uppercase tracking-wider text-neutral-400">Inbox</span>
            <strong class="mt-2 block text-2xl font-black text-brand-900">@ViewBag.PendingInquiries</strong>
            <span class="mt-1 block text-xs text-neutral-500">unanswered inquiries &amp; projects</span>
        </div>
    </div>

    <div class="mt-6 rounded-2xl border border-brand-200 bg-white p-6">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">Broadcast</span>
                <h2 class="mt-1 text-lg font-bold text-brand-900">Live stream</h2>
                @if (nextStream == null)
                {
                    <p class="mt-2 text-sm text-neutral-500">No broadcast scheduled. Use Go Live to add a YouTube or TikTok stream.</p>
                }
                else
                {
                    <p class="mt-2 text-sm text-neutral-700">
                        <strong>@nextStream.Title</strong> · @nextStream.ScheduledAt.ToString("MMM d, yyyy · h:mm tt")
                        @if (liveNow != null)
                        {
                            <span class="ml-2 rounded-full bg-red-100 px-2 py-0.5 text-xs font-bold text-red-600">LIVE NOW</span>
                        }
                        else
                        {
                            <span class="ml-2 rounded-full bg-brand-100 px-2 py-0.5 text-xs font-bold text-neutral-600">UPCOMING</span>
                        }
                    </p>
                    <p class="mt-1 text-xs text-neutral-500">@(nextStream.HasYouTube ? "YouTube" : "")@(nextStream.HasYouTube && nextStream.HasTikTok ? " + " : "")@(nextStream.HasTikTok ? "TikTok" : "") · shown on the landing page</p>
                }
            </div>
            <a href="/Admin/LiveStreams" class="rounded-lg border border-brand-200 px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:border-brand-600">Manage broadcasts</a>
        </div>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-3">
        @* ---------- Top products ---------- *@
        <div class="rounded-2xl border border-brand-200 bg-white p-6">
            <h2 class="text-base font-semibold text-brand-900">Top products</h2>
            @if (topProducts.Any())
            {
                <ul class="mt-4 space-y-3">
                    @foreach (dynamic tp in topProducts)
                    {
                        <li class="flex items-center justify-between gap-3 text-sm">
                            <span class="truncate text-neutral-700">@tp.Name</span>
                            <span class="shrink-0 font-semibold text-brand-900">@tp.Qty sold</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="mt-3 text-sm text-neutral-400">No sales yet.</p>
            }
            <div class="mt-6 flex flex-wrap gap-2 border-t border-brand-100 pt-4">
                <a href="/Admin/Blogs" class="rounded-lg bg-brand-700 px-3 py-1.5 text-xs font-semibold text-white">@ViewBag.Blogs.Count posts</a>
                <a href="/Admin/Quotes" class="rounded-lg border border-brand-200 px-3 py-1.5 text-xs font-semibold text-neutral-700">@ViewBag.Quotes.Count quotes</a>
                <span class="rounded-lg border border-brand-200 px-3 py-1.5 text-xs font-semibold text-neutral-700">@ViewBag.Subscribers.Count subscribers</span>
            </div>
        </div>

        @* ---------- Recent orders ---------- *@
        <div class="rounded-2xl border border-brand-200 bg-white p-6 lg:col-span-2">
            <div class="flex items-center justify-between">
                <h2 class="text-base font-semibold text-brand-900">Recent orders</h2>
                <a href="/Admin/Orders" class="text-sm font-medium text-neutral-500 hover:text-brand-900">View all →</a>
            </div>
            @if (orders.Take(5).Any())
            {
                <ul class="mt-4 divide-y divide-brand-100">
                    @foreach (var o in orders.Take(5))
                    {
                        <li class="flex flex-col gap-2 py-3 sm:flex-row sm:items-center sm:justify-between">
                            <div>
                                <strong class="text-sm text-brand-900">@o.OrderNumber</strong>
                                <span class="ml-2 text-xs text-neutral-500">@o.CustomerName · @o.CreatedAt.ToString("MMM d, yyyy")</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="@(o.Status == "Processing" ? "bg-amber-100 text-amber-700" : o.Status == "Delivered" ? "bg-emerald-100 text-emerald-700" : "bg-brand-100 text-neutral-600") rounded-full px-2.5 py-0.5 text-xs font-medium">@o.Status</span>
                                <strong class="text-sm text-brand-900">@o.Total.ToString("N0")</strong>
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="mt-4 text-sm text-neutral-400">No orders yet.</p>
            }
        </div>
    </div>

    @* ---------- Recent inquiries ---------- *@
    <div class="mt-6 rounded-2xl border border-brand-200 bg-white p-6">
        <div class="flex items-center justify-between">
            <h2 class="text-base font-semibold text-brand-900">Recent contact &amp; project inquiries</h2>
            <a href="/Admin/Inquiries" class="text-sm font-medium text-neutral-500 hover:text-brand-900">Manage inbox →</a>
        </div>
        @if (inquiries.Take(6).Any())
        {
            <ul class="mt-4 divide-y divide-brand-100">
                @foreach (var i in inquiries.Take(6))
                {
                    <li class="flex flex-col gap-2 py-3 sm:flex-row sm:items-center sm:justify-between">
                        <div class="min-w-0">
                            <strong class="text-sm text-brand-900">@i.Name</strong>
                            <span class="ml-2 text-xs text-neutral-500">@i.Type · @i.Email</span>
                            <p class="mt-1 line-clamp-1 text-xs text-neutral-400">@i.Message</p>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="@(i.Status == "Done" ? "bg-emerald-100 text-emerald-700" : "bg-amber-100 text-amber-700") rounded-full px-2.5 py-0.5 text-xs font-medium">@i.Status</span>
                            <span class="text-xs text-neutral-400">@i.CreatedAt.ToString("MMM d")</span>
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="mt-4 text-sm text-neutral-400">No inquiries yet.</p>
        }
    </div>
</section>

<button type="button" class="ed-admin-fab" data-go-live>
    <span class="ed-admin-fab__dot"></span>
    Go Live
</button>

<div class="overlay fixed inset-0 z-[90] items-center justify-center bg-black/60 p-4" data-overlay="golive" aria-hidden="true">
    <div class="max-h-[90vh] w-full max-w-xl overflow-y-auto border border-black bg-white p-6" role="dialog" aria-modal="true" aria-labelledby="golive-title">
        <h2 class="text-xl font-bold tracking-tight text-brand-900" id="golive-title">Go Live</h2>
        <p class="mt-1 text-sm text-neutral-500">Add a YouTube link, a TikTok link, or both. The active broadcast (or the next upcoming one) appears on the landing page.</p>
        <form method="post" action="/Admin/LiveStreamSave" class="mt-5 space-y-4" data-loading>
            <input type="hidden" name="returnUrl" value="/Admin" />
            <div>
                <label for="glTitle" class="mb-1 block text-xs font-semibold text-neutral-500">Broadcast title</label>
                <input id="glTitle" name="title" required placeholder="StarTalk Live — The room is open" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm" />
            </div>
            <div>
                <label for="glDescription" class="mb-1 block text-xs font-semibold text-neutral-500">Description</label>
                <textarea id="glDescription" name="description" rows="2" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm"></textarea>
            </div>
            <div>
                <label for="glPlatform" class="mb-1 block text-xs font-semibold text-neutral-500">Platform</label>
                <select id="glPlatform" name="platform" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm">
                    <option value="youtube">YouTube</option>
                    <option value="tiktok">TikTok</option>
                    <option value="both">YouTube + TikTok</option>
                </select>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                    <label for="glYouTube" class="mb-1 block text-xs font-semibold text-neutral-500">YouTube watch link</label>
                    <input id="glYouTube" name="youtubeUrl" type="url" placeholder="https://youtube.com/watch?v=…" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm" />
                </div>
                <div>
                    <label for="glTikTok" class="mb-1 block text-xs font-semibold text-neutral-500">TikTok live link</label>
                    <input id="glTikTok" name="tiktokUrl" type="url" placeholder="https://www.tiktok.com/@@/live" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm" />
                </div>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                    <label for="glWhen" class="mb-1 block text-xs font-semibold text-neutral-500">Broadcast date &amp; time</label>
                    <input id="glWhen" name="scheduledAt" type="datetime-local" required value="@DateTime.Now.AddHours(1).ToString("yyyy-MM-ddTHH:mm")" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm" />
                </div>
                <div>
                    <label for="glDuration" class="mb-1 block text-xs font-semibold text-neutral-500">Duration (minutes)</label>
                    <input id="glDuration" name="durationMinutes" type="number" min="15" max="1440" value="60" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm" />
                </div>
            </div>
            <label class="flex items-center gap-2 text-sm text-neutral-600">
                <input type="checkbox" name="isActive" value="true" checked /> Show on landing page
            </label>
            <div class="flex items-center justify-end gap-2 border-t border-brand-100 pt-4">
                <button type="button" class="ed-btn ed-btn--outline" data-close-overlay="golive">Cancel</button>
                <button type="submit" class="ed-btn" data-loading-label="Scheduling…">Schedule broadcast</button>
            </div>
        </form>
    </div>
</div>

<script>
    (function () {
        var fab = document.querySelector('[data-go-live]');
        if (fab) fab.addEventListener('click', function () { window.openOverlay('golive'); });
    })();
</script>
