@using StarTalkSessions.Models
@{
    ViewData["Title"] = "Admin — Live streams";
    var streams = (List<LiveStream>)ViewBag.LiveStreams ?? new();
    var editing = ViewBag.Editing as LiveStream;
    var now = DateTime.Now;
}

@await Html.PartialAsync("_AdminNav")

<section class="mx-auto max-w-app px-4 py-8 sm:px-6">
    <div>
        <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">Broadcast</span>
        <h1 class="mt-1 text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">Live streams</h1>
        <p class="mt-1 text-sm text-neutral-500">Schedule YouTube and TikTok broadcasts. The live one, or the next upcoming one, is shown on the landing page.</p>
    </div>

    @if (TempData["AdminSuccess"] != null)
    {
        <div class="mt-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">@TempData["AdminSuccess"]</div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="mt-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-600">@TempData["AdminError"]</div>
    }

    <form method="post" action="/Admin/LiveStreamSave" class="mt-6 grid grid-cols-1 gap-4 rounded-2xl border border-brand-200 bg-white p-6 sm:grid-cols-2 lg:grid-cols-3" data-loading>
        @if (editing != null)
        {
            <input type="hidden" name="id" value="@editing.Id" />
        }
        <div class="sm:col-span-2">
            <label for="lsTitle" class="mb-1 block text-xs font-semibold text-neutral-500">Title</label>
            <input id="lsTitle" name="title" required value="@editing?.Title" placeholder="StarTalk Live" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm" />
        </div>
        <div>
            <label for="lsPlatform" class="mb-1 block text-xs font-semibold text-neutral-500">Platform</label>
            <select id="lsPlatform" name="platform" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm">
                <option value="youtube" selected="@(editing?.Platform == "youtube")">YouTube</option>
                <option value="tiktok" selected="@(editing?.Platform == "tiktok")">TikTok</option>
                <option value="both" selected="@(editing?.Platform == "both")">YouTube + TikTok</option>
            </select>
        </div>
        <div>
            <label for="lsYouTube" class="mb-1 block text-xs font-semibold text-neutral-500">YouTube watch link</label>
            <input id="lsYouTube" name="youtubeUrl" type="url" value="@editing?.YouTubeUrl" placeholder="https://youtube.com/watch?v=…" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm" />
        </div>
        <div>
            <label for="lsTikTok" class="mb-1 block text-xs font-semibold text-neutral-500">TikTok live link</label>
            <input id="lsTikTok" name="tiktokUrl" type="url" value="@editing?.TikTokUrl" placeholder="https://www.tiktok.com/@@/live" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm" />
        </div>
        <div>
            <label for="lsWhen" class="mb-1 block text-xs font-semibold text-neutral-500">Date &amp; time</label>
            <input id="lsWhen" name="scheduledAt" type="datetime-local" required value="@((editing?.ScheduledAt ?? DateTime.Now.AddHours(1)).ToString("yyyy-MM-ddTHH:mm"))" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm" />
        </div>
        <div>
            <label for="lsDuration" class="mb-1 block text-xs font-semibold text-neutral-500">Duration (minutes)</label>
            <input id="lsDuration" name="durationMinutes" type="number" min="15" max="1440" value="@(editing?.DurationMinutes ?? 60)" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm" />
        </div>
        <div class="sm:col-span-2 lg:col-span-3">
            <label for="lsDescription" class="mb-1 block text-xs font-semibold text-neutral-500">Description</label>
            <textarea id="lsDescription" name="description" rows="2" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm">@editing?.Description</textarea>
        </div>
        <div class="flex items-center gap-4 sm:col-span-2 lg:col-span-3">
            <label class="flex items-center gap-2 text-sm text-neutral-600">
                <input type="checkbox" name="isActive" value="true" checked="@(editing == null || editing.IsActive)" /> Show on landing page
            </label>
            <div class="ml-auto flex items-center gap-3">
                @if (editing != null)
                {
                    <a href="/Admin/LiveStreams" class="text-sm text-neutral-500 hover:text-brand-900">Cancel</a>
                }
                <button type="submit" class="rounded-lg bg-brand-700 px-5 py-2 text-sm font-semibold text-white" data-loading-label="Saving…">@(editing == null ? "Schedule broadcast" : "Save changes")</button>
            </div>
        </div>
    </form>

    <div class="mt-8 overflow-hidden rounded-2xl border border-brand-200 bg-white">
        <div class="border-b border-brand-100 px-6 py-3 text-xs font-bold uppercase tracking-widest text-neutral-500">Scheduled broadcasts</div>
        @if (streams.Count == 0)
        {
            <p class="px-6 py-10 text-center text-sm text-neutral-400">No broadcasts scheduled yet.</p>
        }
        else
        {
            <ul class="divide-y divide-brand-100">
                @foreach (var stream in streams)
                {
                    <li class="flex flex-col gap-3 px-6 py-4 sm:flex-row sm:items-center sm:justify-between">
                        <div class="min-w-0">
                            <div class="flex flex-wrap items-center gap-2">
                                <strong class="truncate text-sm text-brand-900">@stream.Title</strong>
                                @if (stream.IsLiveAt(now))
                                {
                                    <span class="rounded-full bg-red-100 px-2 py-0.5 text-[10px] font-bold uppercase text-red-600">Live now</span>
                                }
                                else if (stream.IsUpcomingAt(now))
                                {
                                    <span class="rounded-full bg-brand-100 px-2 py-0.5 text-[10px] font-bold uppercase text-neutral-600">Upcoming</span>
                                }
                                else
                                {
                                    <span class="rounded-full bg-neutral-100 px-2 py-0.5 text-[10px] font-bold uppercase text-neutral-500">Ended</span>
                                }
                                @if (!stream.IsActive)
                                {
                                    <span class="rounded-full bg-red-100 px-2 py-0.5 text-[10px] font-bold uppercase text-red-500">Hidden</span>
                                }
                            </div>
                            <p class="mt-1 truncate text-xs text-neutral-500">@stream.ScheduledAt.ToString("MMM d, yyyy · h:mm tt") · @stream.Platform@(stream.HasYouTube ? " · YouTube" : "")@(stream.HasTikTok ? " · TikTok" : "")</p>
                        </div>
                        <div class="flex shrink-0 flex-wrap gap-2">
                            <a href="/Admin/LiveStreams?edit=@stream.Id" class="rounded-lg border border-brand-200 px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:border-brand-600">Edit</a>
                            <form method="post" action="/Admin/LiveStreamToggle" data-loading>
                                <input type="hidden" name="id" value="@stream.Id" />
                                <button type="submit" class="rounded-lg border border-brand-200 px-3 py-1.5 text-xs font-semibold text-neutral-700 hover:border-brand-600" data-loading-label="Saving…">@(stream.IsActive ? "Hide" : "Show")</button>
                            </form>
                            <form method="post" action="/Admin/LiveStreamDelete" data-confirm="Delete this broadcast permanently?" data-loading>
                                <input type="hidden" name="id" value="@stream.Id" />
                                <button type="submit" class="rounded-lg border border-red-200 px-3 py-1.5 text-xs font-semibold text-red-600 hover:bg-red-50" data-loading-label="Deleting…">Delete</button>
                            </form>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</section>
