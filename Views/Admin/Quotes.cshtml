@{
    ViewData["Title"] = "Admin — Quotes";
    var quotes = (List<StarTalkSessions.Models.CustomQuote>)ViewBag.Quotes ?? new();
    var statuses = new[] { "Submitted", "In Review", "Quoted", "Approved", "In Production", "Closed" };
}

@await Html.PartialAsync("_AdminNav")

<section class="mx-auto max-w-app px-4 py-8 sm:px-6">
    <div class="flex items-end justify-between gap-4">
        <div>
            <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">Bespoke</span>
            <h1 class="mt-1 text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">Custom quotes</h1>
            <p class="mt-1 text-sm text-neutral-500">@quotes.Count requests · @quotes.Count(q => q.Status == "Submitted") awaiting review</p>
        </div>
    </div>

    @if (TempData["AdminSuccess"] != null)
    {
        <div class="mt-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">@TempData["AdminSuccess"]</div>
    }

    <ul class="mt-8 space-y-4">
        @foreach (var q in quotes)
        {
            <li class="rounded-2xl border border-brand-200 bg-white p-6">
                <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
                    <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-2">
                            <h3 class="text-base font-semibold text-brand-900">@q.RefNumber</h3>
                            <span class="rounded-full bg-brand-100 px-2.5 py-0.5 text-xs font-medium text-neutral-600">@q.Status</span>
                        </div>
                        <p class="mt-1 text-sm text-neutral-500">@q.Name · @q.Email@(!string.IsNullOrWhiteSpace(q.Phone) ? $" · {q.Phone}" : "")</p>
                        <p class="mt-1 text-sm text-neutral-700">@q.Category @(!string.IsNullOrWhiteSpace(q.Style) ? $"· {q.Style}" : "") · Budget @(q.Budget ?? "To advise") · @q.CreatedAt.ToString("MMM d, yyyy")</p>
                        @if (!string.IsNullOrWhiteSpace(q.Wood) || !string.IsNullOrWhiteSpace(q.Fabric))
                        {
                            <p class="mt-1 text-xs text-neutral-400">@q.Wood @(string.IsNullOrWhiteSpace(q.Wood) ? "" : "·") @q.Fabric @(string.IsNullOrWhiteSpace(q.Fabric) ? "" : "·") @q.Hardware</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(q.Notes))
                        {
                            <p class="mt-2 text-sm leading-relaxed text-neutral-600">“@q.Notes”</p>
                        }
                        @if (q.ReferenceFiles.Any())
                        {
                            <p class="mt-1 text-xs text-neutral-400">📎 @string.Join(", ", q.ReferenceFiles)</p>
                        }
                    </div>
                    <div class="flex shrink-0 flex-col gap-2">
                        <form method="post" action="/Admin/QuoteStatus" class="flex items-center gap-2">
                            <input type="hidden" name="id" value="@q.Id" />
                            <select name="status" class="rounded-lg border border-neutral-300 px-2 py-1.5 text-xs outline-none focus:border-brand-600">
                                @foreach (var s in statuses)
                                {
                                    <option value="@s" selected="@(q.Status == s ? "selected" : null)">@s</option>
                                }
                            </select>
                            <button type="submit" class="rounded-lg border border-brand-200 px-3 py-1.5 text-xs font-semibold text-neutral-700 transition hover:border-brand-600">Update</button>
                        </form>
                        <form method="post" action="/Admin/QuoteDelete" onsubmit="return confirm('Delete this quote?')" class="text-right">
                            <input type="hidden" name="id" value="@q.Id" />
                            <button type="submit" class="rounded-lg border border-red-200 px-3 py-1.5 text-xs font-semibold text-red-600 transition hover:bg-red-50">Delete</button>
                        </form>
                    </div>
                </div>
            </li>
        }
        @if (!quotes.Any())
        {
            <li class="rounded-2xl border border-brand-200 bg-white px-6 py-12 text-center text-sm text-neutral-400">No quote requests yet.</li>
        }
    </ul>
</section>