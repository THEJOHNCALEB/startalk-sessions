@{
    ViewData["Title"] = "Admin — Media";
    var media = (List<StarTalkSessions.Utils.MediaItem>)ViewBag.Media ?? new();
    Func<long, string> fmt = b => b >= 1024 * 1024 ? $"{b / (1024.0 * 1024.0):0.0} MB" : b >= 1024 ? $"{b / 1024.0:0.0} KB" : $"{b} B";
}

@await Html.PartialAsync("_AdminNav")

<section class="mx-auto max-w-app px-4 py-8 sm:px-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">Library</span>
            <h1 class="mt-1 text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">Media</h1>
            <p class="mt-1 text-sm text-neutral-500">Images up to 50MB · videos up to 600MB · hosted locally, served from /media/</p>
        </div>
    </div>

    @if (TempData["AdminSuccess"] != null)
    {
        <div class="mt-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">@TempData["AdminSuccess"]</div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="mt-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-600">@TempData["AdminError"]</div>
    }

    <div class="mt-6 rounded-2xl border border-brand-200 bg-white p-6">
        <label for="mediaPicker" class="mb-2 block text-sm font-semibold text-brand-900">Upload image or video</label>
        <div class="flex flex-col gap-3 sm:flex-row">
            <input type="file" id="mediaPicker" accept=".jpg,.jpeg,.png,.webp,.gif,.avif,.bmp,.mp4,.webm,.mov,.m4v"
                   class="flex-1 rounded-lg border border-brand-200 bg-brand-50/50 px-3 py-2 text-sm text-neutral-700 file:mr-3 file:rounded-lg file:border-0 file:bg-brand-700 file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-white" />
            <button type="button" data-upload-media class="rounded-lg bg-brand-700 px-5 py-2 text-sm font-semibold text-white transition hover:bg-brand-500 disabled:cursor-not-allowed disabled:opacity-50">Upload</button>
        </div>
        <p class="mt-2 hidden text-xs text-red-600" data-upload-error></p>
    </div>

    <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        @foreach (var m in media)
        {
            <div class="overflow-hidden rounded-2xl border border-brand-200 bg-white">
                <div class="flex aspect-video items-center justify-center overflow-hidden bg-brand-50">
                    @if (m.IsVideo)
                    {
                        <video src="@m.Url" class="h-full w-full object-cover" muted playsinline preload="metadata"></video>
                    }
                    else
                    {
                        <img src="@m.Url" alt="@m.Name" loading="lazy" class="h-full w-full object-cover" />
                    }
                </div>
                <div class="space-y-2 p-3">
                    <div class="flex items-center justify-between gap-2">
                        <p class="truncate text-xs font-medium text-brand-900" title="@m.Url">@m.Name</p>
                        <span class="shrink-0 text-[10px] text-neutral-400">@fmt(m.Size)@(m.IsVideo ? " · video" : "")</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <button type="button" data-copy-url="@m.Url" class="flex-1 rounded-lg border border-brand-200 px-2 py-1 text-xs font-semibold text-neutral-700 transition hover:border-brand-600">Copy URL</button>
                        <button type="button" data-delete-media="@m.Url" class="rounded-lg border border-red-200 px-2 py-1 text-xs font-semibold text-red-600 transition hover:bg-red-50">Delete</button>
                    </div>
                </div>
            </div>
        }
        @if (!media.Any())
        {
            <p class="col-span-full py-12 text-center text-sm text-neutral-400">No media yet. Upload an image or video to get started.</p>
        }
    </div>
</section>

@* ---------- Media: upload, copy URL, delete ---------- *@
@* Adhesion to site conventions: fetch-based, small footprint, no libraries. *@
<script>
(function () {
    var btn = document.querySelector('[data-upload-media]');
    var picker = document.getElementById('mediaPicker');
    var errEl = document.querySelector('[data-upload-error]');

    function upload(file) {
        if (!file) return;
        errEl.classList.add('hidden');
        btn.disabled = true;
        btn.textContent = 'Uploading…';
        var fd = new FormData();
        fd.append('file', file);
        fetch('/Admin/MediaUpload', { method: 'POST', body: fd })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (!d.ok) { errEl.textContent = d.message || 'Upload failed.'; errEl.classList.remove('hidden'); return; }
                location.reload();
            })
            .catch(function () {
                errEl.textContent = 'Upload failed. Check the file type and size, then retry.';
                errEl.classList.remove('hidden');
            })
            .finally(function () { btn.disabled = false; btn.textContent = 'Upload'; });
    }

    if (btn) btn.addEventListener('click', function () { upload(picker.files && picker.files[0]); });
    if (picker) picker.addEventListener('change', function () {
        if (picker.files && picker.files[0]) upload(picker.files[0]);
    });

    document.querySelectorAll('[data-copy-url]').forEach(function (b) {
        b.addEventListener('click', function () {
            var url = b.getAttribute('data-copy-url');
            if (!url) return;
            (navigator.clipboard ? navigator.clipboard.writeText(url) : Promise.reject())
                .then(function () { b.textContent = 'Copied'; setTimeout(function () { b.textContent = 'Copy URL'; }, 1500); })
                .catch(function () {
                    var ta = document.createElement('textarea');
                    ta.value = url; document.body.appendChild(ta); ta.select();
                    try { document.execCommand('copy'); b.textContent = 'Copied'; }
                    catch (e) { b.textContent = 'Select manually: ' + url; }
                    setTimeout(function () { document.body.removeChild(ta); b.textContent = 'Copy URL'; }, 1500);
                });
        });
    });

    document.querySelectorAll('[data-delete-media]').forEach(function (b) {
        b.addEventListener('click', function () {
            var url = b.getAttribute('data-delete-media');
            if (!url) return;
            window.showConfirm('Delete this media file permanently?', function () {
                withButtonLoading(b, function () {
                    return fetch('/Admin/MediaDelete', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ url: url })
                    })
                        .then(function (r) { return r.json(); })
                        .then(function (d) { if (d.ok) location.reload(); })
                        .catch(function () {});
                });
            });
        });
    });
})();
</script>