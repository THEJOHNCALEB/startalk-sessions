@{
    ViewData["Title"] = "Admin — Banner Ads";
    var ads = (List<StarTalkSessions.Models.BannerAd>)ViewBag.Ads ?? new();
    var placements = new[] { "header", "sidebar", "inline", "footer", "detail" };
}

@await Html.PartialAsync("_AdminNav")

<section class="mx-auto max-w-app px-4 py-8 sm:px-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">Monetize</span>
            <h1 class="mt-1 text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">Banner Ads</h1>
            <p class="mt-1 text-sm text-neutral-500">Custom ads take priority per zone; when empty, AdSense fills the slot. Purely decorative zones render nothing when both are absent.</p>
        </div>
    </div>

    @if (TempData["AdminSuccess"] != null)
    {
        <div class="mt-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">@TempData["AdminSuccess"]</div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="mt-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-600">@TempData["AdminError"]</div>
    }

    <form method="post" action="/Admin/AdCreate" enctype="multipart/form-data" class="mt-6 rounded-2xl border border-brand-200 bg-white p-6" data-loading>
        <h2 class="text-sm font-semibold text-brand-900">New banner</h2>
        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
                <label for="adTitle" class="mb-1 block text-xs font-semibold text-neutral-500">Title</label>
                <input type="text" id="adTitle" name="title" required
                       class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm text-brand-900" placeholder="Spring sale" />
            </div>
            <div>
                <label for="adTarget" class="mb-1 block text-xs font-semibold text-neutral-500">Target URL</label>
                <input type="url" id="adTarget" name="targetUrl" required
                       class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm text-brand-900" placeholder="https://example.com/collection" />
            </div>
            <div>
                <label for="adPlacement" class="mb-1 block text-xs font-semibold text-neutral-500">Placement</label>
                <select id="adPlacement" name="placement" class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm text-brand-900">
                    @foreach (var p in placements)
                    {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>
            <div>
                <label for="adMedia" class="mb-1 block text-xs font-semibold text-neutral-500">Image or video</label>
                <input type="file" id="adMedia" name="image" required accept=".jpg,.jpeg,.png,.webp,.gif,.avif,.bmp,.mp4,.webm"
                       class="w-full rounded-lg border border-brand-200 px-3 py-2 text-sm text-neutral-700 file:mr-3 file:rounded-lg file:border-0 file:bg-brand-700 file:px-3 file:py-1 file:text-xs file:font-semibold file:text-white" />
            </div>
        </div>
        <div class="mt-4">
            <button type="submit" class="rounded-lg bg-brand-700 px-5 py-2 text-sm font-semibold text-white transition hover:bg-brand-500">Create banner</button>
        </div>
    </form>

    <div class="mt-8 overflow-hidden rounded-2xl border border-brand-200 bg-white">
        <ul class="divide-y divide-brand-100">
            @foreach (var ad in ads)
            {
                <li class="flex flex-col gap-3 px-6 py-4 sm:flex-row sm:items-center sm:justify-between">
                    <div class="flex min-w-0 items-center gap-4">
                        <div class="flex h-16 w-24 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-brand-50">
                            @if ((ad.ImageUrl ?? "").EndsWith(".mp4", StringComparison.OrdinalIgnoreCase)
                                || (ad.ImageUrl ?? "").EndsWith(".webm", StringComparison.OrdinalIgnoreCase))
                            {
                                <video src="@ad.ImageUrl" class="h-full w-full object-cover" muted playsinline loop preload="metadata"></video>
                            }
                            else
                            {
                                <img src="@ad.ImageUrl" alt="@ad.Title" loading="lazy" class="h-full w-full object-cover" />
                            }
                        </div>
                        <div class="min-w-0">
                            <div class="flex flex-wrap items-center gap-2">
                                <strong class="truncate text-sm text-brand-900">@ad.Title</strong>
                                @if (ad.IsActive)
                                {
                                    <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-emerald-600">Active</span>
                                }
                                else
                                {
                                    <span class="rounded-full bg-red-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-red-500">Paused</span>
                                }
                            </div>
                            <p class="truncate text-xs text-neutral-500">@(ad.Placement ?? "inline") zone · @ad.Views views · @ad.Clicks clicks · added @ad.CreatedAt.ToString("MMM d, yyyy")</p>
                            <a href="@ad.TargetUrl" target="_blank" rel="noopener" class="truncate text-xs text-brand-600 hover:underline">@ad.TargetUrl</a>
                        </div>
                    </div>
                    <div class="flex shrink-0 flex-wrap items-center gap-2">
                        <form method="post" action="/Admin/AdToggle" data-loading>
                            <input type="hidden" name="id" value="@ad.Id" />
                            <button type="submit" class="rounded-lg border border-brand-200 px-3 py-1.5 text-xs font-semibold text-neutral-700 transition hover:border-brand-600">@(ad.IsActive ? "Pause" : "Activate")</button>
                        </form>
                        <form method="post" action="/Admin/AdDelete" data-confirm="Delete this banner permanently?" data-loading>
                            <input type="hidden" name="id" value="@ad.Id" />
                            <button type="submit" class="rounded-lg border border-red-200 px-3 py-1.5 text-xs font-semibold text-red-600 transition hover:bg-red-50">Delete</button>
                        </form>
                    </div>
                </li>
            }
        </ul>
        @if (!ads.Any())
        {
            <div class="px-6 py-12 text-center text-sm text-neutral-400">No banner ads yet. Create one above.</div>
        }
    </div>
</section>