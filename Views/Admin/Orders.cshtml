@{
    ViewData["Title"] = "Admin — Orders";
    var orders = (List<StarTalkSessions.Models.Order>)ViewBag.Orders ?? new();
    var statuses = new[] { "Processing", "In Transit", "Out for Delivery", "Delivered", "Cancelled" };
}

@await Html.PartialAsync("_AdminNav")

<section class="mx-auto max-w-app px-4 py-8 sm:px-6">
    <div class="flex items-end justify-between gap-4">
        <div>
            <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">Commerce</span>
            <h1 class="mt-1 text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">Orders</h1>
            <p class="mt-1 text-sm text-neutral-500">@orders.Count orders · @orders.Sum(o => o.Total).ToString("N0") in sales</p>
        </div>
    </div>

    @if (TempData["AdminSuccess"] != null)
    {
        <div class="mt-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">@TempData["AdminSuccess"]</div>
    }

    <ul class="mt-8 space-y-4">
        @foreach (var o in orders)
        {
            <li class="rounded-2xl border border-brand-200 bg-white p-6">
                <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
                    <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-2">
                            <h3 class="text-base font-semibold text-brand-900">@o.OrderNumber</h3>
                            <span class="@(o.Status == "Delivered" ? "bg-emerald-100 text-emerald-700" : o.Status == "Cancelled" ? "bg-red-100 text-red-600" : "bg-amber-100 text-amber-700") rounded-full px-2.5 py-0.5 text-xs font-medium">@o.Status</span>
                        </div>
                        <p class="mt-1 text-sm text-neutral-500">@o.CustomerName · @o.CustomerEmail@(!string.IsNullOrWhiteSpace(o.Country) ? $" · {o.Country}" : "") · Placed @o.CreatedAt.ToString("MMM d, yyyy")</p>
                        @if (!string.IsNullOrWhiteSpace(o.ShippingAddress))
                        {
                            <p class="mt-1 text-xs text-neutral-400">Ship to: @o.ShippingAddress</p>
                        }
                        <p class="mt-1 text-xs text-neutral-400">Tracking: <strong class="text-neutral-600">@o.TrackingRef</strong></p>
                        <div class="mt-3 space-y-1">
                            @foreach (var item in o.Items.Take(3))
                            {
                                <p class="text-xs text-neutral-600">@item.ProductName × @item.Quantity</p>
                            }
                            @if (o.Items.Count > 3)
                            {
                                <p class="text-xs text-neutral-400">+@(o.Items.Count - 3) more</p>
                            }
                        </div>
                    </div>
                    <div class="flex shrink-0 flex-col gap-2">
                        <strong class="text-right text-lg text-brand-900">@o.Total.ToString("N0")</strong>
                        <form method="post" action="/Admin/OrderStatus" data-loading class="flex items-center gap-2">
                            <input type="hidden" name="id" value="@o.Id" />
                            <select name="status" class="rounded-lg border border-neutral-300 px-2 py-1.5 text-xs outline-none focus:border-brand-600">
                                @foreach (var s in statuses)
                                {
                                    <option value="@s" selected="@(o.Status == s ? "selected" : null)">@s</option>
                                }
                            </select>
                            <button type="submit" class="rounded-lg border border-brand-200 px-3 py-1.5 text-xs font-semibold text-neutral-700 transition hover:border-brand-600">Update</button>
                        </form>
                        <form method="post" action="/Admin/OrderDelete" data-confirm="Delete this order?" data-loading class="text-right">
                            <input type="hidden" name="id" value="@o.Id" />
                            <button type="submit" class="rounded-lg border border-red-200 px-3 py-1.5 text-xs font-semibold text-red-600 transition hover:bg-red-50">Delete</button>
                        </form>
                    </div>
                </div>
            </li>
        }
        @if (!orders.Any())
        {
            <li class="rounded-2xl border border-brand-200 bg-white px-6 py-12 text-center text-sm text-neutral-400">No orders yet.</li>
        }
    </ul>
</section>