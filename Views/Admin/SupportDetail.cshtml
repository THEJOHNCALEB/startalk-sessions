@{
    var ticket = (StarTalkSessions.Models.SupportTicket)ViewBag.Ticket;
    ViewData["Title"] = $"#{ticket.Id.ToString("N")[..8].ToUpperInvariant()} — Support";
    var resolved = ticket.Status == "Resolved";
    var adminName = User.Identity?.Name ?? "Studio";
}

@await Html.PartialAsync("_AdminNav")

<section class="mx-auto max-w-app px-4 py-8 sm:px-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <a href="/Admin/Support" class="text-xs text-neutral-400 hover:text-brand-900">← All conversations</a>
            <h1 class="mt-1 text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">@ticket.Subject</h1>
            <p class="mt-1 text-sm text-neutral-500">@ticket.Name · @ticket.Email · started @ticket.CreatedAt.ToString("MMM d, yyyy · h:mm tt")</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            @if (resolved)
            {
                <form method="post" action="/Admin/SupportReopen" data-loading>
                    <input type="hidden" name="id" value="@ticket.Id" />
                    <button type="submit" class="rounded-lg border border-brand-200 px-3 py-1.5 text-xs font-semibold text-neutral-700 transition hover:border-brand-600">Reopen</button>
                </form>
            }
            else
            {
                <form method="post" action="/Admin/SupportAiToggle" data-loading>
                    <input type="hidden" name="id" value="@ticket.Id" />
                    <button type="submit" class="rounded-lg border border-brand-200 px-3 py-1.5 text-xs font-semibold text-neutral-700 transition hover:border-brand-600">@(ticket.AiAssigned ? "Pause AI (take over)" : "Re-enable AI")</button>
                </form>
                <form method="post" action="/Admin/SupportResolve" data-loading>
                    <input type="hidden" name="id" value="@ticket.Id" />
                    <button type="submit" class="rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-emerald-500">Mark resolved</button>
                </form>
            }
            <form method="post" action="/Admin/SupportDelete" data-confirm="Delete this conversation permanently?" data-loading>
                <input type="hidden" name="id" value="@ticket.Id" />
                <button type="submit" class="rounded-lg border border-red-200 px-3 py-1.5 text-xs font-semibold text-red-600 transition hover:bg-red-50">Delete</button>
            </form>
        </div>
    </div>

    @if (TempData["AdminSuccess"] != null)
    {
        <div class="mt-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">@TempData["AdminSuccess"]</div>
    }

    <div class="mt-8 rounded-2xl border border-brand-200 bg-white">
        <div class="space-y-4 p-5 sm:p-6">
            @foreach (var m in ticket.Messages)
            {
                @if (m.Role == "user")
                {
                    <div class="flex justify-end">
                        <div class="max-w-[85%] rounded-2xl rounded-tr-sm bg-brand-700 px-4 py-3 text-sm text-white">
                            <p class="mb-1 text-[10px] font-bold uppercase tracking-wide text-brand-200">@m.Author (customer)</p>
                            <p class="whitespace-pre-wrap leading-relaxed">@m.Body</p>
                            <p class="mt-1 text-[10px] text-brand-200">@m.CreatedAt.ToString("h:mm tt")</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="flex justify-start">
                        <div class="max-w-[80%] rounded-2xl rounded-tl-sm border px-4 py-3 text-sm @(m.Role == "ai" ? "border-emerald-200 bg-emerald-50 text-brand-900" : "border-violet-200 bg-violet-50 text-brand-900")">
                            <p class="mb-1 text-[10px] font-bold uppercase tracking-wide @(m.Role == "ai" ? "text-emerald-600" : "text-violet-600")">@(m.Role == "ai" ? "AI Assistant" : m.Author) @(m.Role == "ai" ? "" : "(you)")</p>
                            <p class="whitespace-pre-wrap leading-relaxed">@m.Body</p>
                            <p class="mt-1 text-[10px] text-neutral-400">@m.CreatedAt.ToString("h:mm tt")</p>
                        </div>
                    </div>
                }
            }
        </div>

        @if (!resolved)
        {
            <form method="post" action="/Admin/SupportReply" class="border-t border-brand-100 p-5" data-loading>
                <input type="hidden" name="id" value="@ticket.Id" />
                <div class="flex items-end gap-3">
                    <textarea name="message" rows="3" required placeholder="Reply to @ticket.Name… (this emails them and pauses the AI)" class="w-full resize-none rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600"></textarea>
                    <button type="submit" class="shrink-0 rounded-lg bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-500">Send as @adminName</button>
                </div>
                <p class="mt-2 text-xs text-neutral-400">Sending a reply emails the customer and hands the thread over from the AI to you.</p>
            </form>
        }
    </div>
</section>