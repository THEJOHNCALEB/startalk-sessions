@{
    ViewData["Title"] = "Checkout";
}

<section class="mx-auto max-w-app px-4 py-8 sm:px-6 lg:py-12" data-checkout-page>
    <nav class="text-xs text-neutral-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-900">Home</a><span class="mx-1">/</span><span class="text-neutral-600">Checkout</span>
    </nav>

    <div class="mt-6">
        <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">Secure checkout</span>
        <h1 class="mt-1 text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">Complete your order</h1>
        <p class="mt-2 max-w-2xl text-neutral-500">Confirm your details and we'll arrange white-glove delivery. Taxes and shipping are calculated at delivery; current subtotal shown below.</p>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-[1.2fr_1fr]">

        <form class="checkout-form space-y-6" data-checkout-form novalidate>
            <div class="rounded-2xl border border-brand-200 bg-white p-6 sm:p-8">
                <h2 class="text-lg font-bold tracking-tight text-brand-900">Contact</h2>
                <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div>
                        <label for="co-name" class="mb-1.5 block text-sm font-medium text-neutral-700">Full name</label>
                        <input id="co-name" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" name="customerName" autocomplete="name" placeholder="Jordan Bender" required>
                    </div>
                    <div>
                        <label for="co-phone" class="mb-1.5 block text-sm font-medium text-neutral-700">Phone</label>
                        <input id="co-phone" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" name="customerPhone" autocomplete="tel" placeholder="+234 800 000 0000" required>
                    </div>
                </div>
                <div class="mt-4">
                    <label for="co-email" class="mb-1.5 block text-sm font-medium text-neutral-700">Email</label>
                    <input id="co-email" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" name="customerEmail" type="email" autocomplete="email" placeholder="you@example.com">
                </div>
            </div>

            <div class="rounded-2xl border border-brand-200 bg-white p-6 sm:p-8">
                <h2 class="text-lg font-bold tracking-tight text-brand-900">Delivery</h2>
                <div class="mt-4">
                    <label for="co-address" class="mb-1.5 block text-sm font-medium text-neutral-700">Shipping address</label>
                    <input id="co-address" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" name="shippingAddress" autocomplete="street-address" placeholder="12 Adeola Odeku Street, Victoria Island, Lagos" required>
                </div>
                <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div>
                        <label for="co-country" class="mb-1.5 block text-sm font-medium text-neutral-700">Country</label>
                        <input id="co-country" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" name="country" autocomplete="country-name" placeholder="Nigeria" required>
                    </div>
                    <div>
                        <label for="co-currency" class="mb-1.5 block text-sm font-medium text-neutral-700">Currency</label>
                        <select id="co-currency" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" name="currency"></select>
                    </div>
                </div>
            </div>

            <div class="flex items-start gap-3 rounded-2xl border border-brand-200 bg-white p-5">
                <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-3M9 17a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM18 17a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/></svg>
                <p class="text-sm text-neutral-600">Free white-glove delivery on all orders over <strong data-checkout-free-note>$150</strong><span data-checkout-delivery-note class="block text-xs text-neutral-400"></span></p>
            </div>

            <button type="submit" class="w-full rounded-lg bg-brand-700 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-brand-500" data-checkout-submit>Place order securely</button>
            <p class="text-xs text-neutral-400">By placing your order you agree to our <a href="/about" class="underline underline-offset-2">craftsmanship guarantee</a> and 15-year structural warranty.</p>
        </form>

        <aside class="lg:sticky lg:top-20 lg:self-start">
            <div class="rounded-2xl border border-brand-200 bg-white p-6">
                <div class="flex items-center justify-between">
                    <h2 class="text-lg font-bold tracking-tight text-brand-900">Order summary</h2>
                    <span class="rounded-full bg-brand-100 px-2.5 py-0.5 text-xs font-semibold text-neutral-600" data-checkout-count>0 items</span>
                </div>
                <div class="mt-4 divide-y divide-brand-100" data-checkout-items>
                    <p class="py-4 text-sm text-neutral-400">Your cart is empty.</p>
                </div>
                <dl class="mt-4 space-y-3 border-t border-brand-100 pt-4 text-sm">
                    <div class="flex items-center justify-between"><dt class="text-neutral-500">Subtotal</dt><dd class="font-semibold text-brand-900" data-checkout-subtotal>$0.00</dd></div>
                    <div class="flex items-center justify-between"><dt class="text-neutral-500">Delivery <span class="text-neutral-400">(white-glove, free)</span></dt><dd class="font-semibold text-brand-900">Free</dd></div>
                    <div class="flex items-center justify-between border-t border-brand-100 pt-3 text-base"><dt class="font-semibold text-brand-900">Total</dt><dd class="font-bold text-brand-900" data-checkout-total>$0.00</dd></div>
                </dl>
                <div class="mt-4 flex items-start gap-2 rounded-lg bg-brand-50 px-3 py-2.5 text-xs text-neutral-500">
                    <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                    <span>Encrypted &amp; insured order. You only pay on delivery.</span>
                </div>
            </div>

            <div class="mt-4 rounded-2xl border border-brand-200 bg-white p-5" data-checkout-guest hidden>
                <p class="text-sm text-neutral-600">Guest checkout is available. Sign in to save your order to your dashboard.</p>
                <a class="mt-3 block rounded-lg border border-brand-200 px-4 py-2.5 text-center text-sm font-semibold text-brand-900 transition hover:border-brand-600" href="/auth/login?returnUrl=/checkout">Sign in</a>
            </div>
        </aside>
    </div>
</section>