@{
    ViewData["Title"] = "Reset your password";
}

<section class="flex min-h-[70vh] items-center justify-center px-4 py-16">
    <div class="w-full max-w-md">
        <a href="/" class="text-xl font-black tracking-tight text-brand-900">@ViewBag.StoreName</a>

        @if (TempData["ResetSent"] != null)
        {
            <h1 class="mt-6 text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">Check your inbox</h1>
            <p class="mt-2 text-sm leading-relaxed text-neutral-500">
                If an account exists for that address, we've sent a link to set a new password.
                It expires in 30 minutes and can only be used once.
            </p>
            <div class="mt-6 rounded-lg border border-brand-200 bg-brand-50 px-4 py-3 text-sm text-brand-900">
                Nothing arrived? Check your spam folder, or
                <a href="mailto:@ViewBag.SupportEmail" class="font-semibold underline underline-offset-2">@ViewBag.SupportEmail</a>
                and we'll help you get back in.
            </div>
            <div class="mt-8 space-y-2 text-center text-sm">
                <a asp-controller="Auth" asp-action="Login" class="inline-block font-medium text-brand-900 underline underline-offset-2">Back to sign in</a>
                <p class="text-neutral-400">
                    <a asp-controller="Auth" asp-action="ForgotPassword" class="text-neutral-500 underline underline-offset-2">Send it again</a>
                </p>
            </div>
        }
        else
        {
            <h1 class="mt-6 text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">Forgot your password?</h1>
            <p class="mt-2 text-sm text-neutral-500">Enter the email on your account and we'll send you a link to choose a new password.</p>

            @if (ViewBag.Error != null)
            {
                <div class="mt-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">@ViewBag.Error</div>
            }

            <form asp-controller="Auth" asp-action="ForgotPassword" method="post" class="mt-8 space-y-5">
                <div>
                    <label for="email" class="mb-1.5 block text-sm font-medium text-neutral-700">Email</label>
                    <input type="email" id="email" name="email" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none transition placeholder:text-neutral-400 focus:border-brand-600 focus:ring-2 focus:ring-brand-600/10" placeholder="you@example.com" required autofocus />
                </div>
                <button type="submit" class="w-full rounded-lg bg-brand-700 px-4 py-3 text-sm font-semibold text-white transition hover:bg-brand-500">Email me a reset link</button>
            </form>

            <div class="mt-6 space-y-2 text-center text-sm">
                <a asp-controller="Auth" asp-action="Login" class="font-medium text-brand-900 underline underline-offset-2">Back to sign in</a>
                <p class="text-neutral-400">
                    New here? <a asp-controller="Auth" asp-action="Register" class="text-neutral-500 underline underline-offset-2">Create an account</a>
                </p>
            </div>
        }
    </div>
</section>
