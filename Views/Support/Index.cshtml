@{
    ViewData["Title"] = "Help & support";
    var ticket = (StarTalkSessions.Models.SupportTicket?)ViewBag.Ticket;
    var prefillName = ViewBag.PrefillName?.ToString() ?? "";
    var prefillEmail = ViewBag.PrefillEmail?.ToString() ?? "";
    var accountNumber = ViewBag.SupportAccountNumber?.ToString() ?? "1311403887";
    var accountName = ViewBag.SupportAccountName?.ToString() ?? "STAR TALK SESSIONS LTD";
    var bankName = ViewBag.SupportBankName?.ToString() ?? "PROVIDUSUNITYBANK";
}

<section class="border-b border-brand-100">
    <div class="mx-auto max-w-app px-4 py-10 sm:px-6">
        <nav class="text-xs text-neutral-400" aria-label="Breadcrumb">
            <a href="/" class="hover:text-brand-900">Home</a><span class="mx-1">/</span><span class="text-neutral-600">Support</span>
        </nav>
        <span class="mt-4 block text-xs font-semibold uppercase tracking-widest text-neutral-400">We're here to help</span>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">Support chat</h1>
        <p class="mt-2 max-w-2xl text-neutral-500">Get answers straight away, and ask for a studio specialist whenever you want a person on the thread.</p>
    </div>
</section>

<div class="mx-auto max-w-app px-4 py-8 sm:px-6">
    @if (TempData["Success"] != null)
    {
        <div class="mb-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">@TempData["Error"]</div>
    }

    <section id="support-details" class="mb-8 scroll-mt-24 rounded-2xl border border-brand-200 bg-white p-6 sm:p-8">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <span class="ed-kicker">Support</span>
                <h2 class="mt-2 text-2xl font-bold tracking-tight text-brand-900">Support our mission</h2>
                <p class="mt-2 max-w-xl text-sm text-neutral-500">Support our humanitarian programmes and help us build a better society. Every contribution keeps the conversation going.</p>
            </div>
            <div class="flex flex-wrap gap-2">
                <a href="tel:@accountNumber" class="ed-btn">Call @accountNumber</a>
                <button type="button" class="ed-btn ed-btn--outline" data-copy="@accountNumber" data-loading-label="Copying…">Copy account number</button>
            </div>
        </div>
        <dl class="mt-6 grid grid-cols-1 gap-4 border-t border-brand-100 pt-6 sm:grid-cols-3">
            <div><dt class="text-xs font-semibold uppercase tracking-wider text-neutral-400">Account name</dt><dd class="mt-1 font-semibold text-brand-900">@accountName</dd></div>
            <div><dt class="text-xs font-semibold uppercase tracking-wider text-neutral-400">Account number</dt><dd class="mt-1 font-semibold text-brand-900">@accountNumber</dd></div>
            <div><dt class="text-xs font-semibold uppercase tracking-wider text-neutral-400">Bank</dt><dd class="mt-1 font-semibold text-brand-900">@bankName</dd></div>
        </dl>
    </section>

    @if (ticket == null)
    {
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_1.3fr]">
            <div class="space-y-4">
                <a href="/contact" class="group flex items-center gap-4 rounded-2xl border border-brand-200 bg-white p-5 transition hover:border-brand-600">
                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-violet-100 text-violet-600">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7h18v10H3z"/><path d="M3 10l9 5 9-5"/></svg>
                    </span>
                    <div class="min-w-0"><h3 class="font-semibold text-brand-900">Prefer email or phone?</h3><p class="text-sm text-neutral-500">Use the contact &amp; studios page.</p></div>
                    <span class="ml-auto text-sm font-semibold text-brand-900 group-hover:underline">Open</span>
                </a>
            </div>

            <div class="rounded-2xl border border-brand-200 bg-white p-6 sm:p-8">
                <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">New conversation</span>
                <h2 class="mt-1 text-2xl font-bold tracking-tight text-brand-900">Tell us what you need</h2>
                <form method="post" action="/support/start" class="mt-6 space-y-5" data-loading>
                    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                        <div>
                            <label for="s-name" class="mb-1.5 block text-sm font-medium text-neutral-700">Name</label>
                            <input type="text" id="s-name" name="name" value="@prefillName" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" required />
                        </div>
                        <div>
                            <label for="s-email" class="mb-1.5 block text-sm font-medium text-neutral-700">Email</label>
                            <input type="email" id="s-email" name="email" value="@prefillEmail" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" required />
                        </div>
                    </div>
                    <div>
                        <label for="s-subject" class="mb-1.5 block text-sm font-medium text-neutral-700">Subject</label>
                        <input type="text" id="s-subject" name="subject" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" placeholder="Order status, delivery, custom piece…" />
                    </div>
                    <div>
                        <label for="s-message" class="mb-1.5 block text-sm font-medium text-neutral-700">Message</label>
                        <textarea id="s-message" name="message" rows="6" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" placeholder="Tell us more so we can help right away." required></textarea>
                    </div>
                    <div class="flex items-center justify-between gap-4">
                        <p class="text-xs text-neutral-400">Our team will respond as soon as they can.</p>
                        <button type="submit" class="shrink-0 rounded-lg bg-brand-700 px-6 py-3 text-sm font-semibold text-white transition hover:bg-brand-500" data-loading-label="Starting…">Start chat</button>
                    </div>
                </form>
            </div>
        </div>
    }
    else
    {
        var resolved = ticket.Status == "Resolved";
        var mode = resolved ? "human" : (ticket.AiAssigned ? "ai" : "human");
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-[1fr_2fr]">
            <div class="space-y-4">
                <div class="rounded-2xl border border-brand-200 bg-white p-6">
                    <div class="flex items-center justify-between gap-3">
                        <h3 class="font-semibold text-brand-900">@ticket.Subject</h3>
                        @if (!resolved)
                        {
                            <form method="post" action="/support/close" data-confirm="Close this conversation?" data-loading>
                                <input type="hidden" name="ticketId" value="@ticket.Id" />
                                <button type="submit" class="rounded-lg border border-brand-200 px-3 py-1.5 text-xs font-semibold text-neutral-600 transition hover:border-red-200 hover:text-red-600" data-loading-label="Closing…">Close</button>
                            </form>
                        }
                    </div>
                    <div class="mt-4 space-y-2 text-sm text-neutral-600">
                        <p class="flex items-center gap-2"><span class="text-neutral-400">From:</span>@ticket.Name · @ticket.Email</p>
                        <p class="flex items-center gap-2"><span class="text-neutral-400">Started:</span>@ticket.CreatedAt.ToString("MMM d, yyyy · h:mm tt")</p>
                        <p>
                            @if (mode == "ai")
                            {
                                 <span class="inline-flex items-center gap-1.5 rounded-full bg-neutral-100 px-3 py-1 text-xs font-semibold text-neutral-600">
                                     <span class="h-1.5 w-1.5 rounded-full bg-neutral-400"></span>Responding
                                 </span>
                            }
                            else if (resolved)
                            {
                                <span class="inline-flex items-center rounded-full bg-neutral-100 px-3 py-1 text-xs font-semibold text-neutral-500">Resolved</span>
                            }
                            else
                            {
                                <span class="inline-flex items-center rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-900">Studio specialist</span>
                            }
                        </p>
                    </div>
                </div>
                <a href="/support" class="block rounded-2xl border border-brand-200 bg-white p-5 text-sm text-neutral-600 transition hover:border-brand-600 hover:text-brand-900">Start a new conversation →</a>
            </div>

            <div id="chat" class="flex min-h-[26rem] flex-col overflow-hidden rounded-2xl border border-brand-200 bg-white">
                <div class="flex-1 space-y-4 overflow-y-auto p-5 sm:p-6" data-chat-scroll style="max-height:34rem">
                    @foreach (var m in ticket.Messages)
                    {
                        @if (m.Role == "user")
                        {
                            <div class="flex justify-end">
                                <div class="max-w-[80%] rounded-2xl rounded-tr-sm bg-brand-700 px-4 py-3 text-sm text-white">
                                    <p class="whitespace-pre-wrap leading-relaxed">@m.Body</p>
                                    <p class="mt-1 text-[10px] text-brand-200">@m.CreatedAt.ToString("h:mm tt")</p>
                                </div>
                            </div>
                        }
                        else if (m.Role == "ai")
                        {
                            <div class="flex justify-start">
                                 <div class="max-w-[85%] rounded-2xl rounded-tl-sm border border-brand-100 bg-brand-50 px-4 py-3 text-sm text-brand-900">
                                     <p class="mb-1 flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wide text-brand-700"><span class="h-1.5 w-1.5 rounded-full bg-brand-700"></span>@(m.Author ?? "Studio")</p>
                                     <p class="whitespace-pre-wrap leading-relaxed">@m.Body</p>
                                     <p class="mt-1 text-[10px] text-neutral-400">@m.CreatedAt.ToString("h:mm tt")</p>
                                 </div>
                            </div>
                        }
                        else
                        {
                            <div class="flex justify-start">
                                <div class="max-w-[85%] rounded-2xl rounded-tl-sm border border-violet-200 bg-violet-50 px-4 py-3 text-sm text-brand-900">
                                    <p class="mb-1 flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wide text-violet-600"><span class="h-1.5 w-1.5 rounded-full bg-violet-500"></span>@(m.Author ?? "Studio specialist")</p>
                                    <p class="whitespace-pre-wrap leading-relaxed">@m.Body</p>
                                    <p class="mt-1 text-[10px] text-neutral-400">@m.CreatedAt.ToString("h:mm tt")</p>
                                </div>
                            </div>
                        }
                    }
                </div>

                @if (!resolved)
                {
                    <form method="post" action="/support/send" class="flex items-end gap-2 border-t border-brand-100 p-4" data-loading>
                        <input type="hidden" name="ticketId" value="@ticket.Id" />
                        <textarea name="message" rows="2" required placeholder="Type your reply…" class="w-full resize-none rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600"></textarea>
                        <button type="submit" class="shrink-0 rounded-lg bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-500" data-loading-label="Sending…">Send</button>
                    </form>
                     <p class="border-t border-brand-100 px-4 py-2 text-center text-[11px] text-neutral-400">
                         @(mode == "human" && !resolved ? "A studio specialist is handling this conversation." : (!resolved ? "We're on it." : ""))
                     </p>
                }
                else
                {
                    <p class="border-t border-brand-100 px-5 py-3 text-center text-xs text-neutral-400">This conversation is closed. Start a new one anytime.</p>
                }
            </div>
        </div>

        <script>
            (function () {
                var ticketId = '@ticket.Id';
                var tick = 0;
                function poll() {
                    if (tick++ > 240) return;
                    fetch('/support/count?t=' + encodeURIComponent(ticketId), { headers: { 'Accept': 'application/json' } })
                        .then(function (r) { return r.json(); })
                        .then(function (d) {
                            if (!d.ok) return;
                            if (d.count !== @ticket.Messages.Count || d.status !== '@ticket.Status') { window.location.reload(); }
                        })
                        .catch(function () {});
                }
                setInterval(poll, 6000);
                var chat = document.querySelector('[data-chat-scroll]');
                if (chat) chat.scrollTop = chat.scrollHeight;
            })();
        </script>
    }
</div>