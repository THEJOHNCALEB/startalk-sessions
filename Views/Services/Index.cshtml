@{
    ViewData["Title"] = "Services";
    var services = (List<StarTalkSessions.Models.Service>)ViewBag.Services ?? new();
}

<section class="border-b border-brand-100">
    <div class="mx-auto max-w-app px-4 py-10 sm:px-6">
        <nav class="text-xs text-neutral-400" aria-label="Breadcrumb">
            <a href="/" class="hover:text-brand-900">Home</a><span class="mx-1">/</span><span class="text-neutral-600">Services</span>
        </nav>
        <span class="mt-4 block text-xs font-semibold uppercase tracking-widest text-neutral-400">What we do</span>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">Services built around craft</h1>
        <p class="mt-2 max-w-2xl text-neutral-500">From a single bespoke piece to a fully furnished hotel — one studio, one point of accountability.</p>
    </div>
</section>

<section class="mx-auto max-w-app space-y-16 px-4 py-12 sm:px-6 lg:py-16">
    @for (var i = 0; i < services.Count; i++)
    {
        var s = services[i];
        <article id="@s.Slug" class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:items-center">
            <div class="@(i % 2 == 1 ? "lg:order-2" : "") overflow-hidden rounded-2xl border border-brand-200">
                <img src="@s.ImageUrl" alt="@s.Title" loading="lazy" class="h-72 w-full object-cover" />
            </div>
            <div class="@(i % 2 == 1 ? "lg:order-1" : "")">
                <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">@s.Eyebrow — 0@(i + 1)</span>
                <h2 class="mt-2 text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">@s.Title</h2>
                <p class="mt-3 leading-relaxed text-neutral-600">@s.Description</p>
                <ul class="mt-5 space-y-2">
                    @foreach (var f in s.Features)
                    {
                        <li class="flex items-start gap-2 text-sm text-neutral-700">
                            <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12.5l5 5L20 6.5"/></svg>
                            <span>@f</span>
                        </li>
                    }
                </ul>
                <div class="mt-6 flex flex-wrap items-center gap-4">
                    <a href="/services/@s.Slug" class="text-sm font-semibold text-brand-900 underline underline-offset-4">Learn more →</a>
                    <button type="button" class="rounded-lg bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-500" data-inquiry='@Newtonsoft.Json.JsonConvert.SerializeObject(new { title = s.Title })'>Start a project</button>
                </div>
            </div>
        </article>
    }
</section>

<section class="bg-brand-700 py-16 text-white">
    <div class="mx-auto max-w-app px-4 text-center sm:px-6">
        <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">At any scale</span>
        <h2 class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">One piece or one hundred rooms</h2>
        <p class="mx-auto mt-3 max-w-xl text-neutral-300">Residential, hospitality, office and beyond — our logistics team installs anywhere on earth.</p>
    </div>
</section>

@* ---------- Inquiry modal ---------- *@
<div class="overlay fixed inset-0 z-[80] items-center justify-center bg-brand-700/40 p-4 backdrop-blur-sm" data-overlay="inquiry" data-inquiry-overlay aria-hidden="true">
    <div class="w-full max-w-lg rounded-2xl bg-white p-6 sm:p-8">
        <div class="mb-5 flex items-start justify-between">
            <div>
                <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">Start a project</span>
                <h3 class="mt-1 text-xl font-bold tracking-tight text-brand-900" data-inquiry-title>Project inquiry</h3>
            </div>
            <button type="button" class="flex h-8 w-8 items-center justify-center rounded-full text-neutral-400 transition hover:bg-brand-100 hover:text-brand-900" data-close-inquiry aria-label="Close">×</button>
        </div>
        <form method="post" action="/contact/submit" class="space-y-4">
            <input type="hidden" name="Type" value="Commercial Project" />
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                    <label for="inq-name" class="mb-1.5 block text-sm font-medium text-neutral-700">Name</label>
                    <input type="text" id="inq-name" name="Name" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" required />
                </div>
                <div>
                    <label for="inq-email" class="mb-1.5 block text-sm font-medium text-neutral-700">Email</label>
                    <input type="email" id="inq-email" name="Email" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" required />
                </div>
            </div>
            <div>
                <label for="inq-phone" class="mb-1.5 block text-sm font-medium text-neutral-700">Phone</label>
                <input type="tel" id="inq-phone" name="Phone" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" />
            </div>
            <div>
                <label for="inq-message" class="mb-1.5 block text-sm font-medium text-neutral-700">Tell us about the project</label>
                <textarea id="inq-message" name="Message" rows="5" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" required placeholder="Scope, space dimensions, timeframe, budget range…"></textarea>
            </div>
            <button type="submit" class="w-full rounded-lg bg-brand-700 px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-500">Send inquiry</button>
        </form>
    </div>
</div>