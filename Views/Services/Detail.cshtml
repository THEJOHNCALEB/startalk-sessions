@model StarTalkSessions.Models.Service
@{
    ViewData["Title"] = Model.Title;
    var more = (List<StarTalkSessions.Models.Service>)ViewBag.More ?? new();
}

<section class="mx-auto max-w-app px-4 py-10 sm:px-6">
    <nav class="text-xs text-neutral-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-900">Home</a><span class="mx-1">/</span><a href="/services" class="hover:text-brand-900">Services</a><span class="mx-1">/</span><span class="text-neutral-600">@Model.Title</span>
    </nav>

    <div class="mt-8 grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-center">
        <div>
            <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">@Model.Eyebrow</span>
            <h1 class="mt-2 text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">@Model.Title</h1>
            <p class="mt-3 leading-relaxed text-neutral-600">@Model.Description</p>
            <ul class="mt-5 space-y-2">
                @foreach (var f in Model.Features)
                {
                    <li class="flex items-start gap-2 text-sm text-neutral-700">
                        <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12.5l5 5L20 6.5"/></svg>
                        <span>@f</span>
                    </li>
                }
            </ul>
            <a href="/custom-furniture" class="mt-6 inline-flex rounded-lg bg-brand-700 px-6 py-3 text-sm font-semibold text-white transition hover:bg-brand-500">Request a quote</a>
        </div>
        <div class="overflow-hidden rounded-2xl border border-brand-200">
            <img src="@Model.ImageUrl" alt="@Model.Title" loading="lazy" class="h-80 w-full object-cover" />
        </div>
    </div>
</section>

@if (more.Any())
{
    <section class="border-t border-brand-100 bg-brand-50">
        <div class="mx-auto max-w-app px-4 py-14 sm:px-6">
            <div class="flex items-end justify-between">
                <div>
                    <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">More services</span>
                    <h2 class="mt-2 text-2xl font-bold tracking-tight text-brand-900">Explore the rest</h2>
                </div>
            </div>
            <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var s in more)
                {
                    <a href="/services/@s.Slug" class="group rounded-2xl border border-brand-200 bg-white p-6 transition hover:border-brand-300 hover:shadow-lg">
                        <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">@s.Eyebrow</span>
                        <h3 class="mt-2 text-lg font-bold tracking-tight text-brand-900">@s.Title</h3>
                        <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-neutral-500">@s.Description</p>
                        <span class="mt-auto inline-block pt-4 text-sm font-semibold text-brand-900 underline decoration-neutral-300 underline-offset-4 transition group-hover:decoration-brand-900">Learn more →</span>
                    </a>
                }
            </div>
        </div>
    </section>
}