@{
    ViewData["Title"] = "About Us";
    ViewBag.PageTitle = "About Us";
    ViewBag.PageSubtitle = "Independent broadcasting, built on honest conversation.";
}

<section class="ed-spotlight">
    <svg class="ed-spotlight__wave" viewBox="0 0 1440 320" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 160 Q 18 96 36 160 T 72 160 T 108 160 T 144 160 T 180 160 T 216 160 T 252 160 T 288 160 T 324 160 T 360 160 T 396 160 T 432 160 T 468 160 T 504 160 T 540 160 T 576 160 T 612 160 T 648 160 T 684 160 T 720 160 T 756 160 T 792 160 T 828 160 T 864 160 T 900 160 T 936 160 T 972 160 T 1008 160 T 1044 160 T 1080 160 T 1116 160 T 1152 160 T 1188 160 T 1224 160 T 1260 160 T 1296 160 T 1332 160 T 1368 160 T 1404 160 T 1440 160"
              fill="none" stroke="#FFFFFF" stroke-width="1" />
    </svg>
    <div class="ed-shell ed-spotlight__inner" style="grid-template-columns:1fr;min-height:260px">
        <div>
            <p class="ed-spotlight__kicker">Our story</p>
            <h2 class="ed-spotlight__title" style="max-width:32ch">Made to be heard. Built to last.</h2>
            <p class="ed-spotlight__desc">We are an independent talk studio — built on careful production, generous listening and the conviction that a good conversation only gets better with time.</p>
        </div>
    </div>
</section>

<section class="ed-section" style="margin-top:32px">
    <div class="ed-shell" style="padding-top:32px;padding-bottom:40px;display:grid;gap:32px">
        <div>
            <p class="ed-kicker">The story</p>
            <p style="margin-top:16px;max-width:70ch;line-height:1.75;color:#545658">The studio began with two people and a microphone in Minna, recording conversations for friends of friends. Today our shows reach audiences across West Africa and beyond — yet every episode still passes through the hands of a human editor before it airs.</p>
            <p style="margin-top:12px;max-width:70ch;line-height:1.75;color:#545658">Our ethos is simple: substance over spectacle. We listen carefully, edit honestly and build every series to be heard long after the moment has passed.</p>
        </div>
        <div style="border:1px solid #DCDCDC">
            <img src="https://images.unsplash.com/photo-1598387993281-cecf8b71a8f8?q=80&w=1400&auto=format&fit=crop" alt="Talk studio" loading="lazy" style="display:block;width:100%;height:100%;min-height:320px;object-fit:cover" />
        </div>
    </div>
</section>

<section class="ed-section" style="margin-top:32px">
    <div class="ed-shell" style="padding-top:28px;padding-bottom:36px">
        <div style="text-align:center">
            <p class="ed-kicker">The process</p>
            <h2 class="ed-serif" style="margin-top:8px;font-size:clamp(1.5rem,3.4vw,2.25rem);font-weight:700">From question to broadcast</h2>
        </div>
        <div class="ed-category-grid" style="padding-top:24px;padding-bottom:0">
            @foreach (var step in new[]
            {
                ("01", "The Question", "Every series begins with a question worth asking, not a format to fill."),
                ("02", "Conversation", "Guests in the room, with ideas and context carefully explored."),
                ("03", "Production", "Editors shape the conversation. No shortcuts, no manufactured drama."),
                ("04", "Sound & Picture", "Mixed and mastered for the way people actually listen and watch."),
                ("05", "Editorial Review", "Every episode checked against our standards before it airs."),
                ("06", "On Air", "Published across podcast, radio, television and live broadcast."),
                ("07", "The Conversation", "Listeners respond, and the next question comes from them."),
                ("08", "The Archive", "Work that still matters stays available, in full, for free.")
            })
            {
                <article class="ed-category-tile" style="aspect-ratio:auto;min-height:170px;flex-direction:column;align-items:flex-start;justify-content:space-between">
                    <span class="ed-kicker" style="color:#B8B8B8">@step.Item1</span>
                    <div>
                        <h3 class="ed-category-tile__title">@step.Item2</h3>
                        <p style="margin-top:8px;color:#B8B8B8;font-size:12px;line-height:1.5">@step.Item3</p>
                    </div>
                </article>
            }
        </div>
    </div>
</section>
