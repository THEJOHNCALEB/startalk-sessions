        new { Slug = "the-long-view-01", Series = "The Long View", Title = "The city after dark: who owns the night?", Duration = "33 mins", Image = "https://images.unsplash.com/photo-1519501025264-65ba15a82390?q=80&w=800&auto=format&fit=crop" },
        new { Slug = "global-news-02", Series = "Global News", Title = "Election night, three continents, one feed", Duration = "27 mins", Image = "https://images.unsplash.com/photo-1504711434969-e33886168f5c?q=80&w=800&auto=format&fit=crop" },
        new { Slug = "field-notes-03", Series = "Field Notes", Title = "Reporting from the edge of the floodplain", Duration = "41 mins", Image = "https://images.unsplash.com/photo-1478737270239-2f02b77fc618?q=80&w=800&auto=format&fit=crop" },
        new { Slug = "the-room-04", Series = "The Room", Title = "A conversation with the next generation", Duration = "24 mins", Image = "https://images.unsplash.com/photo-1524178232363-1fb2b075b655?q=80&w=800&auto=format&fit=crop" },
        new { Slug = "culture-desk-05", Series = "Culture Desk", Title = "The sound of a new African city", Duration = "38 mins", Image = "https://images.unsplash.com/photo-1492684223066-81342ee5ff30?q=80&w=800&auto=format&fit=crop" },
        new { Slug = "climate-file-06", Series = "The Climate File", Title = "What the rain is telling us", Duration = "29 mins", Image = "https://images.unsplash.com/photo-1500534623283-312aade485b7?q=80&w=800&auto=format&fit=crop" }
