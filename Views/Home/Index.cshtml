@* ---------- Featured channels ---------- *@
<section class="ed-channels">
    <div class="ed-shell">
        <div class="ed-section__head" style="border-top:0">
            <h2 class="ed-section__title">Featured channels</h2>
        </div>
        <div class="ed-channels__grid">
            @foreach (var channel in channels)
            {
                <article class="ed-channel">
                    <div class="ed-channel__badge" aria-hidden="true">@channel.Badge</div>
                    <div class="ed-channel__body">
                        <h3 class="ed-channel__title"><a href="@channel.Href">@channel.Title</a></h3>
                        <p class="ed-channel__desc">@channel.Description</p>
                        <a class="ed-channel__schedule" href="@channel.Href">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
                            @channel.Schedule
                        </a>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

