@using StarTalkSessions.Models
@{
    ViewData["Title"] = "Shows and episodes";

    var categories = (List<Category>)ViewBag.Categories ?? new();
    var content = ViewBag.HomeContent as Dictionary<string, List<HomeContent>> ?? new();
    Func<string, List<HomeContent>> section = key => content.TryGetValue(key, out var list) ? list : new();

    var hero = section("hero").FirstOrDefault();
    var spotlight = section("spotlight").FirstOrDefault();
    var recommended = section("recommended");
    var archive = section("archive");
    var channels = section("channel");

    Func<string, string> image = url => string.IsNullOrWhiteSpace(url) ? "/images/logo.png" : url;
}

@* ---------- Featured hero ---------- *@
@if (hero != null)
{
    <section class="ed-spotlight">
        <svg class="ed-spotlight__wave" viewBox="0 0 1440 320" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 160 Q 15 100 30 160 T 60 160 T 90 160 T 120 160 T 150 160 T 180 160 T 210 160 T 240 160 T 270 160 T 300 160 T 330 160 T 360 160 T 390 160 T 420 160 T 450 160 T 480 160 T 510 160 T 540 160 T 570 160 T 600 160 T 630 160 T 660 160 T 690 160 T 720 160 T 750 160 T 780 160 T 810 160 T 840 160 T 870 160 T 900 160 T 930 160 T 960 160 T 990 160 T 1020 160 T 1050 160 T 1080 160 T 1110 160 T 1140 160 T 1170 160 T 1200 160 T 1230 160 T 1260 160 T 1290 160 T 1320 160 T 1350 160 T 1380 160 T 1410 160 T 1440 160"
                  fill="none" stroke="#FFFFFF" stroke-width="1" />
            <path d="M0 160 Q 24 60 48 160 T 96 160 T 144 160 T 192 160 T 240 160 T 288 160 T 336 160 T 384 160 T 432 160 T 480 160 T 528 160 T 576 160 T 624 160 T 672 160 T 720 160 T 768 160 T 816 160 T 864 160 T 912 160 T 960 160 T 1008 160 T 1056 160 T 1104 160 T 1152 160 T 1200 160 T 1248 160 T 1296 160 T 1344 160 T 1392 160 T 1440 160"
                  fill="none" stroke="#FFFFFF" stroke-width=".5" opacity=".7" />
        </svg>

        <div class="ed-shell ed-spotlight__inner">
            <a class="ed-spotlight__art" href="@hero.TargetUrl" aria-label="@hero.Title">
                <img src="@image(hero.ImageUrl)" alt="@hero.Title" fetchpriority="high" />
                <span class="ed-spotlight__art-badge" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M4 14v-4m4 8V6m4 12V9m4 5v-8m4 8V4" /></svg>
                </span>
            </a>

            <svg class="ed-spotlight__wave-mobile" viewBox="0 0 300 136" preserveAspectRatio="none" aria-hidden="true">
                <path d="M0 68L15 60L30 50L45 58L60 44L75 54L90 40L105 60L120 52L135 64L150 68L165 64L180 52L195 60L210 40L225 54L240 44L255 58L270 50L285 60L300 68" fill="none" stroke="#FFFFFF" stroke-width="1.2" />
            </svg>

            <div class="ed-spotlight__copy">
                <p class="ed-spotlight__kicker">@hero.Kicker</p>
                <h2 class="ed-spotlight__title">@hero.Title</h2>
                <p class="ed-spotlight__desc">@hero.Summary</p>
                <div class="ed-spotlight__actions">
                    <a class="ed-audio-play" href="@hero.TargetUrl" aria-label="Play episode">
                        <svg viewBox="0 0 12 14" aria-hidden="true"><path d="M1 1l10 6-10 6z" /></svg>
                    </a>
                    <span class="ed-spotlight__duration">@hero.Duration</span>
                    <button type="button" class="ed-save" data-wishlist-toggle="@hero.Id" aria-pressed="false">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-6-4.5L6 21z" /></svg>
                        <span class="ed-save__label--save">Save</span>
                        <span class="ed-save__label--saved">Saved</span>
                    </button>
                </div>
            </div>
        </div>
    </section>
}

@* ---------- Recommended episodes ---------- *@
@if (recommended.Count > 0)
{
    <section class="ed-section">
        <div class="ed-shell">
            <div class="ed-section__head">
                <h2 class="ed-section__title"><a href="/media">Recommended today <span class="ed-section__chevron">&gt;</span></a></h2>
                <div class="ed-carousel-nav" data-carousel-nav>
                    <button type="button" class="ed-carousel-btn" data-carousel-prev aria-label="Previous episodes">
                        <svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7" /></svg>
                    </button>
                    <button type="button" class="ed-carousel-btn" data-carousel-next aria-label="Next episodes">
                        <svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" /></svg>
                    </button>
                </div>
            </div>

            <div class="ed-rail" data-carousel>
                <div class="ed-rail__track" data-carousel-track>
                    @foreach (var ep in recommended)
                    {
                        <article class="ed-episode">
                            <a class="ed-episode__thumb" href="@ep.TargetUrl" tabindex="-1" aria-hidden="true">
                                <img src="@image(ep.ImageUrl)" alt="" loading="lazy" decoding="async" />
                                <span class="ed-episode__badge"><svg viewBox="0 0 24 24"><path d="M4 14v-4m4 8V6m4 12V9m4 5v-8m4 8V4" /></svg></span>
                            </a>
                            <p class="ed-episode__kicker">@ep.Kicker</p>
                            <h3 class="ed-episode__title"><a href="@ep.TargetUrl">@ep.Title</a></h3>
                            <div class="ed-episode__meta">
                                <button type="button" class="ed-save" data-wishlist-toggle="@ep.Id" aria-pressed="false">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-6-4.5L6 21z" /></svg>
                                    <span class="ed-save__label--save">Save</span>
                                    <span class="ed-save__label--saved">Saved</span>
                                </button>
                                <span>@ep.Duration</span>
                            </div>
                        </article>
                    }
                </div>
            </div>
        </div>
    </section>
}

@* ---------- Mid-page spotlight ---------- *@
@if (spotlight != null)
{
    <section class="ed-spotlight ed-spotlight--mid">
        <svg class="ed-spotlight__wave" viewBox="0 0 1440 320" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 160 Q 18 92 36 160 T 72 160 T 108 160 T 144 160 T 180 160 T 216 160 T 252 160 T 288 160 T 324 160 T 360 160 T 396 160 T 432 160 T 468 160 T 504 160 T 540 160 T 576 160 T 612 160 T 648 160 T 684 160 T 720 160 T 756 160 T 792 160 T 828 160 T 864 160 T 900 160 T 936 160 T 972 160 T 1008 160 T 1044 160 T 1080 160 T 1116 160 T 1152 160 T 1188 160 T 1224 160 T 1260 160 T 1296 160 T 1332 160 T 1368 160 T 1404 160 T 1440 160"
                  fill="none" stroke="#FFFFFF" stroke-width="1" />
        </svg>

        <div class="ed-shell ed-spotlight__inner">
            <a class="ed-spotlight__art" href="@spotlight.TargetUrl" aria-label="@spotlight.Title">
                <img src="@image(spotlight.ImageUrl)" alt="@spotlight.Title" loading="lazy" />
                <span class="ed-spotlight__art-badge" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M4 14v-4m4 8V6m4 12V9m4 5v-8m4 8V4" /></svg>
                </span>
            </a>

            <svg class="ed-spotlight__wave-mobile" viewBox="0 0 300 136" preserveAspectRatio="none" aria-hidden="true">
                <path d="M0 68L15 60L30 50L45 58L60 44L75 54L90 40L105 60L120 52L135 64L150 68L165 64L180 52L195 60L210 40L225 54L240 44L255 58L270 50L285 60L300 68" fill="none" stroke="#FFFFFF" stroke-width="1.2" />
            </svg>

            <div class="ed-spotlight__copy">
                <p class="ed-spotlight__kicker">@spotlight.Kicker</p>
                <h2 class="ed-spotlight__title">@spotlight.Title</h2>
                <p class="ed-spotlight__desc">@spotlight.Summary</p>
                <div class="ed-spotlight__actions">
                    <a class="ed-audio-play" href="@spotlight.TargetUrl" aria-label="Play live show">
                        <svg viewBox="0 0 12 14" aria-hidden="true"><path d="M1 1l10 6-10 6z" /></svg>
                    </a>
                    <span class="ed-spotlight__duration">@spotlight.Duration</span>
                    <a href="@spotlight.TargetUrl" class="ed-text-btn" style="color:#FFFFFF">See the schedule &gt;</a>
                </div>
            </div>
        </div>
    </section>
}

@* ---------- Featured shows ---------- *@
@if (channels.Count > 0)
{
    <section class="ed-channels">
        <div class="ed-shell">
            <div class="ed-section__head" style="border-top:0">
                <h2 class="ed-section__title">Featured shows</h2>
                <a href="/media" class="ed-channels__all">All shows &gt;</a>
            </div>
            <div class="ed-channels__grid">
                @for (var i = 0; i < channels.Count; i++)
                {
                    var channel = channels[i];
                    <article class="ed-channel @(i >= 2 ? "ed-channel--extra" : "")">
                        <div class="ed-channel__badge ed-channel__badge--@(string.IsNullOrWhiteSpace(channel.Tone) ? "default" : channel.Tone)" aria-hidden="true">@channel.Badge</div>
                        <div class="ed-channel__body">
                            <h3 class="ed-channel__title"><a href="@channel.TargetUrl">@channel.Title</a></h3>
                            <p class="ed-channel__desc">@channel.Summary</p>
                            <a class="ed-channel__schedule" href="@channel.TargetUrl">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
                                <span class="ed-channel__when">@channel.Schedule</span>
                                <span class="ed-channel__label">Schedule</span>
                            </a>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
}

@* ---------- Archive rail ---------- *@
@if (archive.Count > 0)
{
    <section class="ed-section ed-section--spaced">
        <div class="ed-shell">
            <div class="ed-section__head">
                <h2 class="ed-section__title"><a href="/programmes">From the archive <span class="ed-section__chevron">&gt;</span></a></h2>
                <div class="ed-carousel-nav" data-carousel-nav>
                    <button type="button" class="ed-carousel-btn" data-carousel-prev aria-label="Previous episodes">
                        <svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7" /></svg>
                    </button>
                    <button type="button" class="ed-carousel-btn" data-carousel-next aria-label="Next episodes">
                        <svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" /></svg>
                    </button>
                </div>
            </div>

            <div class="ed-rail" data-carousel>
                <div class="ed-rail__track" data-carousel-track>
                    @foreach (var ep in archive)
                    {
                        <article class="ed-episode">
                            <a class="ed-episode__thumb" href="@ep.TargetUrl" tabindex="-1" aria-hidden="true">
                                <img src="@image(ep.ImageUrl)" alt="" loading="lazy" decoding="async" />
                                <span class="ed-episode__badge"><svg viewBox="0 0 24 24"><path d="M4 14v-4m4 8V6m4 12V9m4 5v-8m4 8V4" /></svg></span>
                            </a>
                            <p class="ed-episode__kicker">@ep.Kicker</p>
                            <h3 class="ed-episode__title"><a href="@ep.TargetUrl">@ep.Title</a></h3>
                            <div class="ed-episode__meta">
                                <button type="button" class="ed-save" data-wishlist-toggle="@ep.Id" aria-pressed="false">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-6-4.5L6 21z" /></svg>
                                    <span class="ed-save__label--save">Save</span>
                                    <span class="ed-save__label--saved">Saved</span>
                                </button>
                                <span>@ep.Duration</span>
                            </div>
                        </article>
                    }
                </div>
            </div>
        </div>
    </section>
}

@* ---------- Explore by category ---------- *@
@if (categories.Count > 0)
{
    <section class="ed-section ed-section--spaced">
        <div class="ed-shell">
            <div class="ed-section__head">
                <h2 class="ed-section__title">Explore by category</h2>
            </div>
            <div class="ed-category-grid">
                @foreach (var cat in categories)
                {
                    <a class="ed-category-tile" href="/media?category=@Uri.EscapeDataString(cat.Slug ?? "")">
                        <h3 class="ed-category-tile__title">@cat.Name</h3>
                    </a>
                }
            </div>
        </div>
    </section>
}

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('[data-carousel-nav]').forEach(function (nav) {
                var section = nav.closest('section');
                var track = section && section.querySelector('[data-carousel-track]');
                if (!track) return;
                var step = function () {
                    var card = track.querySelector('.ed-episode');
                    return card ? card.getBoundingClientRect().width + 16 : 320;
                };
                nav.querySelector('[data-carousel-prev]').addEventListener('click', function () {
                    track.scrollBy({ left: -step() * 2, behavior: 'smooth' });
                });
                nav.querySelector('[data-carousel-next]').addEventListener('click', function () {
                    track.scrollBy({ left: step() * 2, behavior: 'smooth' });
                });
            });

            document.querySelectorAll('.ed-audio-play[href]').forEach(function (link) {
                link.addEventListener('click', function (e) { e.preventDefault(); });
            });

            document.querySelectorAll('[data-wishlist-toggle]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    window.setTimeout(function () {
                        btn.setAttribute('aria-pressed', btn.classList.contains('active') ? 'true' : 'false');
                    }, 0);
                });
            });
        })();
    </script>
}
