    ViewBag.PageTitle = "Star Talk Sessions";
    ViewBag.PageSubtitle = "Stories that move people forward.";

    var categories = (List<StarTalkSessions.Models.Category>)ViewBag.Categories ?? new();

    var recommended = new[]
