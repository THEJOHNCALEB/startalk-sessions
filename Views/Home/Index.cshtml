    var channels = new[]
    {
        new { Badge = "GN", Title = "Global News", Description = "The day's reporting, context and analysis.", Schedule = "Weekdays · 06:00", Href = "/media" },
        new { Badge = "SL", Title = "StarTalk Live", Description = "Conversations as they happen, in the room.", Schedule = "Daily · 18:00", Href = "/events" },
