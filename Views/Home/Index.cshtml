@* ---------- Explore by category ---------- *@
<section class="ed-section" style="margin-top:32px">
    <div class="ed-shell">
        <div class="ed-section__head">
            <h2 class="ed-section__title">Explore by category</h2>
        </div>

        <div class="ed-category-grid">
            @foreach (var cat in categories)
            {
                <a class="ed-category-tile" href="/media">
                    <h3 class="ed-category-tile__title">@cat.Name</h3>
                </a>
            }
            @if (categories.Count == 0)
            {
                foreach (var name in new[] { "Podcast", "Radio", "Television", "News", "Videos", "Live Broadcast", "Community", "Impact" })
                {
                    <a class="ed-category-tile" href="/media"><h3 class="ed-category-tile__title">@name</h3></a>
                }
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('[data-carousel-nav]').forEach(function (nav) {
                var section = nav.closest('section');
                var track = section && section.querySelector('[data-carousel-track]');
                if (!track) return;
                var step = function () {
                    var card = track.querySelector('.ed-episode');
                    return card ? card.getBoundingClientRect().width + 16 : 320;
                };
                nav.querySelector('[data-carousel-prev]').addEventListener('click', function () {
                    track.scrollBy({ left: -step() * 2, behavior: 'smooth' });
                });
                nav.querySelector('[data-carousel-next]').addEventListener('click', function () {
                    track.scrollBy({ left: step() * 2, behavior: 'smooth' });
                });
            });

            document.querySelectorAll('[data-play]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var playing = btn.getAttribute('aria-pressed') === 'true';
                    btn.setAttribute('aria-pressed', playing ? 'false' : 'true');
                    btn.setAttribute('data-playing', playing ? 'false' : 'true');
                    btn.setAttribute('aria-label', playing ? 'Play episode' : 'Pause episode');
                    btn.innerHTML = playing
                        ? '<svg viewBox="0 0 12 14" aria-hidden="true"><path d="M1 1l10 6-10 6z" /></svg>'
                        : '<svg viewBox="0 0 12 14" aria-hidden="true"><path d="M2 1h3v12H2zM7 1h3v12H7z" /></svg>';
                });
            });

            document.querySelectorAll('[data-wishlist-toggle]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    window.setTimeout(function () {
                        btn.setAttribute('aria-pressed', btn.classList.contains('active') ? 'true' : 'false');
                    }, 0);
                });
            });
        })();
    </script>
}
