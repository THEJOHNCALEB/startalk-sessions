@* ---------- Full-bleed featured hero ---------- *@
<section class="ed-spotlight">
    <svg class="ed-spotlight__wave" viewBox="0 0 1440 320" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 160 Q 15 100 30 160 T 60 160 T 90 160 T 120 160 T 150 160 T 180 160 T 210 160 T 240 160 T 270 160 T 300 160 T 330 160 T 360 160 T 390 160 T 420 160 T 450 160 T 480 160 T 510 160 T 540 160 T 570 160 T 600 160 T 630 160 T 660 160 T 690 160 T 720 160 T 750 160 T 780 160 T 810 160 T 840 160 T 870 160 T 900 160 T 930 160 T 960 160 T 990 160 T 1020 160 T 1050 160 T 1080 160 T 1110 160 T 1140 160 T 1170 160 T 1200 160 T 1230 160 T 1260 160 T 1290 160 T 1320 160 T 1350 160 T 1380 160 T 1410 160 T 1440 160"
              fill="none" stroke="#FFFFFF" stroke-width="1" />
        <path d="M0 160 Q 24 60 48 160 T 96 160 T 144 160 T 192 160 T 240 160 T 288 160 T 336 160 T 384 160 T 432 160 T 480 160 T 528 160 T 576 160 T 624 160 T 672 160 T 720 160 T 768 160 T 816 160 T 864 160 T 912 160 T 960 160 T 1008 160 T 1056 160 T 1104 160 T 1152 160 T 1200 160 T 1248 160 T 1296 160 T 1344 160 T 1392 160 T 1440 160"
              fill="none" stroke="#FFFFFF" stroke-width=".5" opacity=".7" />
    </svg>

    <div class="ed-shell ed-spotlight__inner">
        <div>
            <p class="ed-spotlight__kicker">Global News · Latest episode</p>
            <h2 class="ed-spotlight__title">Election night, three continents, one feed</h2>
            <p class="ed-spotlight__desc">Our correspondents report live as results arrive from three capitals — and explain what the numbers actually mean for the people who voted.</p>
            <div class="ed-spotlight__actions">
                <button type="button" class="ed-audio-play" data-play aria-label="Play episode" aria-pressed="false">
                    <svg viewBox="0 0 12 14" aria-hidden="true"><path d="M1 1l10 6-10 6z" /></svg>
                </button>
                <span class="ed-spotlight__duration">33 mins</span>
                <button type="button" class="ed-save" data-wishlist-toggle="featured-global-news" aria-pressed="false">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-6-4.5L6 21z" /></svg>
                    <span class="ed-save__label--save">Save</span>
                    <span class="ed-save__label--saved">Saved</span>
                </button>
            </div>
        </div>

        <div class="ed-spotlight__art">
            <img src="https://images.unsplash.com/photo-1504711434969-e33886168f5c?q=80&w=800&auto=format&fit=crop" alt="Newsroom broadcast desk" fetchpriority="high" />
            <span class="ed-spotlight__art-badge" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M4 14v-4m4 8V6m4 12V9m4 5v-8m4 8V4" /></svg>
            </span>
        </div>
    </div>
</section>

@* ---------- Recommended today ---------- *@
<section class="ed-section">
    <div class="ed-shell">
        <div class="ed-section__head">
            <h2 class="ed-section__title"><a href="/media">Recommended today <span class="ed-section__chevron">&gt;</span></a></h2>
            <div class="ed-carousel-nav" data-carousel-nav>
                <button type="button" class="ed-carousel-btn" data-carousel-prev aria-label="Previous episodes">
                    <svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7" /></svg>
                </button>
                <button type="button" class="ed-carousel-btn" data-carousel-next aria-label="Next episodes">
                    <svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" /></svg>
                </button>
            </div>
        </div>

        <div class="ed-rail" data-carousel>
            <div class="ed-rail__track" data-carousel-track>
                @foreach (var ep in recommended)
                {
                    <article class="ed-episode">
                        <a class="ed-episode__thumb" href="/media" tabindex="-1" aria-hidden="true">
                            <img src="@ep.Image" alt="" loading="lazy" decoding="async" />
                            <span class="ed-episode__badge"><svg viewBox="0 0 24 24"><path d="M4 14v-4m4 8V6m4 12V9m4 5v-8m4 8V4" /></svg></span>
                        </a>
                        <p class="ed-episode__kicker">@ep.Series</p>
                        <h3 class="ed-episode__title"><a href="/media">@ep.Title</a></h3>
                        <div class="ed-episode__meta">
                            <button type="button" class="ed-save" data-wishlist-toggle="@ep.Slug" aria-pressed="false">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-6-4.5L6 21z" /></svg>
                                <span class="ed-save__label--save">Save</span>
                                <span class="ed-save__label--saved">Saved</span>
                            </button>
                            <span>@ep.Duration</span>
                        </div>
                    </article>
                }
            </div>
        </div>
    </div>
</section>

@* ---------- Mid-page spotlight ---------- *@
<section class="ed-spotlight" style="margin-top:32px">
    <svg class="ed-spotlight__wave" viewBox="0 0 1440 320" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 160 Q 18 92 36 160 T 72 160 T 108 160 T 144 160 T 180 160 T 216 160 T 252 160 T 288 160 T 324 160 T 360 160 T 396 160 T 432 160 T 468 160 T 504 160 T 540 160 T 576 160 T 612 160 T 648 160 T 684 160 T 720 160 T 756 160 T 792 160 T 828 160 T 864 160 T 900 160 T 936 160 T 972 160 T 1008 160 T 1044 160 T 1080 160 T 1116 160 T 1152 160 T 1188 160 T 1224 160 T 1260 160 T 1296 160 T 1332 160 T 1368 160 T 1404 160 T 1440 160"
              fill="none" stroke="#FFFFFF" stroke-width="1" />
    </svg>

    <div class="ed-shell ed-spotlight__inner">
        <div>
            <p class="ed-spotlight__kicker"><span class="ed-live-badge">Live channel</span> &nbsp; StarTalk Live</p>
            <h2 class="ed-spotlight__title">The room is open: a live hour with the people making the news</h2>
            <p class="ed-spotlight__desc">Listeners join the conversation in real time. Send a question, hear the answer, and stay for the analysis that follows.</p>
            <div class="ed-spotlight__actions">
