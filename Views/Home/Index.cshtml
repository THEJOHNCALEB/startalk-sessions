        new { Slug = "history-01", Series = "History", Title = "The stories the maps left out", Duration = "46 mins", Image = "https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?q=80&w=800&auto=format&fit=crop" },
        new { Slug = "history-02", Series = "History", Title = "Letters from the independence years", Duration = "32 mins", Image = "https://images.unsplash.com/photo-1490604001847-b712b0c2f967?q=80&w=800&auto=format&fit=crop" },
        new { Slug = "humanity-03", Series = "Humanity", Title = "The teachers who stayed", Duration = "28 mins", Image = "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?q=80&w=800&auto=format&fit=crop" },
        new { Slug = "impact-04", Series = "Impact", Title = "After the cameras leave", Duration = "35 mins", Image = "https://images.unsplash.com/photo-1504159506876-f8338247a14a?q=80&w=800&auto=format&fit=crop" },
        new { Slug = "culture-05", Series = "Culture", Title = "How a song becomes an anthem", Duration = "31 mins", Image = "https://images.unsplash.com/photo-1511379938547-c1f69419868d?q=80&w=800&auto=format&fit=crop" },
        new { Slug = "studio-06", Series = "Studio Sessions", Title = "Inside the cutting room", Duration = "22 mins", Image = "https://images.unsplash.com/photo-1598387993281-cecf8b71a8f8?q=80&w=800&auto=format&fit=crop" }
