@using StarTalkSessions.Utils
@using System.Text.Json
@{
    var siteName = (ViewBag.StoreName as string) ?? Store.Name;
    var pageTitle = ViewData["Title"]?.ToString();
    var metaTitle = string.IsNullOrWhiteSpace(pageTitle) || pageTitle == siteName
        ? $"{siteName} — Conversations worth staying for"
        : $"{pageTitle} — {siteName}";
    var metaDescription = (ViewBag.MetaDescription as string)
        ?? (ViewBag.PageSubtitle as string)
        ?? (ViewBag.StoreTagline as string)
        ?? Store.Tagline;
    if (string.IsNullOrWhiteSpace(metaDescription))
    {
        metaDescription = "Long-form talk shows, live conversations and episodes from the studio.";
    }
    var siteUrl = Store.SiteUrl.TrimEnd('/');
    var requestPath = Context.Request.Path.Value ?? "/";
    if (!requestPath.StartsWith("/")) { requestPath = "/" + requestPath; }
    var canonicalUrl = siteUrl + requestPath;
    var ogImageUrl = siteUrl + "/images/logo.png";
    var privateArea = Context.Request.Path.StartsWithSegments("/Admin")
        || Context.Request.Path.StartsWithSegments("/Account")
        || Context.Request.Path.StartsWithSegments("/Auth")
        || Context.Request.Path.StartsWithSegments("/Checkout")
        || Context.Request.Path.StartsWithSegments("/Quote")
        || (pageTitle?.StartsWith("Admin —", StringComparison.OrdinalIgnoreCase) ?? false);
    var robots = privateArea ? "noindex, nofollow" : "index, follow, max-image-preview:large";
    var schema = JsonSerializer.Serialize(new
    {
        context = "https://schema.org",
        type = "Organization",
        name = siteName,
        url = siteUrl,
        logo = ogImageUrl,
        description = metaDescription,
        email = ViewBag.SupportEmail as string
    });
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@metaTitle</title>
    <meta name="description" content="@metaDescription" />
    <meta name="robots" content="@robots" />
    <meta name="application-name" content="@siteName" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#141414" />
    <link rel="canonical" href="@canonicalUrl" />
    <link rel="alternate" hreflang="en" href="@canonicalUrl" />
    <link rel="alternate" hreflang="x-default" href="@canonicalUrl" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_NG" />
    <meta property="og:site_name" content="@siteName" />
    <meta property="og:title" content="@metaTitle" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@ogImageUrl" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@metaTitle" />
    <meta name="twitter:description" content="@metaDescription" />
    <meta name="twitter:image" content="@ogImageUrl" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="apple-touch-icon" href="/images/logo.png" />
    <script type="application/ld+json">@Html.Raw(schema.Replace("\"context\"", "\"@context\"").Replace("\"type\"", "\"@type\""))</script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700;6..72,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/editorial.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'Helvetica Neue', 'Arial', 'sans-serif'],
                        serif: ['Newsreader', 'Georgia', 'serif']
                    },
                    colors: {
                        brand: {
                            '50': '#FFFFFF',
                            '100': '#F5F5F5',
                            '200': '#DCDCDC',
                            '300': '#B8B8B8',
                            '400': '#8A8A8A',
                            '500': '#545658',
                            '600': '#3A3B3C',
                            '700': '#141414',
                            '800': '#141414',
                            '900': '#141414',
                            '950': '#121212'
                        }
                    },
                    maxWidth: { 'app': '80rem' }
                }
            }
        }
    </script>
    @* ---------- Google AdSense (rendered only when ADSENSE_CLIENT_ID is configured) ---------- *@
    @{
        var adsenseClient = StarTalkSessions.Utils.Store.AdSenseClientId;
    }
    @if (!string.IsNullOrWhiteSpace(adsenseClient))
    {
        <meta name="google-adsense-account" content="@adsenseClient" />
        <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=@adsenseClient" crossorigin="anonymous"></script>
    }
    <style>
        [data-overlay] { display: none; }
        [data-overlay].open { display: flex; }
        [data-nav].open { display: block; }
        .builder-step { display: none; }
        .builder-step.active { display: block; }
        .acc-body { display: none; }
        .acc-item.open .acc-body { display: block; }
        .acc-item.open .acc-head span { transform: rotate(45deg); }
        .acc-head span { transition: transform .2s ease; }
        .ba-after { clip-path: inset(0 0 0 calc(100% - var(--ba, 50%))); -webkit-clip-path: inset(0 0 0 calc(100% - var(--ba, 50%))); }
        [data-wishlist-toggle].active { color: #141414; }
        .thumb.active { border-color: #141414; }
        input[type="range"] { accent-color: #141414; }
        .stepper li { color: #545658; }
        .stepper li.active { color: #141414; font-weight: 700; }
        .stepper li .step-num { flex: none; display: flex; align-items: center; justify-content: center; width: 1.9rem; height: 1.9rem; border: 1px solid #DCDCDC; font-size: .8rem; font-weight: 700; background: #fff; }
        .stepper li.active .step-num { background: #141414; border-color: #141414; color: #fff; }
        .stepper li.done .step-num { border-color: #141414; color: #141414; }
        .stepper li.done .step-num span { display: none; }
        .stepper li.done .step-num::after { content: '✓'; font-size: .8rem; }
        .unit-toggle button.active { background: #141414; border-color: #141414; color: #fff; }
        .drop-zone.drag { border-color: #141414; background: #F5F5F5; }
        .ref-chip { display: inline-flex; align-items: center; border: 1px solid #DCDCDC; padding: .3rem .75rem; font-size: .75rem; background: #fff; color: #545658; }
        [data-config] [data-opt].active { border-color: #141414; color: #141414; }
    </style>
</head>
<body class="font-sans bg-white text-brand-900 antialiased">
    @await Html.PartialAsync("_Header")
    @await Component.InvokeAsync("BannerAds", new { placement = "header" })

    @if (ViewBag.PageTitle != null)
    {
        <div class="ed-page-title">
            <div class="ed-shell ed-page-title__inner">
                <h1>@ViewBag.PageTitle</h1>
                @if (ViewBag.PageSubtitle != null)
                {
                    <p>@ViewBag.PageSubtitle</p>
                }
            </div>
        </div>
    }

    <main id="main">
        @RenderBody()
    </main>

    @await Html.PartialAsync("_Footer")

    @* ---------- Global search ---------- *@
    <div class="overlay fixed inset-0 z-[80] items-start justify-center bg-black/60 p-4 sm:p-6" data-overlay="search" aria-hidden="true">
        <div class="mt-8 w-full max-w-2xl overflow-hidden border border-black bg-white" role="dialog" aria-modal="true" aria-label="Search">
            <div class="flex items-center gap-3 border-b border-[#DCDCDC] px-4 py-3">
                <form class="flex flex-1 items-center gap-2" data-search-form>
                    <svg class="h-5 w-5 shrink-0 text-neutral-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                    <input type="search" placeholder="Search shows, episodes, topics…" aria-label="Search" data-search-input autocomplete="off" class="w-full bg-transparent py-1 text-base outline-none placeholder:text-neutral-400" />
                    <kbd class="hidden border border-neutral-300 px-1.5 py-0.5 text-[10px] font-medium text-neutral-400 sm:inline">ESC</kbd>
                </form>
                <button type="button" class="ed-icon-btn" data-close-overlay="search" aria-label="Close search">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 6l12 12M18 6L6 18"/></svg>
                </button>
            </div>
            <div class="max-h-[60vh] overflow-y-auto p-4">
                <div class="search-hints" data-search-hints>
                    <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-neutral-500">Popular right now</p>
                    <div class="flex flex-wrap gap-2">
                        <button type="button" class="ed-btn ed-btn--outline" data-search-chip>The Long View</button>
                        <button type="button" class="ed-btn ed-btn--outline" data-search-chip>The Listening Room</button>
                        <button type="button" class="ed-btn ed-btn--outline" data-search-chip>Culture Desk</button>
                        <button type="button" class="ed-btn ed-btn--outline" data-search-chip>Interviews</button>
                        <button type="button" class="ed-btn ed-btn--outline" data-search-chip>Live</button>
                    </div>
                </div>
                <div class="search-results mt-2" data-search-results></div>
            </div>
        </div>
    </div>

    @* ---------- Listen queue drawer ---------- *@
    <div class="overlay fixed inset-0 z-[80] justify-end bg-black/60" data-overlay="cart" aria-hidden="true">
        <aside class="flex h-full w-full max-w-md flex-col border-l border-black bg-white" role="dialog" aria-modal="true" aria-label="Listen queue">
            <div class="flex items-center justify-between border-b border-[#DCDCDC] px-5 py-4">
                <h3 class="ed-serif text-lg font-bold">Your queue</h3>
                <button type="button" class="ed-icon-btn" data-close-overlay="cart" aria-label="Close queue">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 6l12 12M18 6L6 18"/></svg>
                </button>
            </div>
            <div class="border-b border-[#DCDCDC] px-5 py-3" data-cart-progress hidden>
                <span class="text-xs text-neutral-500" data-cart-progress-label>Keep listening — your queue is growing</span>
                <div class="mt-2 h-1 w-full overflow-hidden bg-neutral-200"><i class="block h-full bg-black transition-all duration-300" style="width:0%" data-cart-progress-bar></i></div>
            </div>
            <div class="flex-1 overflow-y-auto px-5 py-4" data-cart-body>
                <p class="py-8 text-center text-sm text-neutral-500" data-cart-empty>Your queue is empty. Save an episode to listen later.</p>
                <div class="cart-items space-y-4" data-cart-items></div>
            </div>
            <div class="border-t border-[#DCDCDC] px-5 py-4" data-cart-foot hidden>
                <div class="mb-3 flex items-center justify-between text-sm">
                    <span class="text-neutral-500">Total</span>
                    <strong data-cart-subtotal class="text-base">0</strong>
                </div>
                <a href="/media" class="ed-btn flex w-full items-center justify-center" data-checkout-btn>Explore the media room</a>
                <p class="mt-2 text-center text-xs text-neutral-400">Your queue is saved on this device.</p>
            </div>
        </aside>
    </div>

    @* ---------- Saved episodes drawer ---------- *@
    <div class="overlay fixed inset-0 z-[80] justify-end bg-black/60" data-overlay="wishlist" aria-hidden="true">
        <aside class="flex h-full w-full max-w-md flex-col border-l border-black bg-white" role="dialog" aria-modal="true" aria-label="Saved episodes">
            <div class="flex items-center justify-between border-b border-[#DCDCDC] px-5 py-4">
                <h3 class="ed-serif text-lg font-bold">Saved episodes</h3>
                <button type="button" class="ed-icon-btn" data-close-overlay="wishlist" aria-label="Close saved episodes">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 6l12 12M18 6L6 18"/></svg>
                </button>
            </div>
            <div class="flex-1 overflow-y-auto px-5 py-4">
                <p class="py-8 text-center text-sm text-neutral-500" data-wishlist-empty>Nothing saved yet. Tap the bookmark on any episode.</p>
                <div class="wishlist-items space-y-3" data-wishlist-items></div>
            </div>
        </aside>
    </div>

    @* ---------- Quick view modal ---------- *@
    <div class="overlay fixed inset-0 z-[80] items-center justify-center bg-black/60 p-4" data-overlay="quickview" aria-hidden="true">
        <div class="w-full max-w-3xl overflow-hidden border border-black bg-white" role="dialog" aria-modal="true" aria-label="Quick view" data-quickview-root></div>
    </div>

    @* ---------- Full-resolution media lightbox ---------- *@
    <div class="overlay fixed inset-0 z-[90] items-center justify-center bg-black p-4" data-overlay="lightbox" aria-hidden="true" data-lightbox>
        <button type="button" class="absolute right-4 top-4 z-10 flex h-10 w-10 items-center justify-center border border-white/40 text-white" data-close-lightbox aria-label="Close full-size view">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
        <div class="flex max-h-full max-w-5xl items-center justify-center" data-lightbox-content></div>
    </div>

    @* ---------- Confirmation dialog ---------- *@
    <div class="overlay fixed inset-0 z-[100] items-center justify-center bg-black/60 p-4" data-overlay="confirm" aria-hidden="true">
        <div class="ed-confirm__box" role="alertdialog" aria-modal="true" aria-labelledby="ed-confirm-title" aria-describedby="ed-confirm-message">
            <h2 class="ed-confirm__title" id="ed-confirm-title">Are you sure?</h2>
            <p class="ed-confirm__message" data-confirm-message></p>
            <div class="ed-confirm__actions">
                <button type="button" class="ed-btn ed-btn--outline" data-confirm-cancel data-loading-label="Working…">Cancel</button>
                <button type="button" class="ed-btn" data-confirm-accept data-loading-label="Working…">Confirm</button>
            </div>
        </div>
    </div>

    @* ---------- Support floating action ---------- *@
    <a href="/support"
       aria-label="Get support from the team"
       class="ed-audio-play ed-audio-play--dark ed-support-fab fixed bottom-5 right-5 z-[70]"
       style="width:48px;height:48px">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><path d="M20 14v3a3 3 0 0 1-3 3h-3"/><rect x="2" y="13" width="4" height="6" rx="1"/><rect x="18" y="13" width="4" height="6" rx="1"/></svg>
    </a>

    <script src="/js/main.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
