@model StarTalkSessions.Models.Product
@{
    var img = Model.Images.FirstOrDefault() ?? "";
    var img2 = Model.Images.Count > 1 ? Model.Images[1] : img;
}
<article class="product-card group flex h-full flex-col overflow-hidden border border-neutral-300 bg-white transition hover:border-black" data-product-card data-slug="@Model.Slug">
    <div class="product-media relative overflow-hidden">
        <a href="/shop/@Model.Slug" class="product-link block" aria-label="@Model.Name">
            <img class="img-main block h-56 w-full object-cover transition duration-500 group-hover:scale-105 sm:h-64" src="@img" alt="@Model.Name" loading="lazy" />
        </a>

        @if (Model.Badges.Any())
        {
            <div class="absolute left-3 top-3 flex flex-col items-start gap-1.5">
                @foreach (var badge in Model.Badges.Take(2))
                {
                    <span class="rounded-full bg-brand-700/90 px-2.5 py-0.5 text-[11px] font-semibold text-white">@badge</span>
                }
            </div>
        }

        @if (Model.IsCustomizable)
        {
            <span class="absolute right-3 top-3 rounded-full bg-white/90 px-2.5 py-0.5 text-[11px] font-medium text-neutral-700 backdrop-blur">Custom sizes</span>
        }

        <div class="absolute right-3 top-14 flex flex-col gap-1.5 opacity-0 transition duration-200 group-hover:opacity-100">
            <button type="button" class="flex h-9 w-9 items-center justify-center border border-neutral-200 bg-white text-neutral-700 transition hover:bg-black hover:border-black hover:text-white" data-quick-view='@Newtonsoft.Json.JsonConvert.SerializeObject(new { name = Model.Name, slug = Model.Slug, image = img, price = Model.EffectivePrice, category = Model.CategoryName })' aria-label="Quick view @Model.Name">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="2.6"/></svg>
            </button>
            <button type="button" class="flex h-9 w-9 items-center justify-center border border-neutral-200 bg-white text-neutral-700 transition hover:bg-black hover:border-black hover:text-white" data-wishlist-toggle="@Model.Slug" aria-label="Add @Model.Name to wishlist">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20s-7-4.6-9.2-9A5.2 5.2 0 0 1 12 6.6 5.2 5.2 0 0 1 21.2 11C19 15.4 12 20 12 20z"/></svg>
            </button>
        </div>
    </div>

    <div class="product-info flex flex-1 flex-col p-4">
        <div class="flex items-center justify-between">
            <span class="product-category text-[11px] font-semibold uppercase tracking-wider text-neutral-400">@Model.CategoryName</span>
            @if (Model.Stock <= 0)
            {
                <span class="text-[11px] font-medium text-neutral-400">Made to order</span>
            }
        </div>
        <h3 class="product-name mt-1.5 text-sm font-semibold leading-snug text-brand-900"><a href="/shop/@Model.Slug">@Model.Name</a></h3>

        <div class="mt-auto pt-4">
            <div class="flex items-center justify-between">
                <div class="product-price flex items-baseline gap-2">
                    @if (Model.CompareAtPrice.HasValue)
                    {
                        <span class="price-compare text-xs text-neutral-400 line-through" data-usd="@Model.CompareAtPrice">@Model.CompareAtPrice.Value.ToString("N0")</span>
                    }
                    @if (Model.EffectivePrice > 0)
                    {
                        <span class="price text-base font-bold text-brand-900" data-usd="@Model.EffectivePrice"></span>
                    }
                    else
                    {
                        <span class="price-custom text-base font-semibold text-brand-900">Request Custom Quote</span>
                    }
                </div>
                @if (Model.Materials.Any())
                {
                    <div class="flex items-center gap-1" title="Available materials">
                        @foreach (var mat in Model.Materials.Take(4))
                        {
                            <span class="h-3.5 w-3.5 rounded-full border border-brand-200" style="background:@mat.Swatch" aria-label="@mat.Name" title="@mat.Name"></span>
                        }
                    </div>
                }
            </div>

            <div class="mt-3">
                @if (Model.EffectivePrice > 0)
                {
                    <button type="button" class="w-full rounded-none border border-black bg-white px-4 py-3 text-xs font-bold uppercase tracking-widest text-black transition hover:bg-black hover:text-white" data-add-to-cart='@Newtonsoft.Json.JsonConvert.SerializeObject(new { slug = Model.Slug, name = Model.Name, image = img, price = Model.EffectivePrice, category = Model.CategoryName, url = $"/shop/{Model.Slug}" })'>Add to Cart</button>
                }
                else
                {
                    <a href="/custom-furniture" class="block w-full rounded-none border border-black px-4 py-3 text-center text-xs font-bold uppercase tracking-widest text-black transition hover:bg-black hover:text-white">Request a Quote</a>
                }
            </div>
        </div>
    </div>
</article>