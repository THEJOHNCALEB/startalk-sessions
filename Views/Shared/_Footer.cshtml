@{
    var storeName = (ViewBag.StoreName as string) ?? "Star Talk Sessions";
    var whatsappLink = StarTalkSessions.Utils.Functions.WhatsAppLink((string)ViewBag.WhatsappNumber, "");
}

<footer class="ed-footer">
    @* ---------- Newsletter ---------- *@
    <div class="ed-newsletter">
        <div class="ed-shell ed-newsletter__inner">
            <div>
                <span class="ed-kicker">The briefing, by email</span>
                <h2 class="mt-3">Start the day informed.</h2>
                <p>New episodes, live broadcast alerts and the stories behind the headlines.</p>
            </div>
            <form data-newsletter>
                <input type="email" name="email" placeholder="you@example.com" aria-label="Email address" required />
                <button type="submit" class="ed-btn">Subscribe</button>
                <div class="w-full newsletter-feedback text-xs text-neutral-500" data-newsletter-feedback></div>
            </form>
        </div>
    </div>

    @* ---------- Brand, links, social ---------- *@
    <div class="ed-shell ed-footer__top">
        <a href="/" class="ed-wordmark" aria-label="@storeName home">
            <span class="ed-wordmark__block">S</span>
            <span class="ed-wordmark__block">T</span>
            <span class="ed-wordmark__block">A</span>
            <span class="ed-wordmark__block">R</span>
            <span class="ed-wordmark__block ed-wordmark__block--dot">·</span>
            <span class="ed-wordmark__block ed-wordmark__block--wide">TALK</span>
        </a>

        <nav class="ed-footer__links" aria-label="Footer">
            <a href="/">Home</a>
            <a href="/media">Media</a>
            <a href="/programmes">Programmes</a>
            <a href="/impact">Impact</a>
            <a href="/events">Events</a>
            <a href="/partner">Partner</a>
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
            <a href="/support">Support</a>
        </nav>

        <div class="ed-footer__social">
            <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="0"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6" fill="currentColor" stroke="none"/></svg></a>
            <a href="https://youtube.com" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12"/><path d="m10 9 5 3-5 3z"/></svg></a>
            <a href="https://x.com" target="_blank" rel="noopener" aria-label="X"><svg viewBox="0 0 24 24"><path d="M5 5l14 14M19 5L5 19"/></svg></a>
            <a href="@whatsappLink" target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 24 24"><path d="M21 11.5a8.5 8.5 0 0 1-12.3 7.6L4 20l.9-4.7A8.5 8.5 0 1 1 21 11.5z"/><path d="M9 9.5c.5 2.5 3 5 5.5 5.5l1-1.3c.3-.3.7-.4 1-.2l1.5.8"/></svg></a>
        </div>
    </div>

    @await Component.InvokeAsync("BannerAds", new { placement = "footer" })

    <div class="ed-shell ed-footer__bottom">
        <span>© @DateTime.Now.Year @storeName. All rights reserved.</span>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
            <span>@ViewBag.AddressLine1, @ViewBag.AddressLine2</span>
            <a href="mailto:@ViewBag.SupportEmail">@ViewBag.SupportEmail</a>
            <a href="/contact">Privacy</a>
            <a href="/contact">Terms</a>
        </div>
    </div>
</footer>
