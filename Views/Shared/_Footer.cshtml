@{
    var whatsappLink = StarTalkSessions.Utils.Functions.WhatsAppLink((string)ViewBag.WhatsappNumber, "");
}

<footer class="ed-footer">
    @* ---------- Newsletter ---------- *@
    <div class="ed-newsletter">
        <div class="ed-shell ed-newsletter__inner">
            <div>
                <span class="ed-kicker">The listening list, by email</span>
                <h2 class="mt-3">Start with a conversation.</h2>
                <p>New episodes, live show alerts and the stories behind the studio.</p>
            </div>
            <form data-newsletter>
                <input type="email" name="email" placeholder="you@example.com" aria-label="Email address" required />
                <button type="submit" class="ed-btn">Subscribe</button>
                <div class="w-full newsletter-feedback text-xs text-neutral-500" data-newsletter-feedback></div>
            </form>
        </div>
    </div>

    @* ---------- Brand, links, social ---------- *@
    <div class="ed-shell ed-footer__top">
        <a href="/media" class="ed-footer__cta">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zm-2 5.5v7l5.5-3.5z" /></svg>
            <span>Listen &amp; subscribe</span>
        </a>

        <nav class="ed-footer__links" aria-label="Footer">
            <a href="/">Home</a>
            <a href="/media">Shows</a>
            <a href="/programmes">Episodes</a>
            <a href="/events">Schedule</a>
            <a href="/programmes">Topics</a>
            <a href="/partner">Partner</a>
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
            <a href="/support">Support</a>
        </nav>

        <div class="ed-footer__region" data-region>
            <button type="button" class="ed-region__toggle" data-region-toggle aria-expanded="false" aria-haspopup="true" aria-controls="ed-footer-region-panel">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 2.5 15.4 0 18M12 3c-2.5 2.6-2.5 15.4 0 18"/></svg>
                <span data-region-code>NGN</span>
            </button>
            <div class="ed-region__panel" id="ed-footer-region-panel" data-region-panel>
                <p class="ed-region__label">Region</p>
                <select aria-label="Region" onchange="this.value==='EN — Nigeria'&&localStorage.setItem('sts_currency','NGN')">
                    <option selected>EN — Nigeria</option>
                    <option>EN — United States</option>
                    <option>EN — United Kingdom</option>
                    <option>EN — Europe</option>
                    <option>EN — UAE</option>
                </select>
                <p class="ed-region__label">Currency</p>
                @await Component.InvokeAsync("CurrencySelector")
            </div>
        </div>

        <div class="ed-footer__social">
            <a href="https://open.spotify.com" target="_blank" rel="noopener" aria-label="Spotify"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm4.6 14.4a.8.8 0 0 1-1.1.3c-3-1.8-6.7-2.2-11.1-1.2a.8.8 0 1 1-.4-1.5c4.8-1.1 8.9-.6 12.3 1.4.4.2.5.7.3 1zm1.2-2.7a1 1 0 0 1-1.4.3c-3.4-2.1-8.7-2.7-12.7-1.5a1 1 0 1 1-.6-1.9c4.6-1.4 10.5-.7 14.4 1.7.5.3.6.9.3 1.4zm.1-2.8C14 8.6 7.6 8.4 3.8 9.6a1.2 1.2 0 1 1-.7-2.3c4.4-1.4 11.6-1.1 16.2 1.7a1.2 1.2 0 0 1-1.2 2z"/></svg></a>
            <a href="https://podcasts.apple.com" target="_blank" rel="noopener" aria-label="Apple Podcasts"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 4.2a5.8 5.8 0 0 1 3.4 10.5.9.9 0 0 1-1-1.5A4 4 0 1 0 8 12.9a.9.9 0 0 1-1.4 1.1A5.8 5.8 0 0 1 12 6.2zm0 2.4a3.4 3.4 0 0 1 2 6.1.8.8 0 1 1-.9-1.3 1.8 1.8 0 1 0-2.3 0 .8.8 0 1 1-.9 1.3 3.4 3.4 0 0 1 2.1-6.1zm0 2.2a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z"/></svg></a>
            <a href="https://youtube.com" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M21.6 7.2a2.6 2.6 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.6 2.6 0 0 0-1.8 1.8A27 27 0 0 0 2 12a27 27 0 0 0 .4 4.8 2.6 2.6 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.6 2.6 0 0 0 1.8-1.8A27 27 0 0 0 22 12a27 27 0 0 0-.4-4.8zM10 15V9l5.2 3z"/></svg></a>
            <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg></a>
            <a href="@whatsappLink" target="_blank" rel="noopener" aria-label="WhatsApp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 11.5a8.5 8.5 0 0 1-12.3 7.6L4 20l.9-4.7A8.5 8.5 0 1 1 21 11.5z"/><path d="M9 9.5c.5 2.5 3 5 5.5 5.5l1-1.3c.3-.3.7-.4 1-.2l1.5.8"/></svg></a>
        </div>
    </div>

    @await Component.InvokeAsync("BannerAds", new { placement = "footer" })

    <div class="ed-shell ed-footer__bottom">
        <span>© @DateTime.Now.Year. All rights reserved.</span>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
            <span>@ViewBag.AddressLine1, @ViewBag.AddressLine2</span>
            <a href="mailto:@ViewBag.SupportEmail">@ViewBag.SupportEmail</a>
            <a href="/contact">Privacy</a>
            <a href="/contact">Terms</a>
        </div>
    </div>
</footer>
