@{
    var storeName = (ViewBag.StoreName as string) ?? "Star Talk Sessions";
    var storeTagline = (ViewBag.StoreTagline as string) ?? string.Empty;
    var whatsappLink = StarTalkSessions.Utils.Functions.WhatsAppLink((string)ViewBag.WhatsappNumber, "");
}

<footer class="border-t border-neutral-300 bg-gray-100">
    @* ---------- Newsletter ---------- *@
    <div class="border-b border-neutral-300">
        <div class="mx-auto max-w-app px-4 py-12 sm:px-6 lg:py-16">
            <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:items-end lg:gap-16">
                <div>
                    <h2 class="text-[.6875rem] font-bold uppercase tracking-[.22em] text-neutral-500">The catalog, by post</h2>
                    <p class="mt-3 max-w-md font-serif text-2xl leading-tight tracking-tight text-black sm:text-3xl">
                        New pieces, studio dates and the occasional price drop.
                    </p>
                </div>
                <form class="w-full" data-newsletter>
                    <div class="flex flex-col gap-3 sm:flex-row">
                        <input type="email" name="email" placeholder="you@example.com" aria-label="Email address" required
                               class="w-full rounded-none border border-neutral-400 bg-white px-4 py-3 text-sm text-black outline-none placeholder:text-neutral-400 focus:border-black" />
                        <button type="submit" class="fs-btn shrink-0">Subscribe</button>
                    </div>
                    <div class="newsletter-feedback mt-2 min-h-4 text-xs text-neutral-500" data-newsletter-feedback></div>
                </form>
            </div>
        </div>
    </div>

    @* ---------- Link columns ---------- *@
    <div class="mx-auto max-w-app px-4 py-14 sm:px-6 lg:py-20">
        <div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4 lg:grid-cols-5">

            <div class="col-span-2 md:col-span-4 lg:col-span-1">
                <a href="/" class="inline-block" aria-label="@storeName home">
                    <img src="/images/logo.png" alt="@storeName" class="h-14 w-auto" />
                </a>
                <p class="mt-4 max-w-xs text-sm leading-relaxed text-neutral-600">
                    @storeTagline Kiln-dried community storiess, precision producery, insured white-glove delivery worldwide.
                </p>
                <div class="mt-5 flex gap-2">
                    <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram" class="flex h-9 w-9 items-center justify-center border border-neutral-400 text-neutral-600 transition hover:border-black hover:bg-black hover:text-white"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor"/></svg></a>
                    <a href="https://pinterest.com" target="_blank" rel="noopener" aria-label="Pinterest" class="flex h-9 w-9 items-center justify-center border border-neutral-400 text-neutral-600 transition hover:border-black hover:bg-black hover:text-white"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 8.2c-2.1 0-3.4 1.4-3.4 3.1 0 .9.4 1.9 1.5 2.1-.2.7-.5 1.5-.8 2"/><path d="M13.6 9.5c1.6.3 2.4 1.5 2.4 3.2 0 1.6-1.2 3.3-3 3.3"/></svg></a>
                    <a href="https://linkedin.com" target="_blank" rel="noopener" aria-label="LinkedIn" class="flex h-9 w-9 items-center justify-center border border-neutral-400 text-neutral-600 transition hover:border-black hover:bg-black hover:text-white"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 9v11M4 4v.5M20 9v11M8 20v-7a4 4 0 0 1 8 0v7"/></svg></a>
                    <a href="@whatsappLink" target="_blank" rel="noopener" aria-label="WhatsApp" class="flex h-9 w-9 items-center justify-center border border-neutral-400 text-neutral-600 transition hover:border-black hover:bg-black hover:text-white"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 11.5a8.5 8.5 0 0 1-12.3 7.6L4 20l.9-4.7A8.5 8.5 0 1 1 21 11.5z"/><path d="M9 9.5c.5 2.5 3 5 5.5 5.5l1-1.3c.3-.3.7-.4 1-.2l1.5.8"/></svg></a>
                </div>
            </div>

            <div>
                <h3 class="border-b border-neutral-300 pb-3 text-[.6875rem] font-bold uppercase tracking-[.22em] text-neutral-500">Company</h3>
                <ul class="mt-4 space-y-2.5 text-sm">
                    <li><a href="/about" class="text-neutral-700 transition hover:text-red-600">About us</a></li>
                    <li><a href="/projects" class="text-neutral-700 transition hover:text-red-600">Projects</a></li>
                    <li><a href="/blog" class="text-neutral-700 transition hover:text-red-600">Journal</a></li>
                    <li><a href="/contact" class="text-neutral-700 transition hover:text-red-600">Showrooms</a></li>
                    <li><a href="/account" class="text-neutral-700 transition hover:text-red-600">My account</a></li>
                </ul>
            </div>

            <div>
                <h3 class="border-b border-neutral-300 pb-3 text-[.6875rem] font-bold uppercase tracking-[.22em] text-neutral-500">Shop</h3>
                <ul class="mt-4 space-y-2.5 text-sm">
                    <li><a href="/shop" class="text-neutral-700 transition hover:text-red-600">All Media</a></li>
                    <li><a href="/shop?category=sofas-sectionals" class="text-neutral-700 transition hover:text-red-600">Sofas &amp; sectionals</a></li>
                    <li><a href="/shop?category=dining-sets" class="text-neutral-700 transition hover:text-red-600">Dining sets</a></li>
                    <li><a href="/shop?category=wardrobes-storage" class="text-neutral-700 transition hover:text-red-600">Storage</a></li>
                    <li><a href="/shop?category=outdoor-Media" class="text-neutral-700 transition hover:text-red-600">Outdoor</a></li>
                    <li><a href="/guest" class="text-neutral-700 transition hover:text-red-600">Guest applications</a></li>
                </ul>
            </div>

            <div>
                <h3 class="border-b border-neutral-300 pb-3 text-[.6875rem] font-bold uppercase tracking-[.22em] text-neutral-500">Services</h3>
                <ul class="mt-4 space-y-2.5 text-sm">
                    <li><a href="/services" class="text-neutral-700 transition hover:text-red-600">Interior design</a></li>
                    <li><a href="/services" class="text-neutral-700 transition hover:text-red-600">Space planning</a></li>
                    <li><a href="/services" class="text-neutral-700 transition hover:text-red-600">Joinery &amp; installation</a></li>
                    <li><a href="/shop/#shipping" class="text-neutral-700 transition hover:text-red-600">Delivery &amp; lead times</a></li>
                    <li><a href="/shop/#warranty" class="text-neutral-700 transition hover:text-red-600">Warranty &amp; returns</a></li>
                </ul>
            </div>

            <div>
                <h3 class="border-b border-neutral-300 pb-3 text-[.6875rem] font-bold uppercase tracking-[.22em] text-neutral-500">Contact</h3>
                <ul class="mt-4 space-y-2.5 text-sm">
                    <li class="leading-relaxed text-neutral-700">@ViewBag.AddressLine1<br>@ViewBag.AddressLine2</li>
                    <li class="text-neutral-700">Mon–Sat · 09:00 – 18:00 (WAT)</li>
                    <li><a href="tel:@(((string)ViewBag.SupportPhone).Replace(" ", ""))" class="text-neutral-700 transition hover:text-red-600">@ViewBag.SupportPhone</a></li>
                    <li><a href="mailto:@ViewBag.SupportEmail" class="text-neutral-700 transition hover:text-red-600">@ViewBag.SupportEmail</a></li>
                    <li><a href="/support" class="text-neutral-700 transition hover:text-red-600">Live support</a></li>
                </ul>
            </div>
        </div>

        @await Component.InvokeAsync("BannerAds", new { placement = "footer" })

        <div class="mt-12 flex flex-col gap-3 border-t border-neutral-300 pt-6 text-xs text-neutral-500 sm:flex-row sm:items-center sm:justify-between">
            <span>© @DateTime.Now.Year @storeName. All rights reserved.</span>
            <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
                <span>Secure payments</span>
                <span>International shipping</span>
                <span>Lifetime guarantee</span>
                <span>FSC-certified community</span>
            </div>
        </div>
    </div>
</footer>
