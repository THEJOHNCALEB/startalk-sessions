@{
    ViewData["Title"] = "Something went wrong";
}

<section class="mx-auto flex min-h-[60vh] max-w-app items-center px-4 py-16 sm:px-6">
    <div class="mx-auto max-w-xl text-center">
        <span class="text-6xl font-black tracking-tight text-neutral-200">500</span>
        <h1 class="mt-2 text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">We hit a snag in the workshop.</h1>
        <p class="mt-3 text-neutral-500">Something went wrong while loading this page. Try again, or head home to browse the collection.</p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
            <a href="/" class="rounded-lg bg-brand-700 px-6 py-3 text-sm font-semibold text-white transition hover:bg-brand-500">Back to Home</a>
            <a href="/shop" class="rounded-lg border border-brand-200 px-6 py-3 text-sm font-semibold text-brand-900 transition hover:border-brand-600">Browse the Shop</a>
        </div>
    </div>
</section>