@{
    var isAuthed = User.Identity?.IsAuthenticated == true;
    var isAdmin = isAuthed && User.IsInRole("Admin");
    var userName = isAuthed ? (User.FindFirst("Name")?.Value ?? "Account") : "";
    var profileHref = isAuthed ? (isAdmin ? "/Admin" : "/account") : "/auth/login";
    var storeName = (ViewBag.StoreName as string) ?? "StarTalk";
    var here = (Context.Request.Path.Value ?? "/").TrimEnd('/').ToLowerInvariant();
    if (here.Length == 0) { here = "/"; }
    Func<string, bool> isCurrent = href => href == "/" ? here == "/" : (here + "/").StartsWith(href + "/");

    var primaryLinks = new[]
    {
        new { Href = "/", Label = "Home" },
        new { Href = "/media", Label = "Shows" },
        new { Href = "/programmes", Label = "Episodes" },
        new { Href = "/events", Label = "Schedule" },
        new { Href = "/humanity", Label = "Live" },
        new { Href = "/about", Label = "About" },
        new { Href = "/contact", Label = "Contact" }
    };
}

<a href="#main" class="ed-skip">Skip to content</a>

<header class="ed-header" data-header>
    @* ---------- Top utility bar ---------- *@
    <div class="ed-util">
        <div class="ed-shell ed-util__inner">
            <div class="ed-util__side">
                <button class="ed-burger" type="button" data-nav-toggle aria-label="Open navigation" aria-expanded="false" aria-controls="ed-primary-nav">
                    <span></span><span></span>
                </button>
                <button type="button" class="ed-icon-btn" data-trigger-search aria-label="Search">
                    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                </button>
                <button type="button" class="ed-icon-btn" data-trigger-wishlist aria-label="Saved episodes">
                    <svg viewBox="0 0 24 24"><path d="M12 20s-7-4.6-9.2-9A5.2 5.2 0 0 1 12 6.6 5.2 5.2 0 0 1 21.2 11C19 15.4 12 20 12 20z"/></svg>
                    <span class="ed-count" data-wishlist-count hidden>0</span>
                </button>
                <button type="button" class="ed-icon-btn" data-trigger-cart aria-label="Listen queue">
                    <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
                    <span class="ed-count" data-cart-count hidden>0</span>
                </button>
            </div>

            <a href="/" class="ed-wordmark" aria-label="@storeName home">
                <span class="ed-wordmark__block">S</span>
                <span class="ed-wordmark__block">T</span>
                <span class="ed-wordmark__block">A</span>
                <span class="ed-wordmark__block">R</span>
                <span class="ed-wordmark__block ed-wordmark__block--dot">·</span>
                <span class="ed-wordmark__block ed-wordmark__block--wide">TALK</span>
                <span class="ed-wordmark__sub">Sessions</span>
            </a>

            <div class="ed-util__side ed-util__side--right">
                <div class="ed-region" data-region>
                    <button type="button" class="ed-region__toggle" data-region-toggle aria-expanded="false" aria-haspopup="true" aria-controls="ed-region-panel">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 2.5 15.4 0 18M12 3c-2.5 2.6-2.5 15.4 0 18"/></svg>
                        <span data-region-code>NGN</span>
                    </button>
                    <div class="ed-region__panel" id="ed-region-panel" data-region-panel>
                        <p class="ed-region__label">Region</p>
                        <select aria-label="Region" onchange="this.value==='EN — Nigeria'&&localStorage.setItem('sts_currency','NGN')">
                            <option selected>EN — Nigeria</option>
                            <option>EN — United States</option>
                            <option>EN — United Kingdom</option>
                            <option>EN — Europe</option>
                            <option>EN — UAE</option>
                        </select>
                        <p class="ed-region__label">Currency</p>
                        @await Component.InvokeAsync("CurrencySelector")
                    </div>
                </div>

                @if (isAuthed)
                {
                    <div class="group/account relative ed-util__account">
                        <button type="button" class="ed-btn" aria-label="Account">
                            @(userName.Length >= 1 ? userName[..1].ToUpperInvariant() : "A")
                        </button>
                        <div class="absolute right-0 top-full z-30 hidden w-56 pt-3 group-hover/account:block group-focus-within/account:block">
                            <div class="overflow-hidden border border-black bg-white">
                                <div class="border-b border-[#DCDCDC] px-3 py-2 text-xs text-neutral-500">Signed in as <strong class="block truncate text-sm text-black">@userName</strong></div>
                                <a href="/@(isAdmin ? "Admin" : "account")" class="block px-3 py-2 text-sm text-neutral-700 hover:bg-neutral-100">@(isAdmin ? "Admin console" : "Dashboard")</a>
                                @if (!isAdmin)
                                {
                                    <a href="/account/Orders" class="block px-3 py-2 text-sm text-neutral-700 hover:bg-neutral-100">Your activity</a>
                                    <a href="/account/Quotes" class="block px-3 py-2 text-sm text-neutral-700 hover:bg-neutral-100">Pitches</a>
                                }
                                <a asp-controller="Auth" asp-action="Logout" class="block px-3 py-2 text-sm text-red-700 hover:bg-red-50">Sign out</a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <a href="/auth/register" class="ed-util__cta ed-btn">Register</a>
                    <a href="/auth/login" class="ed-text-btn">Sign in</a>
                }
                <a href="@profileHref" class="ed-icon-btn ed-util__profile" aria-label="@(isAuthed ? "Account" : "Sign in")">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
                </a>
            </div>
        </div>
    </div>

    @* ---------- One navigation, adapted for small screens ---------- *@
    <nav class="ed-primary-nav" id="ed-primary-nav" data-nav aria-label="Primary">
        <div class="ed-shell ed-primary-nav__inner">
            @foreach (var link in primaryLinks)
            {
                <a href="@link.Href" class="ed-primary-nav__link @(isCurrent(link.Href) ? "is-active" : "")" aria-current="@(isCurrent(link.Href) ? "page" : "false")">@link.Label</a>
            }

            <div class="ed-nav-extra">
                <p class="ed-nav-extra__label">Quick links</p>
                <a class="ed-nav-extra__link" href="/humanity">
                    <span>Listen live</span>
                    <small>On air now</small>
                </a>
                <a class="ed-nav-extra__link" href="/guest">
                    <span>Be a guest</span>
                    <small>Send an application</small>
                </a>
                <a class="ed-nav-extra__link" href="/support">
                    <span>Get support</span>
                    <small>We're here to help</small>
                </a>
                <div class="ed-nav-extra__actions">
                    @if (!isAuthed)
                    {
                        <a href="/auth/register" class="ed-btn">Register</a>
                        <a href="/auth/login" class="ed-btn ed-btn--outline">Sign in</a>
                    }
                    else
                    {
                        <a href="/@(isAdmin ? "Admin" : "account")" class="ed-btn">@(isAdmin ? "Admin console" : "Your dashboard")</a>
                    }
                </div>
                <p class="ed-nav-extra__note">Conversations worth staying for — wherever you listen.</p>
            </div>
        </div>
    </nav>
</header>

<script>
    (function () {
        var toggle = document.querySelector('[data-nav-toggle]');
        var sheet = document.querySelector('[data-nav]');
        if (toggle && sheet) {
            function setOpen(open) {
                sheet.classList.toggle('is-open', open);
                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                toggle.setAttribute('aria-label', open ? 'Hide navigation' : 'Show navigation');
                document.body.style.overflow = open ? 'hidden' : '';
            }
            toggle.addEventListener('click', function () { setOpen(!sheet.classList.contains('is-open')); });
            sheet.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', function () { setOpen(false); }); });
            sheet.addEventListener('click', function (e) {
                if (e.target === sheet || e.target.classList.contains('ed-primary-nav__inner')) setOpen(false);
            });
            window.addEventListener('resize', function () { if (window.innerWidth >= 768) setOpen(false); });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && sheet.classList.contains('is-open')) { setOpen(false); toggle.focus(); }
            });
        }

        document.querySelectorAll('[data-region]').forEach(function (region) {
            var regionToggle = region.querySelector('[data-region-toggle]');
            var regionPanel = region.querySelector('[data-region-panel]');
            if (!regionToggle || !regionPanel) return;
            var code = region.querySelector('[data-region-code]');
            var saved = localStorage.getItem('sts_currency');
            if (code && saved) code.textContent = saved;
            var setRegion = function (open) {
                regionPanel.classList.toggle('is-open', open);
                regionToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            };
            regionToggle.addEventListener('click', function () { setRegion(!regionPanel.classList.contains('is-open')); });
            document.addEventListener('click', function (e) { if (!region.contains(e.target)) setRegion(false); });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setRegion(false); });
            var sel = regionPanel.querySelector('[data-currency] select');
            if (sel && saved) sel.value = saved;
        });
    })();
</script>
