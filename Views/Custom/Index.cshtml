@{
    ViewData["Title"] = "Custom Projects";
    var categories = (string[])ViewBag.Categories ?? Array.Empty<string>();
    var styles = (string[])ViewBag.Styles ?? Array.Empty<string>();
    var woods = (string[])ViewBag.Woods ?? Array.Empty<string>();
    var fabrics = (string[])ViewBag.Fabrics ?? Array.Empty<string>();
    var hardware = (string[])ViewBag.Hardware ?? Array.Empty<string>();
    var densities = (string[])ViewBag.CushionDensities ?? Array.Empty<string>();
    var budgets = (string[])ViewBag.Budgets ?? Array.Empty<string>();
}

<section class="border-b border-brand-100">
    <div class="mx-auto max-w-app px-4 py-10 sm:px-6">
        <nav class="text-xs text-neutral-400" aria-label="Breadcrumb">
            <a href="/" class="hover:text-brand-900">Home</a><span class="mx-1">/</span><span class="text-neutral-600">Custom Projects</span>
        </nav>
        <span class="mt-4 block text-xs font-semibold uppercase tracking-widest text-neutral-400">Bespoke Atelier</span>
        <h1 class="mt-2 max-w-3xl text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">Have a Design in Mind? <em class="text-[1.05em] font-normal">Let's Build It.</em></h1>
        <p class="mt-2 max-w-2xl text-neutral-500">Six short steps to a made-to-measure quote. Sketches, CAD drawings and moodboards welcome — our producers handle the rest.</p>
    </div>
</section>

@if (TempData["Error"] != null)
{
    <div class="mx-auto mt-6 max-w-app px-4 sm:px-6"><div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">@TempData["Error"]</div></div>
}

<section class="mx-auto max-w-app px-4 py-10 sm:px-6 lg:py-14" data-builder data-quote-form>
    <ol class="stepper flex flex-wrap items-center gap-x-6 gap-y-3 border-b border-brand-100 pb-6">
        <li data-step-dot="1" class="active"><span class="step-num"><span>1</span></span>Category &amp; style</li>
        <li data-step-dot="2"><span class="step-num"><span>2</span></span>References</li>
        <li data-step-dot="3"><span class="step-num"><span>3</span></span>Dimensions</li>
        <li data-step-dot="4"><span class="step-num"><span>4</span></span>Materials</li>
        <li data-step-dot="5"><span class="step-num"><span>5</span></span>Budget &amp; timeline</li>
        <li data-step-dot="6"><span class="step-num"><span>6</span></span>Contact</li>
    </ol>

    <form method="post" action="/custom/submit" class="builder-form mt-10 space-y-12" enctype="multipart/form-data" data-builder-form data-loading>

        @* ---------- STEP 1 ---------- *@
        <div class="builder-step active space-y-8" data-step="1">
            <div>
                <h2 class="text-2xl font-bold tracking-tight text-brand-900">What are we building?</h2>
                <p class="mt-1 text-sm text-neutral-500">Choose the media category closest to your idea — you can refine everything later.</p>
            </div>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var c in categories)
                {
                    <label class="cursor-pointer">
                        <input type="radio" name="Category" value="@c" required class="peer sr-only" />
                        <span class="flex items-center justify-between rounded-xl border border-brand-200 px-4 py-3.5 text-sm font-medium text-neutral-700 transition peer-checked:border-brand-600 peer-checked:bg-brand-50 peer-checked:text-brand-900">@c</span>
                    </label>
                }
            </div>
            <div>
                <label class="mb-2 block text-sm font-medium text-brand-900">Reference style</label>
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var s in styles)
                    {
                        <label class="cursor-pointer">
                            <input type="radio" name="Style" value="@s" class="peer sr-only" />
                            <span class="flex items-center justify-between rounded-xl border border-brand-200 px-4 py-3 text-sm text-neutral-600 transition peer-checked:border-brand-600 peer-checked:bg-brand-50 peer-checked:text-brand-900">@s</span>
                        </label>
                    }
                </div>
            </div>
        </div>

        @* ---------- STEP 2 ---------- *@
        <div class="builder-step space-y-6" data-step="2">
            <div>
                <h2 class="text-2xl font-bold tracking-tight text-brand-900">Upload references &amp; blueprints</h2>
                <p class="mt-1 text-sm text-neutral-500">Images, CAD drawings or PDF moodboards. Drag them in — previews appear below.</p>
            </div>
            <label class="drop-zone flex cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-neutral-300 bg-brand-50/50 px-6 py-12 text-center transition hover:border-brand-600">
                <input type="file" name="referenceFiles" accept="image/*,.pdf,.dwg" multiple class="sr-only" data-ref-input />
                <svg class="h-8 w-8 text-neutral-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 16V4m0 0l-4 4m4-4l4 4"/><path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/></svg>
                <strong class="mt-3 text-sm text-brand-900">Drag &amp; drop files</strong>
                <span class="mt-1 text-xs text-neutral-400">or click to browse · JPG, PNG, PDF, DWG up to 20MB each</span>
            </label>
            <div class="flex flex-wrap gap-2" data-ref-preview></div>
        </div>

        @* ---------- STEP 3 ---------- *@
        <div class="builder-step space-y-6" data-step="3">
            <div>
                <h2 class="text-2xl font-bold tracking-tight text-brand-900">Dimensions</h2>
                <p class="mt-1 text-sm text-neutral-500">Provide target dimensions in cm or inches. Don't know yet? Our designers will advise.</p>
            </div>
            <div class="flex gap-2" data-unit-toggle>
                <button type="button" class="active rounded-lg border border-brand-200 px-4 py-2 text-sm font-semibold text-neutral-700 transition" data-unit="cm">cm</button>
                <button type="button" class="rounded-lg border border-brand-200 px-4 py-2 text-sm font-semibold text-neutral-700 transition" data-unit="in">inches</button>
                <input type="hidden" name="DimensionUnit" value="cm" data-unit-field />
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                <label class="block">
                    <span class="mb-1.5 block text-sm font-medium text-neutral-700">Width</span>
                    <input type="number" name="Width" placeholder="—" min="0" step="0.1" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" />
                </label>
                <label class="block">
                    <span class="mb-1.5 block text-sm font-medium text-neutral-700">Height</span>
                    <input type="number" name="Height" placeholder="—" min="0" step="0.1" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" />
                </label>
                <label class="block">
                    <span class="mb-1.5 block text-sm font-medium text-neutral-700">Depth</span>
                    <input type="number" name="Depth" placeholder="—" min="0" step="0.1" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" />
                </label>
            </div>
            <p class="text-xs text-neutral-400">Tip: leaving these empty is fine — our team will propose proportions for your space.</p>
        </div>

        @* ---------- STEP 4 ---------- *@
        <div class="builder-step space-y-8" data-step="4">
            <div>
                <h2 class="text-2xl font-bold tracking-tight text-brand-900">Materials &amp; finish</h2>
            </div>
            <div>
                <label class="mb-2 block text-sm font-medium text-brand-900">Wood species</label>
                <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
                    @foreach (var w in woods)
                    {
                        <label class="cursor-pointer">
                            <input type="radio" name="Wood" value="@w" class="peer sr-only" />
                            <span class="block rounded-xl border border-brand-200 px-4 py-3 text-center text-sm text-neutral-600 transition peer-checked:border-brand-600 peer-checked:bg-brand-50 peer-checked:text-brand-900">@w</span>
                        </label>
                    }
                </div>
            </div>
            <div>
                <label class="mb-2 block text-sm font-medium text-brand-900">Upholstery fabric</label>
                <div class="grid grid-cols-2 gap-3 lg:grid-cols-3">
                    @foreach (var f in fabrics)
                    {
                        <label class="cursor-pointer">
                            <input type="radio" name="Fabric" value="@f" class="peer sr-only" />
                            <span class="block rounded-xl border border-brand-200 px-4 py-3 text-center text-sm text-neutral-600 transition peer-checked:border-brand-600 peer-checked:bg-brand-50 peer-checked:text-brand-900">@f</span>
                        </label>
                    }
                </div>
            </div>
            <div>
                <label class="mb-2 block text-sm font-medium text-brand-900">Hardware finish</label>
                <div class="grid grid-cols-2 gap-3 lg:grid-cols-3">
                    @foreach (var h in hardware)
                    {
                        <label class="cursor-pointer">
                            <input type="radio" name="Hardware" value="@h" class="peer sr-only" />
                            <span class="block rounded-xl border border-brand-200 px-4 py-3 text-center text-sm text-neutral-600 transition peer-checked:border-brand-600 peer-checked:bg-brand-50 peer-checked:text-brand-900">@h</span>
                        </label>
                    }
                </div>
            </div>
            <div>
                <label class="mb-2 block text-sm font-medium text-brand-900">Cushion density</label>
                <div class="grid grid-cols-2 gap-3 lg:grid-cols-3">
                    @foreach (var d in densities)
                    {
                        <label class="cursor-pointer">
                            <input type="radio" name="CushionDensity" value="@d" class="peer sr-only" />
                            <span class="block rounded-xl border border-brand-200 px-4 py-3 text-center text-sm text-neutral-600 transition peer-checked:border-brand-600 peer-checked:bg-brand-50 peer-checked:text-brand-900">@d</span>
                        </label>
                    }
                </div>
            </div>
        </div>

        @* ---------- STEP 5 ---------- *@
        <div class="builder-step space-y-8" data-step="5">
            <div>
                <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">Budget &amp; timeline</span>
                <h2 class="mt-1 text-2xl font-bold tracking-tight text-brand-900">Help us scope the build</h2>
            </div>
            <div>
                <label class="mb-2 block text-sm font-medium text-brand-900">Estimated budget</label>
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var b in budgets)
                    {
                        <label class="cursor-pointer">
                            <input type="radio" name="Budget" value="@b" class="peer sr-only" />
                            <span class="block rounded-xl border border-brand-200 px-4 py-3.5 text-center text-sm font-medium text-neutral-700 transition peer-checked:border-brand-600 peer-checked:bg-brand-50 peer-checked:text-brand-900">@b</span>
                        </label>
                    }
                </div>
            </div>
            <div>
                <label class="mb-1.5 block text-sm font-medium text-brand-900">Desired delivery date</label>
                <input type="date" name="DeliveryBy" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600 sm:max-w-xs" />
                <p class="mt-1 text-xs text-neutral-400">Typical bespoke lead times: 8–14 weeks.</p>
            </div>
        </div>

        @* ---------- STEP 6 ---------- *@
        <div class="builder-step space-y-6" data-step="6">
            <div>
                <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400">Almost done</span>
                <h2 class="mt-1 text-2xl font-bold tracking-tight text-brand-900">Where should we send the quote?</h2>
            </div>
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-neutral-700">Full name *</label>
                    <input type="text" name="Name" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" required />
                </div>
                <div>
                    <label class="mb-1.5 block text-sm font-medium text-neutral-700">Email *</label>
                    <input type="email" name="Email" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" required />
                </div>
                <div class="sm:col-span-2">
                    <label class="mb-1.5 block text-sm font-medium text-neutral-700">Phone / WhatsApp</label>
                    <input type="tel" name="Phone" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" placeholder="+234 800 000 0000" />
                </div>
                <div class="sm:col-span-2">
                    <label class="mb-1.5 block text-sm font-medium text-neutral-700">Anything we should know?</label>
                    <textarea name="Notes" rows="4" class="w-full rounded-lg border border-neutral-300 px-4 py-2.5 text-sm outline-none focus:border-brand-600" placeholder="Lifestyle, space constraints, must-haves, deadline pressures…"></textarea>
                </div>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-3 border-t border-brand-100 pt-6">
            <button type="button" class="rounded-lg border border-brand-200 px-5 py-2.5 text-sm font-semibold text-neutral-700 transition hover:border-brand-600" data-builder-prev disabled>← Back</button>
            <button type="button" class="rounded-lg border border-brand-200 px-5 py-2.5 text-sm font-semibold text-neutral-700 transition hover:border-brand-600" data-builder-next>Continue →</button>
            <button type="submit" class="rounded-lg bg-brand-700 px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-500" data-builder-submit hidden>Submit request</button>
        </div>
    </form>
</section>