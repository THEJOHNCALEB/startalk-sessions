@model StarTalkSessions.Models.CustomQuote
@{
    ViewData["Title"] = "Quote Request Submitted";
    string waNumber = ViewBag.WhatsappNumber?.ToString() ?? StarTalkSessions.Utils.Store.WhatsappNumber;
    var waMsg = $"Hi {StarTalkSessions.Utils.Store.Name} — I just submitted quote request {@Model.RefNumber} for a {@Model.Category}. I'd love to discuss it further.";
    var digits = StarTalkSessions.Utils.Functions.WhatsAppDigits(waNumber);
    var wa = $"https://wa.me/{digits}?text={Uri.EscapeDataString(waMsg)}";
}

<section class="mx-auto max-w-2xl px-4 py-14 sm:px-6">
    <div class="rounded-2xl border border-brand-200 bg-white p-8 text-center sm:p-12">
        <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
            <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12.5l5 5L20 6.5"/></svg>
        </span>
        <span class="mt-6 block text-xs font-semibold uppercase tracking-widest text-neutral-400">Request received</span>
        <h1 class="mt-2 text-2xl font-bold tracking-tight text-brand-900 sm:text-3xl">Thank you, @Model.Name — your brief is in the workshop.</h1>
        <p class="mt-3 text-neutral-500">Our studio designer will review your references and respond within <strong class="text-brand-900">one business day</strong> with a concept direction and quote.</p>

        <dl class="mt-8 grid grid-cols-2 gap-4 rounded-xl bg-brand-50 p-6 text-left sm:grid-cols-4">
            <div><dt class="text-xs text-neutral-400">Reference</dt><dd class="mt-0.5 font-semibold text-brand-900">@Model.RefNumber</dd></div>
            <div><dt class="text-xs text-neutral-400">Category</dt><dd class="mt-0.5 font-semibold text-brand-900">@Model.Category</dd></div>
            <div><dt class="text-xs text-neutral-400">Budget</dt><dd class="mt-0.5 font-semibold text-brand-900">@(Model.Budget ?? "To advise")</dd></div>
            <div><dt class="text-xs text-neutral-400">Sent to</dt><dd class="mt-0.5 truncate font-semibold text-brand-900">@Model.Email</dd></div>
        </dl>

        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
            <a href="@wa" target="_blank" rel="noopener" class="rounded-lg bg-brand-700 px-6 py-3 text-sm font-semibold text-white transition hover:bg-brand-500">Chat with us on WhatsApp</a>
            <a href="/shop" class="rounded-lg border border-brand-200 px-6 py-3 text-sm font-semibold text-brand-900 transition hover:border-brand-600">Continue shopping</a>
        </div>
    </div>
</section>