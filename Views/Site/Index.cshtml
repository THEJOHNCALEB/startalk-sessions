@{
    var pageData = ((string, string, string))ViewBag.Page;
    ViewData["Title"] = pageData.Item1;
    var isGuest = pageData.Item1 == "Guest application";
}
<style>
    .sts-page-hero { background:#24170d; color:#fff; }
    .sts-page-title { font-family:Georgia,serif; font-size:clamp(3rem,7vw,6.5rem); line-height:.95; letter-spacing:-.06em; }
    .sts-page-card { border:1px solid #e6d0a4; padding:1.5rem; background:#fff; }
</style>
<section class="sts-page-hero">
    <div class="mx-auto max-w-app px-4 py-20 sm:px-6 lg:py-28"><p class="sts-kicker">@pageData.Item1</p><h1 class="sts-page-title mt-5 max-w-4xl">@pageData.Item2</h1><p class="mt-7 max-w-2xl text-lg leading-8 text-brand-100">@pageData.Item3</p></div>
</section>
<section class="mx-auto max-w-app px-4 py-16 sm:px-6 lg:py-24">
    @if (isGuest)
    {
        <div class="grid gap-12 lg:grid-cols-[.8fr_1.2fr]"><div><p class="sts-kicker">Be part of the story</p><h2 class="sts-title mt-4">Your perspective belongs here.</h2><p class="mt-5 leading-7 text-brand-700">Share a little about yourself and the conversation you want to have.</p></div><form method="post" action="/contact/submit" class="sts-page-card grid gap-5 sm:grid-cols-2"><input name="Name" required placeholder="Name" class="border border-brand-200 px-4 py-3"><input name="Email" type="email" required placeholder="Email" class="border border-brand-200 px-4 py-3"><input name="Phone" placeholder="Phone" class="border border-brand-200 px-4 py-3"><input name="Type" value="Guest application" class="border border-brand-200 px-4 py-3"><input name="Message" required placeholder="Profession, topic and short bio" class="sm:col-span-2 border border-brand-200 px-4 py-3"><input name="Social" placeholder="Social media links" class="sm:col-span-2 border border-brand-200 px-4 py-3"><button class="sm:col-span-2 bg-brand-950 px-5 py-3 text-sm font-bold text-brand-100">Send application</button></form></div>
    }
    else
    {
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var card in new[] { ("Podcast", "Long-form conversations with people worth listening to."), ("Radio", "A live pulse of ideas, music and community."), ("TV & video", "Visual stories built for the big screen and the small one."), ("Youth programmes", "A louder platform for the next generation."), ("Public forums", "Questions in the open. Answers with consequences."), ("Community action", "Storytelling that helps people move." ) })
            {
                <article class="sts-page-card"><span class="text-3xl text-brand-500">✦</span><h2 class="mt-8 font-serif text-2xl text-brand-900">@card.Item1</h2><p class="mt-3 text-sm leading-6 text-brand-700">@card.Item2</p><a href="/contact" class="mt-6 inline-block text-sm font-bold text-brand-700">Get involved →</a></article>
            }
        </div>
        <div class="mt-16 border-t border-brand-200 pt-10"><p class="sts-kicker">Open doors</p><h2 class="sts-title mt-4 max-w-3xl">Bring your audience, your expertise or your resources.</h2><a href="/contact" class="mt-8 inline-flex bg-brand-950 px-6 py-3 text-xs font-bold tracking-[.12em] text-brand-100">Start a conversation</a></div>
    }
</section>
