@{
    var pageData = ((string, string, string))ViewBag.Page;
    ViewData["Title"] = pageData.Item1;
    ViewBag.PageTitle = pageData.Item1;
    ViewBag.PageSubtitle = pageData.Item2;
    var isGuest = pageData.Item1 == "Guest application";
}

<section class="ed-spotlight">
    <div class="ed-shell ed-spotlight__inner" style="grid-template-columns:1fr;min-height:240px">
        <div>
            <p class="ed-spotlight__kicker">Star Talk Sessions · @pageData.Item1</p>
            <h2 class="ed-spotlight__title" style="max-width:36ch">@pageData.Item3</h2>
            <div class="ed-spotlight__actions">
                <a href="/contact" class="ed-btn ed-btn--light">Get involved</a>
                <a href="/programmes" class="ed-text-btn" style="color:#FFFFFF">Browse programmes &gt;</a>
            </div>
        </div>
    </div>
</section>

<section class="ed-section" style="margin-top:32px">
    <div class="ed-shell" style="padding-top:30px;padding-bottom:40px">
        @if (isGuest)
        {
            <div style="display:grid;grid-template-columns:1fr;gap:32px">
                <div>
                    <p class="ed-kicker">Be part of the story</p>
                    <h2 class="ed-serif mt-4" style="font-size:clamp(1.75rem,4vw,2.5rem);font-weight:700;line-height:1.1">Your perspective belongs here.</h2>
                    <p class="mt-4" style="color:#545658;line-height:1.7">Share a little about yourself and the conversation you want to have. Our producers review every application.</p>
                </div>
                <form method="post" action="/contact/submit" style="display:grid;grid-template-columns:1fr;gap:14px;border:1px solid #141414;padding:24px">
                    <input name="Name" required placeholder="Name" class="border border-[#DCDCDC] px-4 py-3" />
                    <input name="Email" type="email" required placeholder="Email" class="border border-[#DCDCDC] px-4 py-3" />
                    <input name="Phone" placeholder="Phone" class="border border-[#DCDCDC] px-4 py-3" />
                    <input name="Type" value="Guest application" class="border border-[#DCDCDC] px-4 py-3" />
                    <input name="Message" required placeholder="Profession, topic and short bio" class="border border-[#DCDCDC] px-4 py-3" />
                    <input name="Social" placeholder="Social media links" class="border border-[#DCDCDC] px-4 py-3" />
                    <button type="submit" class="ed-btn">Send application</button>
                </form>
            </div>
        }
        else
        {
            <div class="ed-category-grid" style="padding-top:0">
                @foreach (var card in new[] { ("Podcast", "Long-form conversations with people worth listening to."), ("Radio", "A live pulse of ideas, music and community."), ("TV & video", "Visual stories built for the big screen and the small one."), ("Youth programmes", "A louder platform for the next generation."), ("Public forums", "Questions in the open. Answers with consequences."), ("Community action", "Storytelling that helps people move."), ("Live coverage", "The moment, as it happens, with context."), ("Archive", "The reporting that still matters.") })
                {
                    <a class="ed-category-tile" href="/contact">
                        <h3 class="ed-category-tile__title">@card.Item1</h3>
                    </a>
                }
            </div>
            <div style="margin-top:36px;border-top:1px solid #DCDCDC;padding-top:28px">
                <p class="ed-kicker">Open doors</p>
                <h2 class="ed-serif mt-4" style="font-size:clamp(1.5rem,3.4vw,2.25rem);font-weight:700;line-height:1.15;max-width:46ch">Bring your audience, your expertise or your resources.</h2>
                <a href="/contact" class="ed-btn" style="margin-top:22px">Start a conversation</a>
            </div>
        }
    </div>
</section>
